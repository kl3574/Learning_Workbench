+++ b/core/src/tools/executed_tool_calls/sampling_checkpoint_tests.rs
@@ -0,0 +1,118 @@
+//! Same-lock attachment capture; ordinary wire recovery and budgeting stay intact.
+use super::*;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::panic::AssertUnwindSafe;
+use std::panic::catch_unwind;
+
+fn recorder(enabled: bool) -> ExecutedToolCalls {
+    let mut features = Features::default();
+    features.set_enabled(Feature::ExecutedToolCallMetadata, enabled);
+    ExecutedToolCalls::new(&features, &InitialHistory::New)
+}
+
+fn history() -> Vec<ResponseItem> {
+    vec![
+        serde_json::from_value(json!({
+            "type": "custom_tool_call", "call_id": "exec", "name": "exec", "input": "",
+        }))
+        .expect("synthetic exec input"),
+        ResponseItem::from(ResponseInputItem::CustomToolCallOutput {
+            call_id: "exec".to_string(),
+            name: None,
+            output: FunctionCallOutputPayload::from_text("synthetic output".to_string()),
+        }),
+    ]
+}
+
+#[test]
+fn attachment_checkpoint_is_minted_after_attachment_without_self_revocation() {
+    let recorder = recorder(true);
+    let cell = CellId::new("attachment-checkpoint-cell".to_string());
+    let call = ExecutedToolCall::new("synthetic_nested_tool".to_string(), json!({"argument": 2}));
+    recorder.start_cell(&cell, "exec");
+    recorder.record_nested_tool_call(cell.clone(), "nested".to_string(), call.clone(), 2);
+    recorder.finish_cell_recording(&cell);
+    let before = recorder.state_checkpoint().expect("before attachment");
+    let mut actual = history();
+    let mut cache = ExecutedToolCallCache::new();
+    let checkpoint = recorder
+        .attach_to_prompt_with_checkpoint(&mut actual, &mut cache)
+        .expect("checkpoint after attachment in same state guard");
+    assert_eq!(
+        recorder.verify_state_checkpoint(&before),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    assert_eq!(recorder.verify_state_checkpoint(&checkpoint), Ok(()));
+    let repeated = recorder.state_checkpoint().expect("inert capture");
+    assert_eq!(recorder.verify_state_checkpoint(&checkpoint), Ok(()));
+    assert_eq!(recorder.verify_state_checkpoint(&repeated), Ok(()));
+    let mut expected = history();
+    expected[1].append_executed_tool_calls(vec![call]);
+    expected[1].set_tool_call_cell_id("exec");
+    expected[1].mark_tool_calls_complete();
+    assert_eq!(actual, expected);
+    assert!(!cache.is_empty());
+}
+
+#[test]
+fn attachment_poison_failure_sidechannel_preserves_ordinary_wire_and_budget() {
+    for enabled in [false, true] {
+        for poison_state in [false, true] {
+            let retained_recorder = recorder(enabled);
+            let ordinary_recorder = recorder(enabled);
+            let mut original = history();
+            original[1].append_executed_tool_calls(vec![ExecutedToolCall::new(
+                "synthetic_direct_tool".to_string(),
+                json!({"payload": "x".repeat(96 * 1024)}),
+            )]);
+            let mut expected = original.clone();
+            if enabled {
+                bound_executed_tool_calls_for_prompt(&mut expected);
+                assert!(
+                    serde_json::to_vec(&expected).expect("bounded wire").len()
+                        < serde_json::to_vec(&original).expect("unbounded wire").len(),
+                );
+            } else {
+                clear_direct_call_metadata(&mut expected);
+                assert!(expected[1].executed_tool_call_metadata().is_none());
+            }
+            assert!(
+                catch_unwind(AssertUnwindSafe(|| {
+                    if poison_state {
+                        let _guard = retained_recorder.state.lock().expect("state setup");
+                        panic!("synthetic state poison");
+                    } else {
+                        let _guard = retained_recorder
+                            .material_reset
+                            .lock()
+                            .expect("reset setup");
+                        panic!("synthetic reset poison");
+                    }
+                }))
+                .is_err()
+            );
+            let mut actual = original.clone();
+            let mut retained_cache = ExecutedToolCallCache::new();
+            let failure = retained_recorder
+                .attach_to_prompt_with_checkpoint(&mut actual, &mut retained_cache)
+                .err();
+            assert_eq!(
+                failure,
+                Some(if poison_state {
+                    ExecutedToolCallsCheckpointError::StatePoisoned
+                } else {
+                    ExecutedToolCallsCheckpointError::ResetPoisoned
+                }),
+            );
+            let mut ordinary = original;
+            let mut ordinary_cache = ExecutedToolCallCache::new();
+            ordinary_recorder.attach_to_prompt(&mut ordinary, &mut ordinary_cache);
+            assert_eq!(actual, expected);
+            assert_eq!(ordinary, expected);
+            assert_eq!(retained_cache, ordinary_cache);
+        }
+    }
+}
