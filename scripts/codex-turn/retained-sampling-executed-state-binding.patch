+//! Mechanical recorder ownership only; no provider, encoder, grant or sender.
+use super::*;
+use crate::session::step_settings::ResolvedStepSettings;
+use crate::session::tests::HeldStepTask;
+use crate::session::tests::make_session_and_context;
+use crate::session::tests::update_turn_settings_for_test;
+use crate::state::ActiveTurn;
+use crate::state::RunningTask;
+use crate::state::TaskKind;
+use codex_code_mode::CellId;
+use codex_features::Feature;
+use codex_features::Features;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+static EXECUTED_STATE_FIXTURE_TASKS: codex_diagnostics::Gauge =
+    codex_diagnostics::Gauge::new("retained-sampling-executed-state-fixture");
+
+async fn fixture() -> (Arc<Session>, Arc<StepContext>) {
+    let (session, mut turn) = make_session_and_context().await;
+    let selected = Arc::new(turn.next_step_settings.load_full().selected().clone());
+    // The existing inert local manager supplies the actual selected pair once.
+    // Neither this mechanical pair nor the fixture can qualify a model version.
+    let selection = selected
+        .resolve_model_info(
+            session.services.models_manager.as_ref(),
+            &turn.config.to_models_manager_config().into(),
+        )
+        .await;
+    let fast_mode_enabled = turn.config.features.enabled(Feature::FastMode);
+    // The actual test constructor reads initial_settings and creates a fresh Arc.
+    update_turn_settings_for_test(&mut turn, |settings| {
+        *settings =
+            ResolvedStepSettings::from_model_selection(selected, selection, fast_mode_enabled);
+    });
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let step = StepContext::for_test(Arc::clone(&turn));
+    turn.next_step_settings.store(Arc::clone(&step.settings));
+    let active = ActiveTurn {
+        task: Some(RunningTask {
+            done: Arc::new(tokio::sync::Notify::new()),
+            kind: TaskKind::Regular,
+            task: Arc::new(HeldStepTask {
+                kind: TaskKind::Regular,
+                finish: Arc::new(tokio::sync::Notify::new()),
+            }),
+            cancellation_token: CancellationToken::new(),
+            // The owned task object is registered, but its run method is never called.
+            handle: tokio_util::task::AbortOnDropHandle::new(tokio::spawn(std::future::pending())),
+            turn_context: Arc::clone(&turn),
+            _agent_execution_guard: None,
+            _diagnostics_guard: EXECUTED_STATE_FIXTURE_TASKS.track(),
+            _timer: None,
+        }),
+        ..ActiveTurn::default()
+    };
+    *session.active_turn.lock().await = Some(active);
+    session.set_last_known_step_context(&step).await;
+    (session, step)
+}
+
+fn recording_features(enabled: bool) -> Features {
+    let mut features = Features::default();
+    features.set_enabled(Feature::ExecutedToolCallMetadata, enabled);
+    features
+}
+
+async fn assembled(session: &Arc<Session>, step: &Arc<StepContext>) -> AssembledSamplingPrompt {
+    let input = NativeSamplingInput::capture(session, step).await;
+    let instructions = NativeSamplingInstructions::capture(session, step).await;
+    assemble_sampling_prompt(input, &instructions, &mut SamplingToolCache::new())
+        .await
+        .expect("ordinary local assembly without sampling")
+}
+
+fn history() -> Vec<ResponseItem> {
+    vec![
+        serde_json::from_value(json!({
+            "type": "custom_tool_call", "call_id": "exec", "name": "exec", "input": "",
+        }))
+        .expect("synthetic exec input"),
+        ResponseItem::from(ResponseInputItem::CustomToolCallOutput {
+            call_id: "exec".to_string(),
+            name: None,
+            output: FunctionCallOutputPayload::from_text("synthetic historical output".to_string()),
+        }),
+    ]
+}
+
+#[tokio::test]
+async fn retained_sampling_genuine_none_checkpoint_stays_current_and_capture_is_inert() {
+    let (session, step) = fixture().await;
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&recording_features(false));
+    let retained = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("genuine None retention");
+    let checkpoint = retained.executed_state_checkpoint.clone();
+    let history_before = session.clone_history().await.into_shared_annotated_items();
+    let prompt_before = retained.prompt.input.clone();
+    let metadata_before = capture_metadata_facts(&retained.metadata).expect("metadata before");
+    retained
+        .verify_current(&session, &step)
+        .await
+        .expect("same native owner");
+    let second = recorder.state_checkpoint().expect("inert repeat capture");
+    assert_eq!(recorder.verify_state_checkpoint(&checkpoint), Ok(()));
+    assert_eq!(recorder.verify_state_checkpoint(&second), Ok(()));
+    assert!(Arc::ptr_eq(
+        &history_before,
+        &session.clone_history().await.into_shared_annotated_items(),
+    ));
+    assert_eq!(retained.prompt.input, prompt_before);
+    assert_eq!(
+        capture_metadata_facts(&retained.metadata).expect("metadata after"),
+        metadata_before
+    );
+    assert_eq!(
+        retained.controlled_prompt().err(),
+        Some(SamplingCaptureError::CompleteMaterialVersionsUnavailable),
+    );
+    assert_eq!(
+        prepare_pregrant(&session, &step).err(),
+        Some(SamplingCaptureError::PregrantOwnerUnavailable),
+    );
+}
+
+#[tokio::test]
+async fn retained_sampling_rejects_checkpoint_from_distinct_genuine_session_recorder() {
+    let (session, step) = fixture().await;
+    let (foreign, _foreign_step) = fixture().await;
+    session
+        .services
+        .executed_tool_calls
+        .refresh(&recording_features(false));
+    foreign
+        .services
+        .executed_tool_calls
+        .refresh(&recording_features(false));
+    let mut prompt = assembled(&session, &step).await;
+    prompt.executed_state_checkpoint = foreign.services.executed_tool_calls.state_checkpoint();
+    assert_eq!(
+        prompt.retain().await.err(),
+        Some(SamplingCaptureError::ExecutedState(
+            ExecutedToolCallsCheckpointError::OwnerMismatch
+        )),
+    );
+}
+
+#[tokio::test]
+async fn retained_sampling_rejects_writer_between_attachment_and_retain() {
+    let (session, step) = fixture().await;
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&recording_features(false));
+    let prompt = assembled(&session, &step).await;
+    recorder.refresh(&recording_features(false));
+    assert_eq!(
+        prompt.retain().await.err(),
+        Some(SamplingCaptureError::ExecutedState(
+            ExecutedToolCallsCheckpointError::Changed
+        )),
+    );
+}
+
+#[tokio::test]
+async fn retained_sampling_rejects_ordinary_writer_without_rewriting_historical_prompt() {
+    let (session, step) = fixture().await;
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&recording_features(true));
+    session
+        .state
+        .lock()
+        .await
+        .history
+        .record_items(&history(), TruncationPolicy::Tokens(8192));
+    let retained = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("retained before writer");
+    let prompt_before = retained.prompt.input.clone();
+    let history_before = session.clone_history().await.into_shared_annotated_items();
+    let cell = CellId::new("retained-sampling-cell".to_string());
+    let call = ExecutedToolCall::new("synthetic_nested_tool".to_string(), json!({"argument": 2}));
+    recorder.start_cell(&cell, "exec");
+    recorder.record_nested_tool_call(cell.clone(), "nested".to_string(), call.clone(), 2);
+    recorder.finish_cell_recording(&cell);
+    assert_eq!(
+        retained.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::ExecutedState(
+            ExecutedToolCallsCheckpointError::Changed
+        )),
+    );
+    assert_eq!(retained.prompt.input, prompt_before);
+    assert!(Arc::ptr_eq(
+        &history_before,
+        &session.clone_history().await.into_shared_annotated_items(),
+    ));
+    let mut actual = history();
+    recorder.attach_to_compaction_prompt(&mut actual);
+    let mut expected = history();
+    expected[1].append_executed_tool_calls(vec![call]);
+    expected[1].set_tool_call_cell_id("exec");
+    expected[1].mark_tool_calls_complete();
+    assert_eq!(actual, expected);
+    assert_eq!(retained.prompt.input, prompt_before);
+}
+
+#[tokio::test]
+async fn retained_sampling_rejects_recorder_change_and_revert_to_genuine_none() {
+    let (session, step) = fixture().await;
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&recording_features(false));
+    let retained = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("None before change");
+    recorder.refresh(&recording_features(true));
+    recorder.refresh(&recording_features(false));
+    assert_eq!(
+        retained.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::ExecutedState(
+            ExecutedToolCallsCheckpointError::Changed
+        )),
+    );
+    assert_eq!(
+        recorder
+            .verify_state_checkpoint(&recorder.state_checkpoint().expect("current genuine None")),
+        Ok(()),
+    );
+}
+
+#[tokio::test]
+async fn stale_attachment_checkpoint_keeps_into_ordinary_values_exact() {
+    let (session, step) = fixture().await;
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&recording_features(false));
+    let assembled = assembled(&session, &step).await;
+    let expected = assembled.prompt.clone();
+    let expected_metadata = capture_metadata_facts(&assembled.metadata).expect("original metadata");
+    recorder.refresh(&recording_features(false));
+    assert_eq!(
+        recorder.verify_state_checkpoint(
+            assembled
+                .executed_state_checkpoint
+                .as_ref()
+                .expect("checkpoint")
+        ),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    let (ordinary, metadata) = assembled.into_ordinary();
+    assert_eq!(ordinary.input, expected.input);
+    assert!(Arc::ptr_eq(&ordinary.tools, &expected.tools));
+    assert_eq!(ordinary.parallel_tool_calls, expected.parallel_tool_calls);
+    assert_eq!(ordinary.base_instructions, expected.base_instructions);
+    assert_eq!(ordinary.output_schema, expected.output_schema);
+    assert_eq!(ordinary.output_schema_strict, expected.output_schema_strict);
+    assert_eq!(ordinary.cyber_access_program, expected.cyber_access_program);
+    assert_eq!(
+        capture_metadata_facts(&metadata).expect("ordinary metadata"),
+        expected_metadata
+    );
+}
