+    /// Captures the current recorder state without enabling recording or visiting
+    /// the ordinary lock seam. A genuine disabled state has the same owner rules.
+    pub(crate) fn state_checkpoint(
+        &self,
+    ) -> Result<ExecutedToolCallsCheckpoint, ExecutedToolCallsCheckpointError> {
+        let _state_guard = self
+            .state
+            .lock()
+            .map_err(|_| ExecutedToolCallsCheckpointError::StatePoisoned)?;
+        let reset = self
+            .material_reset
+            .lock()
+            .map_err(|_| ExecutedToolCallsCheckpointError::ResetPoisoned)?;
+        Ok(ExecutedToolCallsCheckpoint {
+            state_owner: Arc::downgrade(&self.state),
+            reset_owner: Arc::downgrade(&self.material_reset),
+            reset: reset.child_token(),
+        })
+    }
+
+    pub(crate) fn verify_state_checkpoint(
+        &self,
+        checkpoint: &ExecutedToolCallsCheckpoint,
+    ) -> Result<(), ExecutedToolCallsCheckpointError> {
+        if !Weak::ptr_eq(&checkpoint.state_owner, &Arc::downgrade(&self.state))
+            || !Weak::ptr_eq(
+                &checkpoint.reset_owner,
+                &Arc::downgrade(&self.material_reset),
+            )
+        {
+            return Err(ExecutedToolCallsCheckpointError::OwnerMismatch);
+        }
+        let _state_guard = self
+            .state
+            .lock()
+            .map_err(|_| ExecutedToolCallsCheckpointError::StatePoisoned)?;
+        let _reset_guard = self
+            .material_reset
+            .lock()
+            .map_err(|_| ExecutedToolCallsCheckpointError::ResetPoisoned)?;
+        if checkpoint.reset.is_cancelled() {
+            Err(ExecutedToolCallsCheckpointError::Changed)
+        } else {
+            Ok(())
+        }
+    }
