+use std::panic::AssertUnwindSafe;
+use std::panic::catch_unwind;
+
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+use super::*;
+
+fn recording_features(enabled: bool) -> Features {
+    let mut features = Features::default();
+    features.set_enabled(Feature::ExecutedToolCallMetadata, enabled);
+    features
+}
+
+fn enabled_recorder() -> ExecutedToolCalls {
+    ExecutedToolCalls::new(&recording_features(true), &InitialHistory::New)
+}
+
+fn record_nested(recorder: &ExecutedToolCalls, cell: &CellId, call_id: &str) -> ExecutedToolCall {
+    let call = ExecutedToolCall::new("nested_tool".to_string(), json!({}));
+    recorder.record_nested_tool_call(cell.clone(), call_id.to_string(), call.clone(), 2);
+    call
+}
+
+fn metadata_source(cell: &CellId, call_id: &str) -> ToolCallSource {
+    ToolCallSource::CodeMode {
+        cell_id: cell.as_str().to_string(),
+        runtime_tool_call_id: call_id.to_string(),
+    }
+}
+
+fn history() -> Vec<ResponseItem> {
+    vec![
+        serde_json::from_value(json!({
+            "type": "custom_tool_call", "call_id": "exec", "name": "exec", "input": "",
+        }))
+        .expect("test exec input must deserialize"),
+        ResponseItem::from(ResponseInputItem::CustomToolCallOutput {
+            call_id: "exec".to_string(),
+            name: None,
+            output: FunctionCallOutputPayload::from_text(String::new()),
+        }),
+    ]
+}
+
+fn assert_inert_none_capture(recorder: &ExecutedToolCalls) {
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("state must be usable")
+            .is_none()
+    );
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    let second = recorder
+        .state_checkpoint()
+        .expect("repeat capture must succeed");
+    assert_eq!(recorder.verify_state_checkpoint(&checkpoint), Ok(()));
+    assert_eq!(recorder.verify_state_checkpoint(&second), Ok(()));
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("state must remain usable")
+            .is_none()
+    );
+    assert_eq!(recorder.pending_direct_calls.load(Ordering::Relaxed), 0);
+    assert_eq!(
+        recorder
+            .retained_direct_metadata_bytes
+            .load(Ordering::Relaxed),
+        0
+    );
+    assert!(!checkpoint.reset.is_cancelled());
+    assert!(!second.reset.is_cancelled());
+    assert_eq!(format!("{recorder:?}"), "ExecutedToolCalls { .. }");
+}
+
+#[test]
+fn default_genuine_none_capture_is_inert_and_stable() {
+    assert_inert_none_capture(&ExecutedToolCalls::default());
+}
+
+#[test]
+fn explicit_disabled_owner_capture_is_inert_and_stable() {
+    let recorder = ExecutedToolCalls::new(&recording_features(false), &InitialHistory::New);
+    assert_inert_none_capture(&recorder);
+}
+
+#[test]
+fn checkpoint_accepts_shared_clone_and_rejects_distinct_none_owner() {
+    let recorder = ExecutedToolCalls::default();
+    let shared = recorder.clone();
+    let distinct = ExecutedToolCalls::default();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    assert!(Arc::ptr_eq(&recorder.state, &shared.state));
+    assert!(Arc::ptr_eq(
+        &recorder.material_reset,
+        &shared.material_reset
+    ));
+    assert_eq!(shared.verify_state_checkpoint(&checkpoint), Ok(()));
+    assert_eq!(
+        distinct.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::OwnerMismatch),
+    );
+    assert_eq!(recorder.verify_state_checkpoint(&checkpoint), Ok(()));
+}
+
+#[test]
+fn none_to_none_refresh_revokes_checkpoint() {
+    let recorder = ExecutedToolCalls::default();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    recorder.refresh(&recording_features(false));
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("state must be usable")
+            .is_none()
+    );
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    assert_eq!(
+        recorder.verify_state_checkpoint(&recorder.state_checkpoint().expect("recapture")),
+        Ok(()),
+    );
+}
+
+#[test]
+fn recording_change_and_revert_does_not_revive_checkpoint() {
+    let recorder = ExecutedToolCalls::default();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    recorder.refresh(&recording_features(true));
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("state must be usable")
+            .is_some()
+    );
+    let enabled = recorder.state_checkpoint().expect("enabled capture");
+    recorder.refresh(&recording_features(false));
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("state must be usable")
+            .is_none()
+    );
+    for stale in [&checkpoint, &enabled] {
+        assert_eq!(
+            recorder.verify_state_checkpoint(stale),
+            Err(ExecutedToolCallsCheckpointError::Changed),
+        );
+    }
+}
