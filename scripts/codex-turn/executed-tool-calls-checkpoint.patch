+#[test]
+fn nested_call_writer_revokes_and_records_actual_call() {
+    let recorder = enabled_recorder();
+    let cell = CellId::new("checkpoint-cell".to_string());
+    recorder.start_cell(&cell, "exec");
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    let call = record_nested(&recorder, &cell, "nested");
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    let state = recorder.state.lock().expect("state must be usable");
+    let state = state.as_ref().expect("recording must remain enabled");
+    assert_eq!(state.pending_nested_calls, 1);
+    assert_eq!(state.cells[&cell].pending_calls["nested"], call);
+}
+
+#[test]
+fn accepted_pending_metadata_writer_revokes_checkpoint() {
+    let recorder = enabled_recorder();
+    let cell = CellId::new("checkpoint-cell".to_string());
+    recorder.start_cell(&cell, "exec");
+    let mut expected = record_nested(&recorder, &cell, "nested");
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    let metadata = json!({"id": "accepted"});
+    assert!(recorder.record_tool_result_metadata(
+        &metadata_source(&cell, "nested"),
+        "nested",
+        &metadata,
+    ));
+    expected.set_tool_result_metadata(ToolResultMetadata::new(&metadata));
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    let state = recorder.state.lock().expect("state must be usable");
+    let state = state.as_ref().expect("recording must remain enabled");
+    assert_eq!(state.cells[&cell].pending_calls["nested"], expected);
+}
+
+#[test]
+fn delayed_retained_metadata_writer_revokes_checkpoint() {
+    let recorder = enabled_recorder();
+    let cell = CellId::new("checkpoint-cell".to_string());
+    recorder.start_cell(&cell, "exec");
+    let mut expected = record_nested(&recorder, &cell, "nested");
+    recorder.finish_cell_recording(&cell);
+    let mut original_output = history();
+    recorder.attach_to_compaction_prompt(&mut original_output);
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    let metadata = json!({"id": "late"});
+    assert!(recorder.record_tool_result_metadata(
+        &metadata_source(&cell, "nested"),
+        "nested",
+        &metadata,
+    ));
+    expected.set_tool_result_metadata(ToolResultMetadata::new(&metadata));
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+    let mut updated = history();
+    recorder.attach_to_compaction_prompt(&mut updated);
+    let mut expected_output = history();
+    expected_output[1].append_executed_tool_calls(vec![expected]);
+    expected_output[1].set_tool_call_cell_id("exec");
+    expected_output[1].mark_tool_calls_complete();
+    assert_eq!(updated, expected_output);
+    assert_ne!(original_output, updated);
+}
