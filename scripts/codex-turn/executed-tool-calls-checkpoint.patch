+#[test]
+fn ordinary_lock_visit_revokes_conservatively() {
+    let recorder = enabled_recorder();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    {
+        let state = recorder.lock_state();
+        assert!(state.is_some());
+    }
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::Changed),
+    );
+}
+
+#[test]
+fn poisoned_state_rejects_checkpoint_and_preserves_ordinary_recovery() {
+    let recorder = ExecutedToolCalls::default();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    assert!(
+        catch_unwind(AssertUnwindSafe(|| {
+            let _state_guard = recorder.state.lock().expect("unpoisoned setup");
+            panic!("poison recorder state");
+        }))
+        .is_err()
+    );
+    assert!(matches!(
+        recorder.state_checkpoint(),
+        Err(ExecutedToolCallsCheckpointError::StatePoisoned),
+    ));
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::StatePoisoned),
+    );
+    recorder.refresh(&recording_features(true));
+    let recovered = match recorder.state.lock() {
+        Ok(_) => panic!("ordinary recovery must preserve the poison marker"),
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    assert!(recovered.is_some());
+    assert!(checkpoint.reset.is_cancelled());
+}
+
+#[test]
+fn poisoned_reset_rejects_checkpoint_and_preserves_ordinary_recovery() {
+    let recorder = ExecutedToolCalls::default();
+    let checkpoint = recorder.state_checkpoint().expect("capture must succeed");
+    assert!(
+        catch_unwind(AssertUnwindSafe(|| {
+            let _reset_guard = recorder.material_reset.lock().expect("unpoisoned setup");
+            panic!("poison recorder reset");
+        }))
+        .is_err()
+    );
+    assert!(matches!(
+        recorder.state_checkpoint(),
+        Err(ExecutedToolCallsCheckpointError::ResetPoisoned),
+    ));
+    assert_eq!(
+        recorder.verify_state_checkpoint(&checkpoint),
+        Err(ExecutedToolCallsCheckpointError::ResetPoisoned),
+    );
+    recorder.refresh(&recording_features(true));
+    assert!(
+        recorder
+            .state
+            .lock()
+            .expect("ordinary state must be usable")
+            .is_some()
+    );
+    assert!(checkpoint.reset.is_cancelled());
+}
