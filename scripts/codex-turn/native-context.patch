+//! In-process capture from an owned native Session and the same retained Step.
+//!
+//! This is a private mechanical source boundary, not platform mapping authority,
+//! a model-catalog qualification, InputProof, a dispatch permit or a sender.
+//! Rechecking observed settings, history, window and metadata does not create a
+//! global mutation epoch: unobserved ABA changes remain outside this boundary.
+
+use super::session::Session;
+use super::step_context::StepContext;
+use crate::client::retained_metadata::capture_metadata_facts;
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::responses_metadata::CodexResponsesRequestKind;
+use crate::state::TaskKind;
+use crate::state::TurnState;
+use codex_protocol::SessionId;
+use codex_protocol::ThreadId;
+use codex_protocol::openai_models::ModelInfo;
+use serde_json::Value;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum NativeCaptureError {
+    OwnerUnavailable,
+    OwnerMismatch,
+    SettingsChanged,
+    HistoryChanged,
+    WindowChanged,
+    MetadataChanged,
+    InvalidMetadata,
+}
+
+/// Retains actual native references; there is no dict or free-string constructor.
+/// The model flag and every native metadata default are retained as observed.
+/// In particular, an offline/fallback descriptor is not upgraded to authority.
+pub(crate) struct RetainedNativeContext {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    session_id: SessionId,
+    thread_id: ThreadId,
+    sub_id: String,
+    model_info: Arc<ModelInfo>,
+    metadata: CodexResponsesMetadata,
+    facts: Value,
+    history_version: u64,
+    history_reset: CancellationToken,
+    owner: Arc<Mutex<TurnState>>,
+}
+
+struct Observation {
+    metadata: CodexResponsesMetadata,
+    facts: Value,
+    history_version: u64,
+    history_reset: CancellationToken,
+    owner: Arc<Mutex<TurnState>>,
+}
+
+impl RetainedNativeContext {
+    pub(crate) fn native_identity(&self) -> (SessionId, ThreadId, &str) {
+        (self.session_id, self.thread_id, &self.sub_id)
+    }
+
+    pub(crate) fn model_info(&self) -> &Arc<ModelInfo> {
+        &self.model_info
+    }
+
+    pub(crate) fn metadata(&self) -> &CodexResponsesMetadata {
+        &self.metadata
+    }
+
+    /// Checks the same retained references against currently observable facts.
+    /// It never refreshes this snapshot or substitutes next-step ModelInfo.
+    pub(crate) async fn verify_current(
+        &self,
+        session: &Arc<Session>,
+        step: &Arc<StepContext>,
+    ) -> Result<(), NativeCaptureError> {
+        if !Arc::ptr_eq(session, &self.session) || !Arc::ptr_eq(step, &self.step) {
+            return Err(NativeCaptureError::OwnerMismatch);
+        }
+        if self.history_reset.is_cancelled() {
+            return Err(NativeCaptureError::HistoryChanged);
+        }
+        let observed = observe(session, step).await?;
+        if !Arc::ptr_eq(&self.owner, &observed.owner) {
+            return Err(NativeCaptureError::OwnerMismatch);
+        }
+        if observed.history_version != self.history_version {
+            return Err(NativeCaptureError::HistoryChanged);
+        }
+        if observed.metadata.window_id != self.metadata.window_id
+            || observed.metadata.window_number != self.metadata.window_number
+            || observed.metadata.context_window_id != self.metadata.context_window_id
+        {
+            return Err(NativeCaptureError::WindowChanged);
+        }
+        if observed.facts != self.facts {
+            return Err(NativeCaptureError::MetadataChanged);
+        }
+        Ok(())
+    }
+}
+
+impl Session {
+    /// Captures final Turn metadata using this actual Session and exactly one Step.
+    /// Internal ownership alone does not authenticate the platform/native mapping.
+    pub(crate) async fn capture_retained_native_context(
+        self: &Arc<Self>,
+        step: &Arc<StepContext>,
+    ) -> Result<RetainedNativeContext, NativeCaptureError> {
+        let observed = observe(self, step).await?;
+        let captured = RetainedNativeContext {
+            session: Arc::clone(self),
+            step: Arc::clone(step),
+            session_id: self.session_id(),
+            thread_id: self.thread_id(),
+            sub_id: step.turn.sub_id.clone(),
+            model_info: Arc::clone(&step.settings.model_info),
+            metadata: observed.metadata,
+            facts: observed.facts,
+            history_version: observed.history_version,
+            history_reset: observed.history_reset,
+            owner: observed.owner,
+        };
+        captured.verify_current(self, step).await?;
+        Ok(captured)
+    }
+}
+
+async fn observe(
+    session: &Arc<Session>,
+    step: &Arc<StepContext>,
+) -> Result<Observation, NativeCaptureError> {
+    let owner = current_owner(session, step).await?;
+    if !Arc::ptr_eq(&step.settings, &step.turn.next_step_settings.load_full()) {
+        return Err(NativeCaptureError::SettingsChanged);
+    }
+    let window = session.current_window().await;
+    let (history_version, history_reset) = session.history_reset().await;
+    // This is the complete Session getter used by sampling, not the turn template.
+    let metadata = session
+        .responses_metadata(step, CodexResponsesRequestKind::Turn)
+        .await;
+    if metadata.session_id != session.session_id().to_string()
+        || metadata.thread_id != session.thread_id().to_string()
+        || metadata.turn_id.as_deref() != Some(step.turn.sub_id.as_str())
+    {
+        return Err(NativeCaptureError::OwnerMismatch);
+    }
+    if metadata.window_id != window.0
+        || metadata.window_number != Some(window.1)
+        || metadata.context_window_id != Some(window.2)
+        || session.current_window().await != window
+    {
+        return Err(NativeCaptureError::WindowChanged);
+    }
+    let (after_history_version, _) = session.history_reset().await;
+    if history_reset.is_cancelled() || after_history_version != history_version {
+        return Err(NativeCaptureError::HistoryChanged);
+    }
+    if !Arc::ptr_eq(&step.settings, &step.turn.next_step_settings.load_full()) {
+        return Err(NativeCaptureError::SettingsChanged);
+    }
+    let facts =
+        capture_metadata_facts(&metadata).map_err(|_| NativeCaptureError::InvalidMetadata)?;
+    if !Arc::ptr_eq(&owner, &current_owner(session, step).await?) {
+        return Err(NativeCaptureError::OwnerMismatch);
+    }
+    Ok(Observation {
+        metadata,
+        facts,
+        history_version,
+        history_reset,
+        owner,
+    })
+}
+
+// Sampling already retains the selected Step in this Session's active TurnState.
+// An ID equality cannot substitute for that exact in-process owner relationship.
+async fn current_owner(
+    session: &Arc<Session>,
+    step: &Arc<StepContext>,
+) -> Result<Arc<Mutex<TurnState>>, NativeCaptureError> {
+    // None and an uncancelled request token remain admissible. A cancelled
+    // request is unavailable even while its parent regular task still runs.
+    if step
+        .preempt
+        .as_ref()
+        .is_some_and(CancellationToken::is_cancelled)
+    {
+        return Err(NativeCaptureError::OwnerUnavailable);
+    }
+    let owner = {
+        let active = session.active_turn.lock().await;
+        let active = active
+            .as_ref()
+            .ok_or(NativeCaptureError::OwnerUnavailable)?;
+        let task = active
+            .task
+            .as_ref()
+            .ok_or(NativeCaptureError::OwnerUnavailable)?;
+        if task.kind != TaskKind::Regular || task.cancellation_token.is_cancelled() {
+            return Err(NativeCaptureError::OwnerUnavailable);
+        }
+        if !Arc::ptr_eq(&task.turn_context, &step.turn) {
+            return Err(NativeCaptureError::OwnerMismatch);
+        }
+        Arc::clone(&active.turn_state)
+    };
+    let retained = owner.lock().await;
+    let retained = retained
+        .last_known_step_context
+        .as_ref()
+        .ok_or(NativeCaptureError::OwnerUnavailable)?;
+    if !Arc::ptr_eq(retained, step) {
+        return Err(NativeCaptureError::OwnerMismatch);
+    }
+    Ok(Arc::clone(&owner))
+}
