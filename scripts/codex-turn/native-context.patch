+#[tokio::test]
+async fn capture_executes_final_session_getter_and_retains_the_same_step_model() {
+    let (session, step, _home) = fixture().await;
+    let expected = session
+        .responses_metadata(&step, CodexResponsesRequestKind::Turn)
+        .await;
+    let captured = session
+        .capture_retained_native_context(&step)
+        .await
+        .expect("native fixture capture");
+    assert_eq!(
+        captured.native_identity(),
+        (
+            session.session_id(),
+            session.thread_id(),
+            step.turn.sub_id.as_str()
+        )
+    );
+    assert!(Arc::ptr_eq(
+        captured.model_info(),
+        &step.settings.model_info
+    ));
+    assert_eq!(
+        serde_json::to_value(captured.model_info().as_ref()).expect("full model"),
+        serde_json::to_value(step.settings.model_info.as_ref()).expect("same full model")
+    );
+    assert_eq!(
+        capture_metadata_facts(captured.metadata()).expect("full capture"),
+        capture_metadata_facts(&expected).expect("final getter")
+    );
+    assert_eq!(
+        captured.metadata().client_metadata(true),
+        expected.client_metadata(true)
+    );
+    assert_eq!(
+        captured.metadata().compatibility_headers(),
+        expected.compatibility_headers()
+    );
+    // These values come from the actual Session wrapper, not the turn template.
+    assert!(captured.metadata().window_number.is_some());
+    assert!(captured.metadata().context_window_id.is_some());
+    assert_eq!(captured.metadata().analytics_enabled, Some(false));
+    assert!(captured.metadata().mcp_attribution.is_some());
+    let template = step.turn.turn_metadata_state.to_responses_metadata(
+        session.installation_id.clone(),
+        expected.window_id.clone(),
+        CodexResponsesRequestKind::Turn,
+    );
+    assert_ne!(
+        capture_metadata_facts(&template).expect("template"),
+        capture_metadata_facts(captured.metadata()).expect("final")
+    );
+    captured
+        .verify_current(&Arc::clone(&session), &Arc::clone(&step))
+        .await
+        .expect("same retained clones");
+}
