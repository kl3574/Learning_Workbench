+
+async fn assembled(session: &Arc<Session>, step: &Arc<StepContext>) -> AssembledSamplingPrompt {
+    let input = NativeSamplingInput::capture(session, step).await;
+    let instructions = NativeSamplingInstructions::capture(session, step).await;
+    assemble_sampling_prompt(input, &instructions, &mut SamplingToolCache::new())
+        .await
+        .expect("native assembly without sampling")
+}
+
+#[tokio::test]
+async fn capture_retains_actual_tools_schema_instructions_and_executed_metadata() {
+    let schema = json!({"type":"object","properties":{"answer":{"type":"string"}},
+        "required":["answer"],"additionalProperties":false});
+    let tools = vec![ToolSpec::Freeform(FreeformTool {
+        name: "owned_tool_never_executed".to_string(),
+        description: "Owned native tool schema".to_string(),
+        defer_loading: None,
+        format: FreeformToolFormat {
+            r#type: "grammar".to_string(),
+            syntax: "lark".to_string(),
+            definition: "start: \"owned\"".to_string(),
+        },
+    })];
+    let (session, step, _home) = fixture_with_sampling_materials(
+        /*preempt*/ None,
+        |_| {},
+        Some(schema.clone()),
+        tools.clone(),
+        SessionSource::Exec,
+    )
+    .await;
+    let mut features = Features::default();
+    features.enable(Feature::ExecutedToolCallMetadata);
+    let recorder = &session.services.executed_tool_calls;
+    recorder.refresh(&features);
+    let call = ToolCall {
+        tool_name: ToolName::plain("owned_tool_never_executed"),
+        call_id: "owned-result".to_string(),
+        payload: ToolPayload::Custom {
+            input: "owned".to_string(),
+        },
+        encrypted_function_args: None,
+    };
+    let invocation = ResponseItem::CustomToolCall {
+        id: None,
+        status: None,
+        call_id: call.call_id.clone(),
+        name: call.tool_name.to_string(),
+        namespace: None,
+        input: "owned".to_string(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut output = ResponseItem::CustomToolCallOutput {
+        id: None,
+        call_id: call.call_id.clone(),
+        name: Some(call.tool_name.to_string()),
+        output: FunctionCallOutputPayload::from_text("owned result not executed".to_string()),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let record = recorder.prepare_direct_call(&call, &ToolCallSource::Direct, &step);
+    assert!(record.is_some());
+    recorder.attach_direct_call_to_output(&mut output, record);
+    session.state.lock().await.history.record_items(
+        &[invocation.clone(), output.clone()],
+        TruncationPolicy::Tokens(8192),
+    );
+    let expected_instructions = session.get_prompt_base_instructions().await;
+    let expected_metadata = session
+        .responses_metadata(&step, CodexResponsesRequestKind::Turn)
+        .await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("source capture");
+    let (prompt, metadata, model) = captured.native_materials();
+    assert_eq!(prompt.tools.as_ref(), tools.as_slice());
+    assert!(Arc::ptr_eq(
+        &prompt.tools,
+        &step.tool_router.model_visible_specs()
+    ));
+    assert_eq!(prompt.output_schema, Some(schema));
+    assert_eq!(prompt.base_instructions, expected_instructions);
+    assert!(!prompt.base_instructions.text.is_empty());
+    assert_eq!(prompt.input, vec![invocation, output]);
+    assert!(prompt.input[1].executed_tool_call_metadata().is_some());
+    assert!(Arc::ptr_eq(model, &step.settings.model_info));
+    assert_eq!(
+        capture_metadata_facts(metadata).expect("complete captured metadata"),
+        capture_metadata_facts(&expected_metadata).expect("complete actual getter metadata")
+    );
+    assert!(prompt.parallel_tool_calls);
+    assert_eq!(
+        prompt.output_schema_strict,
+        !crate::guardian::is_basic_session_source(&step.turn.session_source)
+    );
+    assert_eq!(prompt.cyber_access_program, step.turn.cyber_access_program);
+    assert_eq!(
+        captured.controlled_prompt().err(),
+        Some(SamplingCaptureError::CompleteMaterialVersionsUnavailable)
+    );
+}
+
+#[tokio::test]
+async fn ordinary_assembly_does_not_require_a_retained_active_owner() {
+    let (session, step, _home) = fixture().await;
+    *session.active_turn.lock().await = None;
+    let expected_input = session
+        .clone_history()
+        .await
+        .for_prompt(&step.settings.model_info.input_modalities);
+    let expected_instructions = session.get_prompt_base_instructions().await;
+    let expected = crate::session::turn::build_prompt(expected_input, &step, expected_instructions);
+    let (prompt, metadata) = assembled(&session, &step).await.into_ordinary();
+    assert_eq!(prompt.input, expected.input);
+    assert_eq!(prompt.tools.as_ref(), expected.tools.as_ref());
+    assert_eq!(prompt.base_instructions, expected.base_instructions);
+    assert_eq!(prompt.output_schema, expected.output_schema);
+    assert_eq!(metadata.thread_id, session.thread_id().to_string());
+    assert_eq!(
+        assembled(&session, &step).await.retain().await.err(),
+        Some(SamplingCaptureError::Native(
+            NativeCaptureError::OwnerUnavailable
+        ))
+    );
+}
+
+#[tokio::test]
+async fn retained_capture_rejects_a_cross_session_or_equal_value_step() {
+    let (session, step, _home) = fixture().await;
+    let (other, _other_step, _other_home) = fixture().await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("capture");
+    assert_eq!(
+        captured.verify_current(&other, &step).await,
+        Err(SamplingCaptureError::Native(
+            NativeCaptureError::OwnerMismatch
+        ))
+    );
+    let replacement = StepContext::for_test(Arc::clone(&step.turn));
+    assert_eq!(
+        captured.verify_current(&session, &replacement).await,
+        Err(SamplingCaptureError::Native(
+            NativeCaptureError::OwnerMismatch
+        ))
+    );
+}
+
+#[tokio::test]
+async fn actual_history_append_invalidates_retained_source_without_refresh() {
+    let (session, step, _home) = fixture().await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("capture");
+    let before = captured.native_materials().0.input.clone();
+    let output = ResponseItem::from(ResponseInputItem::FunctionCallOutput {
+        call_id: "later-owned-result".to_string(),
+        output: FunctionCallOutputPayload::from_text("later history".to_string()),
+    });
+    session
+        .state
+        .lock()
+        .await
+        .history
+        .record_items(&[output], TruncationPolicy::Tokens(8192));
+    assert_eq!(
+        captured.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::HistoryChanged)
+    );
+    assert_eq!(captured.native_materials().0.input, before);
+}
