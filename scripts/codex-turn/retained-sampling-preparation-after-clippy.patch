@@ -0,0 +1,230 @@
+//! Actual native sampling assembly, retained without inventing an input proof.
+//!
+//! Ordinary sampling consumes precisely its existing Prompt and metadata. Only an
+//! explicit retain operation inspects native ownership; failure cannot redirect
+//! or break ordinary sampling. There is no auth, encoder, sender or foreign input.
+
+use super::retained_outbound_snapshot::NativeCaptureError;
+use super::retained_outbound_snapshot::RetainedNativeContext;
+use super::session::Session;
+use super::step_context::StepContext;
+use super::turn::build_prompt;
+use crate::client::retained_metadata::capture_metadata_facts;
+use crate::client_common::Prompt;
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::responses_metadata::CodexResponsesRequestKind;
+use crate::tools::router::ToolRouter;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::models::ExecutedToolCall;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ModelInfo;
+use std::collections::HashMap;
+use std::mem::Discriminant;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+
+pub(super) type SamplingToolCache =
+    HashMap<(Discriminant<ResponseItem>, String), Vec<ExecutedToolCall>>;
+
+/// No caller-provided response items can manufacture a native history origin.
+pub(super) struct NativeSamplingInput {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    history: Arc<Vec<ResponseItemEnvelope>>,
+    history_reset: CancellationToken,
+    input: Vec<ResponseItem>,
+}
+
+impl NativeSamplingInput {
+    pub(super) async fn capture(session: &Arc<Session>, step: &Arc<StepContext>) -> Self {
+        let (history, history_reset) = {
+            let state = session.state.lock().await;
+            (state.clone_history(), state.history_reset.child_token())
+        };
+        let source = history.clone().into_shared_annotated_items();
+        let input = history.for_prompt(&step.settings.model_info.input_modalities);
+        Self {
+            session: Arc::clone(session),
+            step: Arc::clone(step),
+            history: source,
+            history_reset,
+            input,
+        }
+    }
+}
+
+/// Retains the actual rendered Session instruction copy used by this sampling loop.
+pub(super) struct NativeSamplingInstructions {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    instructions: BaseInstructions,
+}
+
+impl NativeSamplingInstructions {
+    pub(super) async fn capture(session: &Arc<Session>, step: &Arc<StepContext>) -> Self {
+        Self {
+            instructions: session.get_prompt_base_instructions().await,
+            session: Arc::clone(session),
+            step: Arc::clone(step),
+        }
+    }
+}
+
+/// Created only by the actual native assembly below, never from a supplied Prompt.
+pub(super) struct AssembledSamplingPrompt {
+    origin: NativeSamplingInput,
+    instructions_owner_matches: bool,
+    tool_router: Arc<ToolRouter>,
+    prompt: Prompt,
+    metadata: CodexResponsesMetadata,
+}
+
+/// Preserve ordinary ordering: executed observations, native Prompt, final Session
+/// metadata, then Guardian. In particular, this is not a side-effect-free preview.
+pub(super) async fn assemble_sampling_prompt(
+    mut input: NativeSamplingInput,
+    instructions: &NativeSamplingInstructions,
+    executed_tool_calls_by_output: &mut SamplingToolCache,
+) -> CodexResult<AssembledSamplingPrompt> {
+    let session = &input.session;
+    let step = &input.step;
+    session
+        .services
+        .executed_tool_calls
+        .attach_to_prompt(&mut input.input, executed_tool_calls_by_output);
+    let mut prompt = build_prompt(
+        std::mem::take(&mut input.input),
+        step.as_ref(),
+        instructions.instructions.clone(),
+    );
+    let metadata = session
+        .responses_metadata(step.as_ref(), CodexResponsesRequestKind::Turn)
+        .await;
+    if crate::guardian::is_basic_session_source(&step.turn.session_source) {
+        crate::guardian::prepare_guardian_prompt(session, &mut prompt, step.as_ref(), &metadata)
+            .await?;
+    }
+    let instructions_owner_matches =
+        Arc::ptr_eq(session, &instructions.session) && Arc::ptr_eq(step, &instructions.step);
+    let tool_router = Arc::clone(&step.tool_router);
+    Ok(AssembledSamplingPrompt {
+        origin: input,
+        instructions_owner_matches,
+        tool_router,
+        prompt,
+        metadata,
+    })
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum SamplingCaptureError {
+    Native(NativeCaptureError),
+    InstructionsOwnerMismatch,
+    HistoryChanged,
+    ToolPlanChanged,
+    MetadataChanged,
+    PregrantOwnerUnavailable,
+    CompleteMaterialVersionsUnavailable,
+}
+
+impl AssembledSamplingPrompt {
+    /// Ordinary execution takes its original values without attempting capture.
+    pub(super) fn into_ordinary(self) -> (Prompt, CodexResponsesMetadata) {
+        (self.prompt, self.metadata)
+    }
+
+    /// Mechanical capture only. The native guard retains the same model/record
+    /// Arcs. It is not a prepared-job mapping, complete material epoch or proof.
+    #[allow(dead_code)]
+    pub(super) async fn retain(self) -> Result<RetainedSamplingPreparation, SamplingCaptureError> {
+        if !self.instructions_owner_matches {
+            return Err(SamplingCaptureError::InstructionsOwnerMismatch);
+        }
+        let native = self
+            .origin
+            .session
+            .capture_retained_native_context(&self.origin.step)
+            .await
+            .map_err(SamplingCaptureError::Native)?;
+        if capture_metadata_facts(&self.metadata)
+            .map_err(|_| SamplingCaptureError::MetadataChanged)?
+            != capture_metadata_facts(native.metadata())
+                .map_err(|_| SamplingCaptureError::MetadataChanged)?
+        {
+            return Err(SamplingCaptureError::MetadataChanged);
+        }
+        let retained = RetainedSamplingPreparation {
+            native,
+            origin: self.origin,
+            tool_router: self.tool_router,
+            prompt: self.prompt,
+            metadata: self.metadata,
+        };
+        retained
+            .verify_current(&retained.origin.session, &retained.origin.step)
+            .await?;
+        Ok(retained)
+    }
+}
+
+/// Private fields and no Clone/Debug/serde or free factory. Its Prompt contains
+/// actual assembled input/tools/schema/instructions, but cannot authorize a send.
+pub(super) struct RetainedSamplingPreparation {
+    native: RetainedNativeContext,
+    origin: NativeSamplingInput,
+    tool_router: Arc<ToolRouter>,
+    prompt: Prompt,
+    metadata: CodexResponsesMetadata,
+}
+
+#[allow(dead_code)]
+impl RetainedSamplingPreparation {
+    /// Read a historical mechanical capture, not an approved request or InputProof.
+    pub(super) fn native_materials(&self) -> (&Prompt, &CodexResponsesMetadata, &Arc<ModelInfo>) {
+        (&self.prompt, &self.metadata, self.native.model_info())
+    }
+
+    /// Recheck current retained identities. This does not prove an ABA-free global
+    /// epoch for instructions, executed-tool facts or later client contributors.
+    pub(super) async fn verify_current(
+        &self,
+        session: &Arc<Session>,
+        step: &Arc<StepContext>,
+    ) -> Result<(), SamplingCaptureError> {
+        self.native
+            .verify_current(session, step)
+            .await
+            .map_err(SamplingCaptureError::Native)?;
+        if self.origin.history_reset.is_cancelled() {
+            return Err(SamplingCaptureError::HistoryChanged);
+        }
+        let current = session.clone_history().await.into_shared_annotated_items();
+        if !Arc::ptr_eq(&self.origin.history, &current) {
+            return Err(SamplingCaptureError::HistoryChanged);
+        }
+        if !Arc::ptr_eq(&self.tool_router, &step.tool_router)
+            || !Arc::ptr_eq(&self.prompt.tools, &step.tool_router.model_visible_specs())
+        {
+            return Err(SamplingCaptureError::ToolPlanChanged);
+        }
+        Ok(())
+    }
+
+    /// No complete instruction/executed-material/contributor version owner exists
+    /// here. Even a mechanically current capture cannot enter the encoder yet.
+    pub(super) fn controlled_prompt(&self) -> Result<&Prompt, SamplingCaptureError> {
+        Err(SamplingCaptureError::CompleteMaterialVersionsUnavailable)
+    }
+}
+
+/// An active ordinary task is not a trusted pre-consent prepared-native owner.
+/// Refuse before history assembly/Guardian, auth, encode, grant/start or send.
+#[allow(dead_code)]
+pub(super) fn prepare_pregrant(
+    _session: &Arc<Session>,
+    _step: &Arc<StepContext>,
+) -> Result<RetainedSamplingPreparation, SamplingCaptureError> {
+    Err(SamplingCaptureError::PregrantOwnerUnavailable)
+}
