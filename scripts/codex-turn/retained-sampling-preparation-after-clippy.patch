+    assert!(crate::guardian::is_basic_session_source(
+        &step.turn.session_source
+    ));
+    assert!(step.turn.config.model_context_window.is_none());
+    // This model mutation is an explicit budget fixture, not a model witness or
+    // capacity proof. Only the actual ordinary Guardian preparation is exercised.
+    let input = NativeSamplingInput::capture(&session, &step).await;
+    let instructions = NativeSamplingInstructions::capture(&session, &step).await;
+    let error = assemble_sampling_prompt(input, &instructions, &mut SamplingToolCache::new())
+        .await
+        .err()
+        .expect("actual Guardian must reject the exhausted local input budget");
+    assert!(matches!(
+        error.details(),
+        codex_protocol::error::CodexErrorDetails::ContextWindowExceeded
+    ));
+    assert_eq!(
+        prepare_pregrant(&session, &step).err(),
+        Some(SamplingCaptureError::PregrantOwnerUnavailable)
+    );
+}
