+//! Mechanical resolution observations, not catalog authority or request qualification.
+//!
+//! Only the owning manager constructs a record. Ordinary `get_model_info` is unchanged;
+//! this opt-in path retains the typed catalog entry before slug rewriting and overrides.
+
+use super::CatalogSource;
+use super::OpenAiModelsManager;
+use super::find_model_by_longest_prefix;
+use super::find_model_by_namespaced_suffix;
+use crate::ModelsManagerConfig;
+use crate::model_info;
+use chrono::DateTime;
+use chrono::Utc;
+use codex_protocol::openai_models::ModelInfo;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ModelMatchRule {
+    LongestPrefix,
+    NamespacedSuffix,
+    ExplicitProviderExact,
+    UnmatchedFallback,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CatalogOrigin {
+    IdentityMatchedMemoryEntry,
+    BundledIdentityFallback,
+    EmptyExplicitProviderFallback,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ResolutionQualification {
+    Unqualified,
+}
+
+/// The memory entry may originate from initialization, cache, or an endpoint.
+/// These observed fields do not establish that origin, a model version, or authority.
+/// Opaque credential identities are compared by the manager and are not copied here.
+pub(crate) struct CatalogObservation {
+    origin: CatalogOrigin,
+    entry_fetched_at: Option<DateTime<Utc>>,
+    entry_etag: Option<String>,
+    entry_client_version: Option<String>,
+}
+
+impl CatalogObservation {
+    pub(crate) fn origin(&self) -> CatalogOrigin {
+        self.origin
+    }
+
+    pub(crate) fn entry_fetched_at(&self) -> Option<&DateTime<Utc>> {
+        self.entry_fetched_at.as_ref()
+    }
+
+    pub(crate) fn entry_etag(&self) -> Option<&str> {
+        self.entry_etag.as_deref()
+    }
+
+    pub(crate) fn entry_client_version(&self) -> Option<&str> {
+        self.entry_client_version.as_deref()
+    }
+}
+
+/// Owned typed observations. No public constructor, serde representation, or Debug output.
+/// In particular, a false serde-skipped fallback flag is never treated as qualification.
+/// This record does not bind a Step, detect later owner changes, or authorize any send.
+pub(crate) struct RetainedModelResolution {
+    requested_model: String,
+    match_rule: ModelMatchRule,
+    original_catalog_model: Option<ModelInfo>,
+    before_overrides: ModelInfo,
+    resolved_model: ModelInfo,
+    catalog: CatalogObservation,
+}
+
+impl RetainedModelResolution {
+    pub(crate) fn requested_model(&self) -> &str {
+        &self.requested_model
+    }
+
+    pub(crate) fn match_rule(&self) -> ModelMatchRule {
+        self.match_rule
+    }
+
+    pub(crate) fn original_catalog_model(&self) -> Option<&ModelInfo> {
+        self.original_catalog_model.as_ref()
+    }
+
+    pub(crate) fn before_overrides(&self) -> &ModelInfo {
+        &self.before_overrides
+    }
+
+    pub(crate) fn resolved_model(&self) -> &ModelInfo {
+        &self.resolved_model
+    }
+
+    pub(crate) fn catalog(&self) -> &CatalogObservation {
+        &self.catalog
+    }
+
+    pub(crate) fn authoritative_model_version(&self) -> Option<&str> {
+        None
+    }
+
+    pub(crate) fn qualification(&self) -> ResolutionQualification {
+        ResolutionQualification::Unqualified
+    }
+}
+
+impl OpenAiModelsManager {
+    /// Observe the original lookup without refreshing the catalog or resolving auth.
+    /// The original selected ModelInfo retains every typed field, including its raw
+    /// fallback marker, even when ordinary construction rewrites that marker to false.
+    pub(crate) async fn get_model_info_with_retained_resolution(
+        &self,
+        model: &str,
+        config: &ModelsManagerConfig,
+    ) -> RetainedModelResolution {
+        let (models, catalog) = {
+            let entry = self.remote_models.read().await;
+            if entry.identity.is_some() && entry.identity == self.endpoint_client.identity() {
+                (
+                    entry.models.clone(),
+                    CatalogObservation {
+                        origin: CatalogOrigin::IdentityMatchedMemoryEntry,
+                        entry_fetched_at: Some(entry.fetched_at),
+                        entry_etag: entry.etag.clone(),
+                        entry_client_version: entry.client_version.clone(),
+                    },
+                )
+            } else {
+                let origin = match &self.catalog_source {
+                    CatalogSource::Default => CatalogOrigin::BundledIdentityFallback,
+                    CatalogSource::ExplicitProvider(_) => {
+                        CatalogOrigin::EmptyExplicitProviderFallback
+                    }
+                };
+                (
+                    self.catalog_source.fallback_models().unwrap_or_default(),
+                    CatalogObservation {
+                        origin,
+                        entry_fetched_at: None,
+                        entry_etag: None,
+                        entry_client_version: None,
+                    },
+                )
+            }
+        };
+        let (match_rule, original_catalog_model) = match &self.catalog_source {
+            CatalogSource::Default => {
+                if let Some(candidate) = find_model_by_longest_prefix(model, &models) {
+                    (ModelMatchRule::LongestPrefix, Some(candidate))
+                } else if let Some(candidate) = find_model_by_namespaced_suffix(model, &models) {
+                    (ModelMatchRule::NamespacedSuffix, Some(candidate))
+                } else {
+                    (ModelMatchRule::UnmatchedFallback, None)
+                }
+            }
+            CatalogSource::ExplicitProvider(_) => {
+                if let Some(candidate) =
+                    models.into_iter().find(|candidate| candidate.slug == model)
+                {
+                    (ModelMatchRule::ExplicitProviderExact, Some(candidate))
+                } else {
+                    (ModelMatchRule::UnmatchedFallback, None)
+                }
+            }
+        };
+        let before_overrides = if let Some(original) = original_catalog_model.as_ref() {
+            ModelInfo {
+                slug: model.to_string(),
+                used_fallback_model_metadata: false,
+                ..original.clone()
+            }
+        } else {
+            model_info::model_info_from_slug(model)
+        };
+        let resolved_model = model_info::with_config_overrides(before_overrides.clone(), config);
+        RetainedModelResolution {
+            requested_model: model.to_string(),
+            match_rule,
+            original_catalog_model,
+            before_overrides,
+            resolved_model,
+            catalog,
+        }
+    }
+}
