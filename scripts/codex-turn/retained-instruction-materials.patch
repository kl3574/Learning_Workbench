+/// Inert native instruction facts. The Session and applied-manager writer lifetimes
+/// cover only these facts, not executed-tool/client contributions or InputProof.
+#[derive(Clone)]
+struct NativeInstructionMaterials {
+    reset: CancellationToken,
+    config: Arc<Config>,
+    source: BaseInstructions,
+    agents_md: AppliedAgentsMdCheckpoint,
+}
+
+impl NativeInstructionMaterials {
+    async fn session_is_current(&self, session: &Arc<Session>) -> bool {
+        let (_, config, source) = session.capture_prompt_instruction_materials().await;
+        !self.reset.is_cancelled() && Arc::ptr_eq(&self.config, &config) && self.source == source
+    }
+
+    async fn verify_current(
+        &self,
+        session: &Arc<Session>,
+        step: &Arc<StepContext>,
+    ) -> Result<(), SamplingCaptureError> {
+        if !self.session_is_current(session).await {
+            return Err(SamplingCaptureError::InstructionsChanged);
+        }
+        if !self.agents_md.matches_loaded(&step.loaded_agents_md)
+            || !session
+                .services
+                .agents_md_manager
+                .checkpoint_is_current(&self.agents_md)
+                .await
+        {
+            return Err(SamplingCaptureError::AppliedInstructionsChanged);
+        }
+        // Establish that the Session lifetime did not change around the manager read.
+        if !self.session_is_current(session).await {
+            return Err(SamplingCaptureError::InstructionsChanged);
+        }
+        Ok(())
+    }
+}
