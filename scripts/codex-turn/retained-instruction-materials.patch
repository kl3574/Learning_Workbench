+//! Tests the actual applied-state writer seams without refresh, file discovery or callbacks.
+use super::*;
+use codex_extension_api::LoadInstructionsFuture;
+use codex_extension_api::UserInstructionsProvider;
+
+async fn publish(manager: &AgentsMdManager, text: Option<&str>) {
+    let instructions = SessionInstructions {
+        user: text.map(|text| Instructions {
+            text: text.to_string(),
+            source: None,
+        }),
+        ..Default::default()
+    };
+    let loaded = LoadedAgentsMd::default()
+        .with_instructions(instructions.user.clone(), None)
+        .map(Arc::new);
+    manager.state.lock().await.publish(
+        instructions,
+        AgentsMdCache {
+            loaded,
+            ..Default::default()
+        },
+    );
+}
+
+#[tokio::test]
+async fn absence_checkpoint_is_stable_and_bound_to_its_manager() {
+    let manager = AgentsMdManager::new(SessionInstructions::default());
+    let other = AgentsMdManager::new(SessionInstructions::default());
+    let checkpoint = manager.applied_checkpoint().await;
+    assert!(checkpoint.matches_loaded(&None));
+    assert!(manager.checkpoint_is_current(&checkpoint).await);
+    assert!(!other.checkpoint_is_current(&checkpoint).await);
+    assert!(manager.checkpoint_is_current(&checkpoint).await);
+}
+
+#[tokio::test]
+async fn clearing_genuine_absence_revokes_the_old_checkpoint() {
+    let manager = AgentsMdManager::new(SessionInstructions::default());
+    let checkpoint = manager.applied_checkpoint().await;
+    manager.state.lock().await.clear_cache();
+    assert!(manager.get_loaded().await.is_none());
+    assert!(!manager.checkpoint_is_current(&checkpoint).await);
+    let current = manager.applied_checkpoint().await;
+    assert!(current.matches_loaded(&None));
+    assert!(manager.checkpoint_is_current(&current).await);
+}
+
+#[tokio::test]
+async fn equal_applied_publication_has_a_new_writer_lifetime() {
+    let manager = AgentsMdManager::new(SessionInstructions::default());
+    publish(&manager, Some("owned applied instructions")).await;
+    let checkpoint = manager.applied_checkpoint().await;
+    let before = manager.get_loaded().await.expect("applied instructions");
+    publish(&manager, Some("owned applied instructions")).await;
+    let after = manager
+        .get_loaded()
+        .await
+        .expect("equal applied instructions");
+    assert_eq!(before.as_ref(), after.as_ref());
+    assert!(!Arc::ptr_eq(&before, &after));
+    assert!(!manager.checkpoint_is_current(&checkpoint).await);
+}
+
+#[tokio::test]
+async fn applied_change_and_revert_cannot_revive_an_absence_checkpoint() {
+    let manager = AgentsMdManager::new(SessionInstructions::default());
+    let checkpoint = manager.applied_checkpoint().await;
+    publish(&manager, Some("temporary applied instructions")).await;
+    publish(&manager, None).await;
+    assert!(manager.get_loaded().await.is_none());
+    assert!(checkpoint.matches_loaded(&None));
+    assert!(!manager.checkpoint_is_current(&checkpoint).await);
+    assert!(
+        manager
+            .checkpoint_is_current(&manager.applied_checkpoint().await)
+            .await
+    );
+}
+
+struct NeverLoadedInstructions;
+
+impl UserInstructionsProvider for NeverLoadedInstructions {
+    fn load_user_instructions(&self) -> LoadInstructionsFuture<'_> {
+        panic!("inert checkpoint must never call an instruction provider")
+    }
+}
+
+#[tokio::test]
+async fn applied_checkpoint_capture_and_recheck_do_not_load_providers() {
+    let manager = AgentsMdManager::new(SessionInstructions {
+        user_provider: Some(Arc::new(NeverLoadedInstructions)),
+        ..Default::default()
+    });
+    let checkpoint = manager.applied_checkpoint().await;
+    assert!(checkpoint.matches_loaded(&None));
+    assert!(manager.checkpoint_is_current(&checkpoint).await);
+    assert!(manager.get_loaded().await.is_none());
+}
