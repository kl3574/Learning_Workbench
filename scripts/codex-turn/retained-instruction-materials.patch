+#[tokio::test]
+async fn equal_config_arc_replacement_revokes_instruction_capture() {
+    let (session, step, _home) = fixture().await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("capture");
