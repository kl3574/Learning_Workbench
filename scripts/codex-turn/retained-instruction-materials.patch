+#[tokio::test]
+async fn configuration_change_and_revert_keep_captured_render_and_revoke_retention() {
+    // Independent literals from the existing codex-prompts contract in
+    // prompts/src/update_plan_instructions_tests.rs, including unrelated planning.
+    const ENABLED: &str = concat!(
+        "Before.\n\n## Planning\n",
+        "You have access to an `update_plan` tool which tracks steps.\n\n",
+        "### Examples\nKeep steps current.\n\n## Work\nImplement.\n\n",
+        "## `update_plan`\nUpdate the checklist.\n\n# Next\n",
+        "## Planning\nDiscuss architecture and inspect update_plan before editing.\n",
+    );
+    const DISABLED: &str = concat!(
+        "Before.\n\n## Work\nImplement.\n\n# Next\n",
+        "## Planning\nDiscuss architecture and inspect update_plan before editing.\n",
+    );
+    let (session, step, _home) = fixture().await;
+    {
+        let mut state = session.state.lock().await;
+        let mut configuration = state.session_configuration.clone();
+        configuration.base_instructions = ENABLED.to_string();
+        state.replace_session_configuration(configuration);
+        state.set_base_instructions_provenance(Some(BaseInstructionsProvenance::Model {
+            model: step.settings.model_info.slug.clone(),
+        }));
+        let mut config = state
+            .session_configuration
+            .original_config_do_not_use
+            .as_ref()
+            .clone();
+        config.update_plan_enabled = true;
+        config.model_catalog = None;
+        Session::replace_session_runtime_config(&mut state, Arc::new(config));
+    }
+    let (_, enabled_config, source) = session.capture_prompt_instruction_materials().await;
+    assert!(enabled_config.update_plan_enabled);
+    assert!(enabled_config.model_catalog.is_none());
+    assert_eq!(source.text, ENABLED);
+    assert_eq!(session.get_prompt_base_instructions().await.text, ENABLED);
+    let input = NativeSamplingInput::capture(&session, &step).await;
+    let instructions = NativeSamplingInstructions::capture(&session, &step).await;
+    {
+        let mut state = session.state.lock().await;
+        let mut disabled = enabled_config.as_ref().clone();
+        disabled.update_plan_enabled = false;
+        Session::replace_session_runtime_config(&mut state, Arc::new(disabled));
+    }
+    let (_, disabled_config, unchanged_source) =
+        session.capture_prompt_instruction_materials().await;
+    assert!(!disabled_config.update_plan_enabled);
+    assert!(disabled_config.model_catalog.is_none());
+    assert_eq!(unchanged_source, source);
+    let changed_render = session.get_prompt_base_instructions().await;
+    assert_eq!(changed_render.text, DISABLED);
+    assert!(
+        !changed_render
+            .text
+            .contains("You have access to an `update_plan` tool")
+    );
+    assert!(!changed_render.text.contains("## `update_plan`"));
+    assert_ne!(changed_render.text, ENABLED);
+    let (prompt, _) = assemble_sampling_prompt(input, &instructions, &mut SamplingToolCache::new())
+        .await
+        .expect("ordinary assembly preserves the original captured enabled instructions")
+        .into_ordinary();
+    assert_eq!(prompt.base_instructions.text, ENABLED);
+    assert_eq!(prompt.base_instructions.provenance, source.provenance);
+    assert_ne!(prompt.base_instructions.text, changed_render.text);
+    {
+        let mut state = session.state.lock().await;
+        Session::replace_session_runtime_config(&mut state, Arc::clone(&enabled_config));
+    }
+    let retained = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("fresh capture");
+    assert_eq!(retained.verify_current(&session, &step).await, Ok(()));
+    {
+        let mut state = session.state.lock().await;
+        let mut disabled = enabled_config.as_ref().clone();
+        disabled.update_plan_enabled = false;
+        Session::replace_session_runtime_config(&mut state, Arc::new(disabled));
+        Session::replace_session_runtime_config(&mut state, Arc::clone(&enabled_config));
+    }
+    assert_eq!(
+        retained.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::InstructionsChanged)
+    );
+    assert_eq!(
+        retained.native_materials().0.base_instructions.text,
+        ENABLED
+    );
+    assert_eq!(
+        retained.native_materials().0.base_instructions.provenance,
+        source.provenance
+    );
+}
