+#[tokio::test]
+async fn applied_absence_clear_revokes_a_retained_native_capture() {
+    let (session, step, _home) = fixture().await;
+    let manager = &session.services.agents_md_manager;
+    assert!(manager.get_loaded().await.is_none());
+    assert!(step.loaded_agents_md.is_none());
+    let retained = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("absence capture");
+    assert_eq!(retained.verify_current(&session, &step).await, Ok(()));
+    manager.clear_applied_cache_for_test().await;
+    // Both snapshots remain genuine None. Without the manager verification
+    // the revoked capture would incorrectly pass this assertion.
+    assert!(manager.get_loaded().await.is_none());
+    assert!(step.loaded_agents_md.is_none());
+    assert_eq!(
+        retained.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::AppliedInstructionsChanged)
+    );
+    assert_eq!(
+        retained.controlled_prompt().err(),
+        Some(SamplingCaptureError::CompleteMaterialVersionsUnavailable)
+    );
+}
