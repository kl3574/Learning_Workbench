+//! Native material ownership tests only; no worker, refresh, encode, grant or transport.
+use super::fixture;
+use crate::session::retained_sampling_preparation::*;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use codex_protocol::models::BaseInstructionsProvenance;
+use std::sync::Arc;
+
+async fn assembled(session: &Arc<Session>, step: &Arc<StepContext>) -> AssembledSamplingPrompt {
+    let input = NativeSamplingInput::capture(session, step).await;
+    let instructions = NativeSamplingInstructions::capture(session, step).await;
+    assemble_sampling_prompt(input, &instructions, &mut SamplingToolCache::new())
+        .await
+        .expect("ordinary native assembly only")
+}
+
+#[tokio::test]
+async fn inert_instruction_capture_keeps_native_history_config_and_applied_state() {
+    let (session, step, _home) = fixture().await;
+    let history = session.clone_history().await.into_shared_annotated_items();
+    let (reset, config, source) = session.capture_prompt_instruction_materials().await;
+    let checkpoint = session
+        .services
+        .agents_md_manager
+        .applied_checkpoint()
+        .await;
+    let _instructions = NativeSamplingInstructions::capture(&session, &step).await;
+    let (after_reset, after_config, after_source) =
+        session.capture_prompt_instruction_materials().await;
+    assert!(!reset.is_cancelled());
+    assert!(!after_reset.is_cancelled());
+    assert!(Arc::ptr_eq(&config, &after_config));
+    assert_eq!(source, after_source);
+    assert!(Arc::ptr_eq(
+        &history,
+        &session.clone_history().await.into_shared_annotated_items()
+    ));
+    assert!(
+        session
+            .services
+            .agents_md_manager
+            .checkpoint_is_current(&checkpoint)
+            .await
+    );
+    assert_eq!(
+        prepare_pregrant(&session, &step).err(),
+        Some(SamplingCaptureError::PregrantOwnerUnavailable)
+    );
+}
+
+#[tokio::test]
+async fn base_instruction_commit_invalidates_capture_and_preserves_original_prompt() {
+    let (session, step, _home) = fixture().await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("capture");
+    let before = captured.native_materials().0.base_instructions.clone();
+    {
+        let mut state = session.state.lock().await;
+        let mut configuration = state.session_configuration.clone();
+        configuration
+            .base_instructions
+            .push_str("\nLater owned instructions");
+        state.replace_session_configuration(configuration);
+    }
+    assert_eq!(
+        captured.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::InstructionsChanged)
+    );
+    assert_eq!(captured.native_materials().0.base_instructions, before);
+    assert_eq!(
+        captured.controlled_prompt().err(),
+        Some(SamplingCaptureError::CompleteMaterialVersionsUnavailable)
+    );
+}
+
+#[tokio::test]
+async fn provenance_change_and_revert_cannot_revive_instruction_capture() {
+    let (session, step, _home) = fixture().await;
+    let captured = assembled(&session, &step)
+        .await
+        .retain()
+        .await
+        .expect("capture");
+    {
+        let mut state = session.state.lock().await;
+        let original = state.base_instructions_provenance();
+        state.set_base_instructions_provenance(Some(BaseInstructionsProvenance::Custom));
+        state.set_base_instructions_provenance(original);
+    }
+    assert_eq!(
+        captured.verify_current(&session, &step).await,
+        Err(SamplingCaptureError::InstructionsChanged)
+    );
+}
