+// Captured only by the SDK's own successful materialization path. These
+// private fields are replay data; they do not establish prepared-owner consent.
+pub(crate) struct FrozenConfigMaterializationContext {
+    inputs: ConfigMaterializationInputs,
+    sources: ConfigMaterializationSources,
+}
+
+struct ConfigMaterializationInputs {
+    cfg: ConfigToml,
+    overrides: ConfigOverrides,
+    codex_home: AbsolutePathBuf,
+    config_layer_stack: ConfigLayerStack,
+}
+
+// The outer Option records whether a source operation actually ran. An inner
+// Option preserves its native result, including an observed absence. A missing
+// outer Option never falls back to live resolution during replay.
+#[derive(Default)]
+struct ConfigMaterializationSources {
+    cwd: Option<AbsolutePathBuf>,
+    repo_root: Option<Option<AbsolutePathBuf>>,
+    permission_home: Option<Option<PathUri>>,
+    prefer_mxc: Option<bool>,
+    legacy_permission_profile: Option<PermissionProfile>,
+    features: Option<(ManagedFeatures, Vec<String>)>,
+    mcp_enterprise_managed_auth: Option<Option<McpEnterpriseManagedAuthConfig>>,
+    agent_roles: Option<(BTreeMap<String, AgentRoleConfig>, Vec<String>)>,
+    model_providers: Option<HashMap<String, ModelProviderInfo>>,
+    unload_check_time: Option<std::time::Instant>,
+    base_instructions_file: Option<Option<String>>,
+    compact_prompt_file: Option<Option<String>>,
+    zsh_path: Option<Option<PathBuf>>,
+    model_catalog: Option<Option<ModelsResponse>>,
+    sqlite_home_env: Option<Option<AbsolutePathBuf>>,
+    prepared_network_proxy: Option<NetworkProxyConfig>,
+    network: Option<Option<NetworkProxySpec>>,
+    helper_readable_roots: Option<Vec<AbsolutePathBuf>>,
+    deny_read_context: Option<(Option<PathUri>, Vec<PathUri>)>,
+    otel: Option<(codex_config::types::OtelConfig, Vec<String>)>,
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("frozen config materialization is missing captured source: {field}")]
+struct MissingConfigMaterializationSource {
+    field: &'static str,
+}
+
+fn captured_config_source<T: Clone>(
+    source: &Option<T>,
+    field: &'static str,
+) -> std::io::Result<T> {
+    source.clone().ok_or_else(|| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            MissingConfigMaterializationSource { field },
+        )
+    })
+}
+
+fn live_config_materialization_fs(
+    fs: Option<&dyn ExecutorFileSystem>,
+) -> std::io::Result<&dyn ExecutorFileSystem> {
+    fs.ok_or_else(|| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            MissingConfigMaterializationSource { field: "live filesystem" },
+        )
+    })
+}
