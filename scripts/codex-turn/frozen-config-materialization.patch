+    assert_eq!(error.kind(), ErrorKind::InvalidInput);
+    let missing = error
+        .get_ref()
+        .and_then(|source| source.downcast_ref::<MissingConfigMaterializationSource>())
+        .expect("the error must preserve the structured missing-source cause");
+    assert_eq!(missing.field, "model_catalog");
+    Ok(())
+}
