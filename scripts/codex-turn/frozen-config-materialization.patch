+#[tokio::test]
+async fn config_materialization_replay_preserves_values_and_warnings() -> std::io::Result<()> {
+    let mut fixture = create_test_fixture()?;
+    let warning_cfg: ConfigToml = toml::from_str(
+        r#"
+[otel]
+environment = "frozen-config-test"
+
+[otel.span_attributes]
+"" = "missing-key"
+"example.trace_attr" = "enabled"
+
+[otel.tracestate.example]
+alpha = "one"
+beta = "two\ntoo"
+"#,
+    )
+    .expect("TOML deserialization should succeed");
+    fixture.cfg.otel = warning_cfg.otel;
+    fixture.cfg.sqlite_home = Some(fixture.codex_home());
+
+    let (captured, context) = capture_config_materialization_fixture(&fixture).await?;
+
+    assert_eq!(captured.model.as_deref(), Some("o3"));
+    assert_eq!(captured.cwd, fixture.cwd.abs());
+    assert_eq!(captured.sqlite_home, fixture.codex_home());
+    assert_eq!(captured.otel.environment, "frozen-config-test");
+    assert_eq!(
+        captured.otel.span_attributes,
+        BTreeMap::from([("example.trace_attr".to_string(), "enabled".to_string())])
+    );
+    assert!(captured.startup_warnings.iter().any(|warning| {
+        warning.contains("Ignoring invalid `otel.span_attributes` config")
+            && warning.contains("configured span attribute key must not be empty")
+    }));
+    assert!(captured.startup_warnings.iter().any(|warning| {
+        warning.contains("Ignoring invalid `otel.tracestate` config")
+            && warning.contains("invalid configured tracestate value for example.beta")
+    }));
+
+    let replayed = Config::replay_config_materialization(context).await?;
+
+    assert_eq!(replayed.startup_warnings, captured.startup_warnings);
+    assert_eq!(replayed, captured);
+    Ok(())
+}
