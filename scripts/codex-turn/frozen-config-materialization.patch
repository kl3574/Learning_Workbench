+#[tokio::test]
+async fn config_materialization_replay_keeps_captured_file_sources() -> std::io::Result<()> {
+    let mut fixture = create_test_fixture()?;
+    let instructions_path = fixture.cwd_path().join("model_instructions.txt");
+    let compact_prompt_path = fixture.cwd_path().join("compact_prompt.txt");
+    let catalog_path = fixture.codex_home.path().join("catalog.json");
+    let mut catalog = bundled_models_response()
+        .unwrap_or_else(|err| panic!("bundled models.json should parse: {err}"));
+    catalog.models = catalog.models.into_iter().take(1).collect();
+    std::fs::write(&instructions_path, "  original instructions  ")?;
+    std::fs::write(&compact_prompt_path, "  original compact prompt  ")?;
+    std::fs::write(
+        &catalog_path,
+        serde_json::to_string(&catalog).expect("serialize catalog"),
+    )?;
+    fixture.cfg.model_instructions_file = Some(instructions_path.abs());
+    fixture.cfg.experimental_compact_prompt_file = Some(compact_prompt_path.abs());
+    fixture.cfg.model_catalog_json = Some(catalog_path.abs());
+
+    let (captured, context) = capture_config_materialization_fixture(&fixture).await?;
+    assert_eq!(
+        captured.base_instructions.as_deref(),
+        Some("original instructions")
+    );
+    assert_eq!(
+        captured.compact_prompt.as_deref(),
+        Some("original compact prompt")
+    );
+    assert_eq!(captured.model_catalog, Some(catalog));
+
+    std::fs::write(&instructions_path, "changed instructions")?;
+    std::fs::write(&compact_prompt_path, "changed compact prompt")?;
+    let (changed, _) = capture_config_materialization_fixture(&fixture).await?;
+    assert_eq!(
+        changed.base_instructions.as_deref(),
+        Some("changed instructions")
+    );
+    assert_eq!(
+        changed.compact_prompt.as_deref(),
+        Some("changed compact prompt")
+    );
+    assert_ne!(changed.base_instructions, captured.base_instructions);
+    assert_ne!(changed.compact_prompt, captured.compact_prompt);
+
+    std::fs::write(&catalog_path, r#"{"models":[]}"#)?;
+    let live_error = Config::load_config_with_layer_stack(
+        LOCAL_FS.as_ref(),
+        fixture.cfg.clone(),
+        ConfigOverrides {
+            cwd: Some(fixture.cwd_path()),
+            ..Default::default()
+        },
+        fixture.codex_home(),
+        ConfigLayerStack::default(),
+    )
+    .await
+    .expect_err("live loading must reject the changed empty model catalog");
+    assert_eq!(live_error.kind(), ErrorKind::InvalidData);
+
+    let replayed = Config::replay_config_materialization(context).await?;
+
+    assert_eq!(replayed, captured);
+    Ok(())
+}
