+//! Mechanical SDK ownership tests. The ordinary test fixture is setup only;
+//! it is not a production pregrant producer or complete InputProof authority.
+
+use super::*;
+use crate::config::ConfigOverrides;
+use crate::session::retained_sampling_preparation::prepare_owned_pregrant;
+use crate::session::tests::make_session_and_context;
+use crate::session::step_settings::ResolvedStepSettings;
+use crate::session::step_settings::StepSettings;
+use codex_features::Feature;
+use codex_protocol::config_types::CollaborationMode;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::config_types::Settings;
+use codex_config::ConfigLayerStack;
+use codex_config::config_toml::ConfigToml;
+use codex_exec_server::LOCAL_FS;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+struct MechanicalFixture {
+    input: OwnedPregrantSessionInput,
+    _root: tempfile::TempDir,
+}
+
+async fn mechanical_fixture() -> MechanicalFixture {
+    mechanical_fixture_with_configured_model(true).await
+}
+
+async fn mechanical_fixture_with_configured_model(model_present: bool) -> MechanicalFixture {
+    // The ordinary test fixture supplies native values only. Its Session never
+    // enters the factory, and this helper does not establish a common producer.
+    let (ordinary, mut turn) = make_session_and_context().await;
+    let native_model = turn.model_info().slug.clone();
+    let root = tempfile::tempdir().expect("mechanical fixture root");
+    let cwd = root.path().join("workspace");
+    let home = root.path().join("codex-home");
+    std::fs::create_dir_all(&cwd).expect("mechanical workspace");
+    std::fs::create_dir_all(&home).expect("mechanical codex home");
+    let (config, context) = Config::capture_config_with_layer_stack(
+        LOCAL_FS.as_ref(),
+        ConfigToml {
+            model: model_present.then(|| native_model.clone()),
+            ..Default::default()
+        },
+        ConfigOverrides {
+            cwd: Some(cwd),
+            base_instructions: Some("Captured mechanical base instructions".to_string()),
+            developer_instructions: Some("Captured mechanical developer instructions".to_string()),
+            ..Default::default()
+        },
+        AbsolutePathBuf::try_from(home).expect("absolute mechanical codex home"),
+        ConfigLayerStack::default(),
+    )
+    .await
+    .expect("actual SDK config capture");
+    let config = Arc::new(config);
+    let mut configuration = ordinary.state.lock().await.session_configuration.clone();
+    configuration.original_config_do_not_use = Arc::clone(&config);
+    configuration.legacy_fallback_cwd = config.cwd.clone();
+    configuration.runtime_workspace_roots = config.workspace_roots.clone();
+    configuration.codex_home = config.codex_home.clone();
+    let selected = Arc::new(StepSettings {
+        collaboration_mode: CollaborationMode {
+            mode: ModeKind::Default,
+            settings: Settings {
+                model: config.model.clone().unwrap_or(native_model),
+                reasoning_effort: config.model_reasoning_effort.clone(),
+                developer_instructions: None,
+            },
+        },
+        reasoning_summary: config.model_reasoning_summary,
+        service_tier: config.service_tier.clone(),
+        personality: config.personality,
+        approval_policy: config.permissions.approval_policy.clone(),
+        approvals_reviewer: config.approvals_reviewer,
+    });
+    let resolved = Arc::new(ResolvedStepSettings::new(
+        selected,
+        Arc::clone(&turn.initial_settings.model_info),
+        config.features.enabled(Feature::FastMode),
+    ));
+    turn.config = Arc::clone(&config);
+    turn.cwd = config.cwd.clone();
+    turn.initial_settings = resolved;
+    let turn = Arc::new(turn);
+    let step = StepContext::for_test(Arc::clone(&turn));
+    // for_test allocates a new settings Arc. Align the actual turn snapshot
+    // before consuming the test Arc and letting the owner allocate its one Step.
+    turn.next_step_settings.store(Arc::clone(&step.settings));
+    let step = Arc::try_unwrap(step)
+        .unwrap_or_else(|_| panic!("mechanical Step must have one test owner"));
+    let input = OwnedPregrantSessionInput {
+        thread_id: ordinary.thread_id,
+        installation_id: "mechanical-pregrant-test".to_string(),
+        state: SessionState::new(configuration),
+        step,
+        initial_history: InitialHistory::New,
+        config_context: Arc::new(context),
+        windows_sandbox_proxy_settings_mode:
+            codex_sandboxing::WindowsSandboxProxySettingsMode::Reconcile,
+    };
+    drop(ordinary);
+    MechanicalFixture { input, _root: root }
+}
+
+async fn prepared_mechanical_owner() -> (NativePregrantOwner, tempfile::TempDir) {
+    let MechanicalFixture { input, _root } = mechanical_fixture().await;
+    let owner = prepare_owned_pregrant(input)
+        .await
+        .unwrap_or_else(|error| panic!("mechanical owner preparation failed: {error:?}"));
+    (owner, _root)
+}
+
+#[tokio::test]
+async fn pregrant_owner_retains_the_actual_session_step_and_config_arcs() {
+    let (owner, _root) = prepared_mechanical_owner().await;
+    let first = owner.retain().await.expect("first native snapshot");
+    let second = owner.retain().await.expect("second native snapshot");
+    assert!(Arc::ptr_eq(&first.session, &owner.session));
+    assert!(Arc::ptr_eq(&first.step, &owner.step));
+    assert!(Arc::ptr_eq(&first.session, &second.session));
+    assert!(Arc::ptr_eq(&first.step, &second.step));
+    assert!(Arc::ptr_eq(&first.config_context, &second.config_context));
+    assert!(Arc::ptr_eq(&first.config, &owner.session.services.config));
+    assert!(owner.session.active_turn.lock().await.is_none());
+    assert!(owner.session.mcp_prewarm_task.lock().expect("prewarm lock").is_none());
+    let state = owner.session.state.lock().await;
+    assert!(state.startup_prewarm.is_none());
+    assert!(state.shell_snapshot_prewarm.is_none());
+    assert!(state.last_started_turn_id.is_none());
+    assert!(Arc::ptr_eq(
+        &state.session_configuration.step_settings,
+        &owner.step.settings.selected_owner(),
+    ));
+    drop(state);
+    assert_eq!(first.verify_current(&owner).await, Ok(()));
+}
+
+#[tokio::test]
+async fn pregrant_owner_equal_thread_ids_do_not_replace_the_actual_session() {
+    let (owner, _root) = prepared_mechanical_owner().await;
+    let snapshot = owner.retain().await.expect("native snapshot");
+    let MechanicalFixture { mut input, _root: other_root } = mechanical_fixture().await;
+    input.thread_id = owner.session.thread_id;
+    let other = prepare_owned_pregrant(input).await.expect("other native owner");
+    assert_eq!(owner.session.thread_id, other.session.thread_id);
+    assert!(!Arc::ptr_eq(&owner.session, &other.session));
+    assert_eq!(snapshot.verify_current(&other).await, Err(PregrantOwnerError::SessionMismatch));
+    assert_eq!(snapshot.verify_current(&owner).await, Ok(()));
+    drop(other_root);
+}
+
+#[tokio::test]
+async fn pregrant_owner_equal_turn_ids_do_not_replace_the_actual_step() {
+    let (owner, _root) = prepared_mechanical_owner().await;
+    let (other, _other_root) = prepared_mechanical_owner().await;
+    let mut snapshot = owner.retain().await.expect("native snapshot");
+    assert_eq!(owner.step.turn.sub_id, other.step.turn.sub_id);
+    assert!(!Arc::ptr_eq(&owner.step, &other.step));
+    snapshot.step = Arc::clone(&other.step);
+    assert_eq!(snapshot.verify_current(&owner).await, Err(PregrantOwnerError::StepMismatch));
+}
