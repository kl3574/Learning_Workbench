+//! Private SDK state ownership before any controlled send is available.
+//!
+//! This phase owns real Session/Step values without constructing runtime services.
+//! It is a mechanical lifetime boundary. SDK-owned config replay does not prove
+//! complete input materials, native deployment authority, consent, or a sender.
+
+use super::ForkPersistence;
+use super::GitEnrichmentPolicy;
+use super::input_queue::InputQueue;
+use super::mcp_refresh::McpRefresh;
+use super::retained_context::CodeModeMessageTasks;
+use super::session::Session;
+use super::step_context::StepContext;
+use crate::agent::AgentStatus;
+use crate::config::Config;
+use crate::config::FrozenConfigMaterializationContext;
+use crate::realtime_conversation::RealtimeConversationManager;
+use crate::state::SessionState;
+use crate::tools::ExecutedToolCalls;
+use crate::tools::ExecutedToolCallsCheckpoint;
+use crate::tools::ExecutedToolCallsCheckpointError;
+use codex_history::InitialHistory;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::ThreadId;
+use codex_protocol::models::BaseInstructions;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use tokio::sync::Mutex;
+use tokio::sync::Semaphore;
+use tokio::sync::watch;
+use tokio_util::sync::CancellationToken;
+
+/// Only SDK-native values enter this private packing boundary. Their ownership
+/// does not establish source authority. No ordinary Session/active-task is accepted.
+pub(crate) struct OwnedPregrantSessionInput {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) installation_id: String,
+    pub(crate) state: SessionState,
+    pub(crate) step: StepContext,
+    pub(crate) initial_history: InitialHistory,
+    pub(crate) config_context: Arc<FrozenConfigMaterializationContext>,
+    pub(crate) windows_sandbox_proxy_settings_mode:
+        codex_sandboxing::WindowsSandboxProxySettingsMode,
+}
+
+/// No runtime handle, model client, MCP runtime, filesystem, or sender.
+pub(crate) struct PregrantServices {
+    config_context: Arc<FrozenConfigMaterializationContext>,
+    config: Arc<Config>,
+    executed_tool_calls: ExecutedToolCalls,
+    closed: CancellationToken,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum PregrantOwnerError {
+    ConfigReplayUnavailable,
+    ConfigChanged,
+    ConfiguredModelUnavailable,
+    RuntimeStatePresent,
+    StepSettingsChanged,
+    SessionMismatch,
+    StepMismatch,
+    HistoryChanged,
+    HistoryMetadataUnavailable,
+    InstructionsChanged,
+    ExecutedState(ExecutedToolCallsCheckpointError),
+    Closed,
+    CompleteInputProofUnavailable,
+}
+
+/// The same outer Session and exactly one Step remain owned until cancellation
+/// or drop. This type has no conversion to an ordinary runtime Session.
+pub(crate) struct NativePregrantOwner {
+    session: Arc<Session<PregrantServices>>,
+    step: Arc<StepContext>,
+}
+
+/// Derives the configured material fields from the SDK's replayed Config and
+/// retains the actual Step's selected-input Arc. This is not model/history authority.
+fn bind_configured_session_materials(
+    mut state: SessionState,
+    config: &Arc<Config>,
+    step: &StepContext,
+) -> Result<SessionState, PregrantOwnerError> {
+    let model = config
+        .model
+        .as_ref()
+        .filter(|model| !model.is_empty())
+        .ok_or(PregrantOwnerError::ConfiguredModelUnavailable)?;
+    let configured = super::step_settings::StepSettings {
+        collaboration_mode: codex_protocol::config_types::CollaborationMode {
+            mode: codex_protocol::config_types::ModeKind::Default,
+            settings: codex_protocol::config_types::Settings {
+                model: model.clone(),
+                reasoning_effort: config.model_reasoning_effort.clone(),
+                developer_instructions: None,
+            },
+        },
+        reasoning_summary: config.model_reasoning_summary,
+        service_tier: config.service_tier.clone(),
+        personality: config.personality,
+        approval_policy: config.permissions.approval_policy.clone(),
+        approvals_reviewer: config.approvals_reviewer,
+    };
+    if step.settings.selected() != &configured {
+        return Err(PregrantOwnerError::StepSettingsChanged);
+    }
+    let mut configuration = state.session_configuration.clone();
+    configuration.step_settings = step.settings.selected_owner();
+    configuration.model_info_overrides = config.to_models_manager_config().into();
+    configuration.developer_instructions = config.developer_instructions.clone();
+    configuration.base_instructions = config
+        .base_instructions
+        .clone()
+        .unwrap_or_else(|| codex_prompts::render_model_instructions(&step.settings.model_info));
+    configuration.permission_profile_state =
+        config.permissions.permission_profile_state().clone();
+    configuration.allow_login_shell = config.permissions.allow_login_shell;
+    configuration.shell_environment_policy = config.permissions.shell_environment_policy.clone();
+    configuration.windows_sandbox_type = config.permissions.windows_sandbox_type;
+    configuration.use_legacy_landlock = config.features.use_legacy_landlock();
+    configuration.legacy_fallback_cwd = config.cwd.clone();
+    configuration.runtime_workspace_roots = config.workspace_roots.clone();
+    configuration.codex_home = config.codex_home.clone();
+    configuration.original_config_do_not_use = Arc::clone(config);
+    // The actual writer revokes the previous instruction generation before the
+    // new private Session is shared. It never refreshes or constructs another Step.
+    state.replace_session_configuration(configuration);
+    Ok(state)
+}
+
+impl NativePregrantOwner {
+    pub(super) async fn prepare(
+        input: OwnedPregrantSessionInput,
+    ) -> Result<Self, PregrantOwnerError> {
+        let OwnedPregrantSessionInput {
+            thread_id,
+            installation_id,
+            state,
+            step,
+            initial_history,
+            config_context,
+            windows_sandbox_proxy_settings_mode,
+        } = input;
+        let replayed = Config::replay_retained_config_materialization(&config_context)
+            .await
+            .map_err(|_| PregrantOwnerError::ConfigReplayUnavailable)?;
+        let config = Arc::clone(&state.session_configuration.original_config_do_not_use);
+        if config.as_ref() != &replayed || !Arc::ptr_eq(&config, &step.turn.config) {
+            return Err(PregrantOwnerError::ConfigChanged);
+        }
+        if state.shutting_down
+            || state.startup_prewarm.is_some()
+            || state.shell_snapshot_prewarm.is_some()
+            || state.last_started_turn_id.is_some()
+        {
+            return Err(PregrantOwnerError::RuntimeStatePresent);
+        }
+        if !Arc::ptr_eq(&step.settings, &step.turn.next_step_settings.load_full()) {
+            return Err(PregrantOwnerError::StepSettingsChanged);
+        }
+        let state = bind_configured_session_materials(state, &config, &step)?;
+        let executed_tool_calls = ExecutedToolCalls::new(config.features.get(), &initial_history);
+        let services = PregrantServices {
+            config_context,
+            config: Arc::clone(&config),
+            executed_tool_calls,
+            closed: CancellationToken::new(),
+        };
+        let (tx_event, _events) = async_channel::unbounded();
+        let (agent_status, _status) = watch::channel(AgentStatus::PendingInit);
+        let (mcp_prewarm_tx, _prewarm) = async_channel::bounded(1);
+        let (_hooks, async_hook_results) = async_channel::unbounded();
+        let multi_agent_version = OnceLock::new();
+        let session = Arc::new(Session {
+            thread_id,
+            installation_id,
+            tx_event,
+            agent_status,
+            state: Mutex::new(state),
+            thread_settings_persistence: Semaphore::new(1),
+            code_mode_message_tasks: CodeModeMessageTasks::default(),
+            managed_network_proxy_refresh_lock: Semaphore::new(1),
+            features: config.features.clone(),
+            isolation: codex_extension_api::SessionIsolation::Isolated,
+            tool_policy: Arc::new(codex_extension_api::ToolPolicy {
+                allowed_tools: Some(Vec::new()),
+                require_managed_sandbox: true,
+                require_unified_exec: true,
+                expose_additional_permissions: false,
+            }),
+            windows_sandbox_proxy_settings_mode,
+            multi_agent_version,
+            mcp_refresh: McpRefresh::new(),
+            mcp_tool_approval_metadata: Default::default(),
+            mcp_elicitation_reviewer_handle: OnceLock::new(),
+            mcp_elicitation_lifecycle_handle: OnceLock::new(),
+            mcp_prewarm_tx,
+            mcp_prewarm_shutdown: CancellationToken::new(),
+            mcp_prewarm_task: std::sync::Mutex::new(None),
+            conversation: Arc::new(RealtimeConversationManager::new()),
+            realtime_history: None,
+            active_turn: Mutex::new(None),
+            async_hook_results,
+            input_queue: InputQueue::new(),
+            services,
+            git_enrichment_policy: GitEnrichmentPolicy::Skip,
+            fork_persistence: ForkPersistence::Copied,
+            forked_from_ordinal_exclusive: None,
+            next_internal_sub_id: AtomicU64::new(0),
+        });
+        // This is the only Step allocation. There is no second-Step start path.
+        let step = Arc::new(step);
+        let owner = Self { session, step };
+        owner.retain().await?;
+        Ok(owner)
+    }
+
+    pub(crate) async fn retain(&self) -> Result<NativePregrantSnapshot, PregrantOwnerError> {
+        self.ensure_open()?;
+        let executed_state = self
+            .session
+            .services
+            .executed_tool_calls
+            .state_checkpoint()
+            .map_err(PregrantOwnerError::ExecutedState)?;
+        let state = self.session.state.lock().await;
+        let snapshot = NativePregrantSnapshot {
+            session: Arc::clone(&self.session),
+            step: Arc::clone(&self.step),
+            config_context: Arc::clone(&self.session.services.config_context),
+            config: Arc::clone(&state.session_configuration.original_config_do_not_use),
+            history: state.clone_history().into_shared_annotated_items(),
+            history_version: state.history.history_version(),
+            reference_context: serde_json::to_value(state.history.reference_context_item())
+                .map_err(|_| PregrantOwnerError::HistoryMetadataUnavailable)?,
+            instructions: BaseInstructions {
+                text: state.session_configuration.base_instructions.clone(),
+                provenance: state.base_instructions_provenance(),
+            },
+            history_reset: state.history_reset.child_token(),
+            instruction_reset: state.prompt_instruction_reset(),
+            executed_state,
+        };
+        drop(state);
+        snapshot.verify_current(self).await?;
+        Ok(snapshot)
+    }
+
+    pub(crate) fn cancel(&self) {
+        self.session.services.closed.cancel();
+    }
+
+    fn ensure_open(&self) -> Result<(), PregrantOwnerError> {
+        if self.session.services.closed.is_cancelled() {
+            Err(PregrantOwnerError::Closed)
+        } else {
+            Ok(())
+        }
+    }
+
+    /// Consumes this exact owner and snapshot. Complete proof and sender bindings
+    /// are unavailable, so there is no grant, request construction, or send.
+    pub(crate) async fn checked_start(
+        self,
+        snapshot: NativePregrantSnapshot,
+    ) -> Result<(), PregrantOwnerError> {
+        snapshot.verify_current(&self).await?;
+        Err(PregrantOwnerError::CompleteInputProofUnavailable)
+    }
+}
+
+impl Drop for NativePregrantOwner {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+/// Read-only mechanical state. Keeping this alive cannot keep a dropped owner
+/// usable: its cancellation token belongs to the owner lifetime.
+pub(crate) struct NativePregrantSnapshot {
+    session: Arc<Session<PregrantServices>>,
+    step: Arc<StepContext>,
+    config_context: Arc<FrozenConfigMaterializationContext>,
+    config: Arc<Config>,
+    history: Arc<Vec<ResponseItemEnvelope>>,
+    history_version: u64,
+    reference_context: serde_json::Value,
+    instructions: BaseInstructions,
+    history_reset: CancellationToken,
+    instruction_reset: CancellationToken,
+    executed_state: ExecutedToolCallsCheckpoint,
+}
+
+impl NativePregrantSnapshot {
+    pub(crate) async fn verify_current(
+        &self,
+        owner: &NativePregrantOwner,
+    ) -> Result<(), PregrantOwnerError> {
+        owner.ensure_open()?;
+        if !Arc::ptr_eq(&self.session, &owner.session) {
+            return Err(PregrantOwnerError::SessionMismatch);
+        }
+        if !Arc::ptr_eq(&self.step, &owner.step) {
+            return Err(PregrantOwnerError::StepMismatch);
+        }
+        if !Arc::ptr_eq(&self.config_context, &owner.session.services.config_context)
+            || !Arc::ptr_eq(&self.config, &owner.session.services.config)
+            || !Arc::ptr_eq(&self.config, &self.step.turn.config)
+        {
+            return Err(PregrantOwnerError::ConfigChanged);
+        }
+        if !Arc::ptr_eq(&self.step.settings, &self.step.turn.next_step_settings.load_full()) {
+            return Err(PregrantOwnerError::StepSettingsChanged);
+        }
+        let state = owner.session.state.lock().await;
+        if state.shutting_down {
+            return Err(PregrantOwnerError::Closed);
+        }
+        if self.history_reset.is_cancelled()
+            || self.history_version != state.history.history_version()
+            || !Arc::ptr_eq(
+                &self.history,
+                &state.clone_history().into_shared_annotated_items(),
+            )
+        {
+            return Err(PregrantOwnerError::HistoryChanged);
+        }
+        let reference_context = serde_json::to_value(state.history.reference_context_item())
+            .map_err(|_| PregrantOwnerError::HistoryMetadataUnavailable)?;
+        if self.reference_context != reference_context {
+            return Err(PregrantOwnerError::HistoryChanged);
+        }
+        if self.instruction_reset.is_cancelled()
+            || self.instructions
+                != (BaseInstructions {
+                    text: state.session_configuration.base_instructions.clone(),
+                    provenance: state.base_instructions_provenance(),
+                })
+        {
+            return Err(PregrantOwnerError::InstructionsChanged);
+        }
+        if !Arc::ptr_eq(
+            &self.config,
+            &state.session_configuration.original_config_do_not_use,
+        ) {
+            return Err(PregrantOwnerError::ConfigChanged);
+        }
+        drop(state);
+        owner.ensure_open()?;
+        if !Arc::ptr_eq(&self.step.settings, &self.step.turn.next_step_settings.load_full()) {
+            return Err(PregrantOwnerError::StepSettingsChanged);
+        }
+        owner
+            .session
+            .services
+            .executed_tool_calls
+            .verify_state_checkpoint(&self.executed_state)
+            .map_err(PregrantOwnerError::ExecutedState)
+    }
+}
