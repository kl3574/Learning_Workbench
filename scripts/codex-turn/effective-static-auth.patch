+/// Opaque static credentials resolved by the configured provider itself.
+///
+/// This is sensitive in-memory material, not InputProof, native-owner authority,
+/// or a durable consent. There is no credential getter or caller constructor.
+pub struct ControlledStaticBearerSnapshot {
+    effective_auth: CodexAuth,
+    authorization: HeaderValue,
+}
+
+impl std::fmt::Debug for ControlledStaticBearerSnapshot {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("ControlledStaticBearerSnapshot")
+            .finish_non_exhaustive()
+    }
+}
+
+impl ControlledStaticBearerSnapshot {
+    /// A projection of the actual retained auth object, not a caller auth label.
+    pub fn is_api_key_auth(&self) -> bool {
+        self.effective_auth.is_api_key_auth()
+    }
+
+    /// Install the final sensitive header and return the same owned snapshot.
+    ///
+    /// The owner must retain that snapshot alongside the original request and
+    /// its final frozen handle. Do not invoke managed auth after this step.
+    /// Native owner, secret-version, InputProof and ledger binding remain absent.
+    pub fn apply_to_request(
+        self,
+        mut request: codex_http_client::Request,
+    ) -> codex_protocol::error::Result<(Self, codex_http_client::Request)> {
+        if request.headers.contains_key(http::header::AUTHORIZATION)
+            || request.headers.contains_key(http::header::PROXY_AUTHORIZATION)
+            || request.headers.contains_key(http::header::COOKIE)
+        {
+            return Err(controlled_static_auth_unavailable());
+        }
+        request
+            .headers
+            .insert(http::header::AUTHORIZATION, self.authorization.clone());
+        Ok((self, request))
+    }
+}
+
+fn controlled_static_auth_unavailable() -> CodexErr {
+    CodexErr::UnsupportedOperation("CODEX_STATIC_AUTH_SNAPSHOT_UNAVAILABLE".to_string())
+}
+
+/// Preserve the existing provider key-before-explicit-bearer precedence, but
+/// never enter command, managed, AgentIdentity, gateway or signing paths.
+/// The closure is private: production passes the actual provider api_key()
+/// resolver, while tests can prove precedence without inspecting the host.
+fn controlled_static_token_with<F>(
+    provider: &ModelProviderInfo,
+    api_key: F,
+) -> codex_protocol::error::Result<String>
+where
+    F: FnOnce() -> codex_protocol::error::Result<Option<String>>,
+{
+    if provider.auth.is_some()
+        || provider.gateway_oauth.is_some()
+        || provider.aws.is_some()
+        || provider.is_amazon_bedrock()
+    {
+        return Err(controlled_static_auth_unavailable());
+    }
+    provider.validate().map_err(CodexErr::InvalidRequest)?;
+    // A failed configured key resolution must not fall back to another source.
+    if let Some(token) = api_key()? {
+        return Ok(token);
+    }
+    let token = provider
+        .experimental_bearer_token
+        .clone()
+        .ok_or_else(controlled_static_auth_unavailable)?;
+    Ok(token.into_inner())
+}
+
+pub(crate) fn resolve_controlled_static_bearer_snapshot(
+    provider: &ModelProviderInfo,
+) -> codex_protocol::error::Result<ControlledStaticBearerSnapshot> {
+    let token = controlled_static_token_with(provider, || provider.api_key())?;
+    controlled_static_snapshot_from_token(token)
+}
+
+fn controlled_static_snapshot_from_token(
+    token: String,
+) -> codex_protocol::error::Result<ControlledStaticBearerSnapshot> {
+    // One actual static auth object supplies both the retained identity and the
+    // final header. No ambient/account projection or AuthManager is consulted.
+    let effective_auth = CodexAuth::from_api_key(&token);
+    let headers = auth_provider_from_auth(&effective_auth).to_auth_headers();
+    let authorization_values = headers.get_all(http::header::AUTHORIZATION);
+    let mut values = authorization_values.iter();
+    let mut authorization = values
+        .next()
+        .cloned()
+        .ok_or_else(controlled_static_auth_unavailable)?;
+    if values.next().is_some() || headers.len() != 1 {
+        return Err(controlled_static_auth_unavailable());
+    }
+    let token = authorization
+        .to_str()
+        .ok()
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .ok_or_else(controlled_static_auth_unavailable)?;
+    let mut parts = token.splitn(2, '=');
+    let value = parts.next().ok_or_else(controlled_static_auth_unavailable)?;
+    if value.is_empty()
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"-._~+/".contains(&byte))
+        || parts
+            .next()
+            .is_some_and(|padding| !padding.bytes().all(|byte| byte == b'='))
+    {
+        return Err(controlled_static_auth_unavailable());
+    }
+    authorization.set_sensitive(true);
+    Ok(ControlledStaticBearerSnapshot {
+        effective_auth,
+        authorization,
+    })
+}
