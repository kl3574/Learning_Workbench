+        http::header::COOKIE,
+    ] {
+        for duplicate in [false, true] {
+            let mut request = prepare(facts()).expect("genuine B03 request");
+            request.headers.append(
+                header.clone(),
+                HeaderValue::from_static("synthetic-original"),
+            );
+            if duplicate {
+                request.headers.append(
+                    header.clone(),
+                    HeaderValue::from_static("synthetic-conflict"),
