+#[test]
+fn controlled_prepare_retains_complete_typed_request_and_original_allocation() {
+    let input = complete_request();
+    let mut expected = serde_json::to_value(&input).expect("complete original request");
+    expected["max_output_tokens"] = json!(64);
+    expected["truncation"] = json!("disabled");
+    let maximum = NonZeroU64::new(64).expect("positive fixture budget");
+    let mut prepared =
+        prepare_controlled_responses_request(&provider(), input, &options(), maximum)
+            .expect("local controlled preparation");
+    let Some(RequestBody::EncodedJson(body)) = prepared.body.as_ref() else {
+        panic!("the producer must retain the real EncodedJson body");
+    };
+    let pointer = body.as_bytes().as_ptr();
+    let bytes = body.as_bytes().to_vec();
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&bytes).expect("actual producer JSON"),
+        expected
+    );
+    assert_eq!(
+        (
+            &prepared.method,
+            prepared.url.as_str(),
+            prepared.compression
+        ),
+        (
+            &Method::POST,
+            "https://example.com/v1/responses",
+            codex_client::RequestCompression::None
+        )
+    );
+    let expected_headers = HeaderMap::from_iter([
+        (
+            http::header::HeaderName::from_static("x-provider-fixture"),
+            HeaderValue::from_static("original"),
+        ),
+        (
+            http::header::HeaderName::from_static("x-request-fixture"),
+            HeaderValue::from_static("original"),
+        ),
+        (
+            http::header::HeaderName::from_static("x-client-request-id"),
+            HeaderValue::from_static("original-thread"),
+        ),
+        (
+            http::header::HeaderName::from_static("thread-id"),
+            HeaderValue::from_static("original-thread"),
+        ),
+        (
+            http::header::HeaderName::from_static("session-id"),
+            HeaderValue::from_static("original-session"),
+        ),
+        (
+            http::header::ACCEPT,
+            HeaderValue::from_static("text/event-stream"),
+        ),
+        (
+            http::header::CONTENT_TYPE,
+            HeaderValue::from_static("application/json"),
+        ),
+    ]);
+    assert_eq!(prepared.headers, expected_headers);
+
+    // Final trusted header and local limits are supplied before freezing.
+    prepared.headers.insert(
+        http::header::AUTHORIZATION,
+        HeaderValue::from_static("Bearer local-only-fixture"),
+    );
+    prepared.timeout = Some(Duration::from_secs(2));
+    prepared.response_body_limit_bytes = Some(4096);
+    let frozen =
+        FrozenResponsesRequest::freeze(prepared, maximum).expect("freeze actual producer result");
+    let retained = frozen.prepared_request();
+    let Some(RequestBody::EncodedJson(body)) = retained.body.as_ref() else {
+        panic!("freeze must preserve the original EncodedJson allocation");
+    };
+    assert_eq!(body.as_bytes(), bytes);
+    assert_eq!(body.as_bytes().as_ptr(), pointer);
+    let again = retained
+        .clone()
+        .into_prepared()
+        .expect("retain an already prepared body");
+    let Some(RequestBody::EncodedJson(body)) = again.body.as_ref() else {
+        panic!("preparation must not replace the retained allocation");
+    };
+    assert_eq!(body.as_bytes(), bytes);
+    assert_eq!(body.as_bytes().as_ptr(), pointer);
+}
