+#[tokio::test]
+async fn final_bearer_actual_sender_rejects_late_auth_change_with_zero_owned_connections() {
+    use codex_http_client::HttpTransport;
+    let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).expect("owned listener");
+    listener
+        .set_nonblocking(/*nonblocking*/ true)
+        .expect("nonblocking owned observer");
+    let address = listener.local_addr().expect("owned address");
+    let mut request = prepare(facts()).expect("genuine B03 request");
+    request.url = format!("https://{address}/v1/responses");
+    let frozen = final_bearer(request);
+    let sender = codex_http_client::ReqwestTransport::for_frozen_responses_request(
+        std::sync::Arc::clone(&frozen),
+    )
+    .expect("actual restricted client builds locally");
+    let mut changed = frozen.prepared_request();
+    changed.headers.insert(
+        http::header::AUTHORIZATION,
+        HeaderValue::from_static("Bearer changed-fixture"),
+    );
+    let error = sender
+        .stream(changed)
+        .await
+        .err()
+        .expect("late auth cannot be released");
+    assert!(
+        matches!(error, codex_client::TransportError::Build(ref message) if message == "CODEX_FROZEN_REQUEST_CHANGED")
+    );
+    assert!(
+        matches!(listener.accept(), Err(error) if error.kind() == std::io::ErrorKind::WouldBlock)
+    );
+    let error = sender
+        .clone()
+        .execute(frozen.prepared_request())
+        .await
+        .err()
+        .expect("mismatch consumes shared capability");
+    assert!(
+        matches!(error, codex_client::TransportError::Build(ref message) if message == "CODEX_NEW_OUTBOUND_CONSENT_REQUIRED")
+    );
+}
