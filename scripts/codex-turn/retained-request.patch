+    let error = serialize_websocket_request(&request)
+        .expect_err("WebSocket requests with output limits must not be serialized");
+
+    assert!(matches!(
+        error,
+        ApiError::InvalidRequest { message } if message == "CODEX_OUTPUT_LIMIT_UNAVAILABLE"
+    ));
+}
+
+#[test]
+fn websocket_serializer_preserves_request_without_output_limits() {
+    let api_request = api_request_without_output_limits();
+    let request = ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest::from(&api_request));
+
+    let request_text = serialize_websocket_request(&request)
+        .expect("ordinary WebSocket requests should remain supported");
+    let wire_payload = serde_json::from_str::<serde_json::Value>(&request_text)
+        .expect("parse ordinary WebSocket request");
+
+    assert_eq!(
+        wire_payload,
+        json!({
+            "type": "response.create",
+            "model": "gpt-test",
+            "input": [],
+            "tool_choice": "auto",
+            "parallel_tool_calls": false,
+            "reasoning": null,
+            "store": false,
+            "stream": true,
+            "include": []
+        })
+    );
+}
