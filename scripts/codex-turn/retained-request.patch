+#[tokio::test]
+async fn final_bearer_actual_connection_failure_cannot_refund_frozen_auth_or_send_again() {
+    use codex_http_client::HttpTransport;
+    let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).expect("owned port");
+    let address = listener.local_addr().expect("owned address");
+    drop(listener);
+    let mut request = prepare(facts()).expect("genuine B03 request");
+    request.url = format!("https://{address}/v1/responses");
+    request.timeout = Some(Duration::from_secs(/*secs*/ 2));
+    let frozen = final_bearer(request);
+    let sender = codex_http_client::ReqwestTransport::for_frozen_responses_request(
+        std::sync::Arc::clone(&frozen),
+    )
+    .expect("restricted sender");
+    let error = sender
+        .execute(frozen.prepared_request())
+        .await
+        .err()
+        .expect("owned closed port fails");
+    assert!(matches!(error, codex_client::TransportError::Connection(_)));
+    let rebuilt = codex_http_client::ReqwestTransport::for_frozen_responses_request(
+        std::sync::Arc::clone(&frozen),
+    )
+    .expect("new sender retains same Arc");
+    let error = rebuilt
+        .stream(frozen.prepared_request())
+        .await
+        .err()
+        .expect("no refund after failure");
+    assert!(
+        matches!(error, codex_client::TransportError::Build(ref message) if message == "CODEX_NEW_OUTBOUND_CONSENT_REQUIRED")
+    );
+}
