+type Checked<T> = Result<T, ()>;
+struct Unique;
+impl<'de> Deserialize<'de> for Unique {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        struct V;
+        impl<'de> Visitor<'de> for V {
+            type Value = Unique;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("unique JSON names")
+            }
+            fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_i64<E: serde::de::Error>(self, _: i64) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_str<E: serde::de::Error>(self, _: &str) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_unit<E: serde::de::Error>(self) -> Result<Unique, E> {
+                Ok(Unique)
+            }
+            fn visit_seq<A: SeqAccess<'de>>(self, mut a: A) -> Result<Unique, A::Error> {
+                while a.next_element::<Unique>()?.is_some() {}
+                Ok(Unique)
+            }
+            fn visit_map<A: MapAccess<'de>>(self, mut a: A) -> Result<Unique, A::Error> {
+                let mut names = HashSet::new();
+                while let Some(name) = a.next_key::<String>()? {
+                    if !names.insert(name) {
+                        return Err(serde::de::Error::custom("duplicate fact"));
+                    }
+                    a.next_value::<Unique>()?;
+                }
+                Ok(Unique)
+            }
+        }
+        d.deserialize_any(V)
+    }
+}
+fn object<'a>(v: &'a Value, keys: &[&str]) -> Checked<&'a Map<String, Value>> {
+    let m = v.as_object().ok_or(())?;
+    if m.len() != keys.len() || keys.iter().any(|k| !m.contains_key(*k)) {
+        return Err(());
+    }
+    Ok(m)
+}
+fn text(v: &Value) -> Checked<String> {
+    v.as_str().map(str::to_owned).ok_or(())
+}
+fn boolean(v: &Value) -> Checked<bool> {
+    v.as_bool().ok_or(())
+}
+fn parse<T: DeserializeOwned>(v: &Value) -> Checked<T> {
+    serde_json::from_value(v.clone()).map_err(|_| ())
+}
+fn headers(v: &Value) -> Checked<HeaderMap> {
+    let mut h = HeaderMap::new();
+    let rows = v.as_array().ok_or(())?;
+    if rows.len() > 128 {
+        return Err(());
+    }
+    for row in rows {
+        let pair = row.as_array().ok_or(())?;
+        if pair.len() != 2 {
+            return Err(());
+        }
+        let name =
+            http::header::HeaderName::from_bytes(text(&pair[0])?.as_bytes()).map_err(|_| ())?;
+        let value = HeaderValue::from_str(&text(&pair[1])?).map_err(|_| ())?;
+        if h.contains_key(&name) {
+            return Err(());
+        }
+        h.insert(name, value);
+    }
+    Ok(h)
+}
+fn optional_header(v: &Value) -> Checked<Option<HeaderValue>> {
+    if v.is_null() {
+        Ok(None)
+    } else {
+        HeaderValue::from_str(&text(v)?).map(Some).map_err(|_| ())
+    }
+}
+fn requirement(v: &Value) -> Checked<Requirement> {
+    match v.as_str() {
+        Some("required") => Ok(Requirement::Required),
+        Some("not_required") => Ok(Requirement::NotRequired),
+        _ => Err(()),
+    }
