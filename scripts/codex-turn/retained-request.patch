+//! Pure construction from already resolved owner material. No authority/proof is created here.
+//! No ModelClient, auth object, callback, telemetry, writer, live OnceLock or transport is accepted.
+//! This private B staging interface is not connected to a platform bridge or production registry.
+
+use super::tool_metadata;
+use crate::client_common::Prompt;
+use crate::context::BaseInstructionsFragment;
+use crate::context::ContextualUserFragment;
+use crate::responses_metadata::CodexResponsesMetadata;
+use codex_api::AccessPrograms;
+use codex_api::ApiError;
+use codex_api::Provider;
