--- /dev/null
+++ b/codex-rs/core/src/retained_request_ffi.rs
@@ -0,0 +1,233 @@
+//! Private in-process ABI01 memory bridge. No send, live auth, ledger or authority.
+//! Foreign pointers are only caller-owned bounded buffers; handles are checked IDs,
+//! never foreign-owned Rust pointers. Each key can create at most once per process.
+use super::responses_producer::{
+    ControlledAuthMode, Resolved, finalize_controlled_bearer_request,
+    prepare_controlled_core_request,
+};
+#[path = "retained_request_facts.rs"]
+mod facts;
+use codex_client::RequestBody;
+use codex_http_client::FrozenResponsesRequest;
+use http::HeaderValue;
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex, OnceLock};
+
+const INVALID: i32 = 1;
+const DUPLICATE: i32 = 2;
+const UNSUPPORTED: i32 = 3;
+const PANIC: i32 = 4;
+const MAX_FACT_BYTES: usize = 1_048_576;
+const MAX_HANDLES: usize = 1024;
+struct Retained {
+    frozen: Arc<FrozenResponsesRequest>,
+    encoded_address: usize,
+}
+#[derive(Default)]
+struct Registry {
+    next: u64,
+    seen: HashSet<String>,
+    handles: HashMap<u64, Arc<Retained>>,
+}
+static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
+fn registry() -> &'static Mutex<Registry> {
+    REGISTRY.get_or_init(|| Mutex::new(Registry::default()))
+}
+fn caught(f: impl FnOnce() -> Result<(), i32>) -> i32 {
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)) {
+        Ok(Ok(())) => 0,
+        Ok(Err(code)) => code,
+        Err(_) => PANIC,
+    }
+}
+fn lookup(handle: u64) -> Result<Arc<Retained>, i32> {
+    registry()
+        .lock()
+        .map_err(|_| PANIC)?
+        .handles
+        .get(&handle)
+        .cloned()
+        .ok_or(INVALID)
+}
+fn insert(r: &mut Registry, retained: Arc<Retained>) -> Result<u64, i32> {
+    if r.handles.len() >= MAX_HANDLES {
+        return Err(UNSUPPORTED);
+    }
+    r.next = r.next.checked_add(1).ok_or(UNSUPPORTED)?;
+    let id = r.next;
+    r.handles.insert(id, retained);
+    Ok(id)
+}
+/// Safety: input/output buffers must be valid owned foreign allocations for their
+/// declared bounded lengths and must remain alive for this synchronous call.
+/// No credential or material enters any Debug/log/error representation.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn m63_request_create(
+    materials: *const u8,
+    length: usize,
+    bearer: *const u8,
+    bearer_length: usize,
+    output: *mut u64,
+) -> i32 {
+    if materials.is_null()
+        || bearer.is_null()
+        || output.is_null()
+        || length == 0
+        || length > MAX_FACT_BYTES
+        || bearer_length == 0
+        || bearer_length > 4096
+    {
+        return INVALID;
+    }
+    caught(|| {
+        // SAFETY: the private owned caller guarantees exactly the buffers checked above.
+        let input = unsafe { std::slice::from_raw_parts(materials, length) };
+        let auth = unsafe { std::slice::from_raw_parts(bearer, bearer_length) };
+        let m = facts::Materials::from_slice(input).map_err(|_| UNSUPPORTED)?;
+        {
+            let mut r = registry().lock().map_err(|_| PANIC)?;
+            if r.seen.contains(&m.creation_key) {
+                return Err(DUPLICATE);
+            }
+            if r.seen.len() >= MAX_HANDLES {
+                return Err(UNSUPPORTED);
+            }
+            r.seen.insert(m.creation_key.clone());
+        }
+        // No request JSON arrives from Python. The genuine existing core producer
+        // creates its actual envelope and calls the sole shared EncodedJson encoder.
+        let mut request = prepare_controlled_core_request(
+            &m.prompt,
+            &m.model,
+            m.effort,
+            m.summary,
+            m.service_tier,
+            &m.metadata,
+            m.include_internal,
+            &m.policy,
+            &m.provider,
+            m.facts,
+            m.maximum,
+        )
+        .map_err(|_| UNSUPPORTED)?;
+        request.timeout = m.timeout;
+        request.response_body_limit_bytes = m.response_cap;
+        let encoded_address = match request.body.as_ref() {
+            Some(RequestBody::EncodedJson(body)) => body.as_bytes().as_ptr() as usize,
+            _ => return Err(UNSUPPORTED),
+        };
+        let auth = HeaderValue::from_bytes(auth).map_err(|_| UNSUPPORTED)?;
+        let frozen = finalize_controlled_bearer_request(
+            request,
+            Resolved::Value(ControlledAuthMode::StaticApiKeyBearer),
+            auth,
+            m.maximum,
+        )
+        .map_err(|_| UNSUPPORTED)?;
+        if frozen.body_bytes().as_ptr() as usize != encoded_address {
+            return Err(UNSUPPORTED);
+        }
+        let id = insert(
+            &mut *registry().lock().map_err(|_| PANIC)?,
+            Arc::new(Retained {
+                frozen,
+                encoded_address,
+            }),
+        )?;
+        // SAFETY: output is the caller's owned u64 slot for this call.
+        unsafe { output.write(id) };
+        Ok(())
+    })
+}
+/// A borrowed state projection contains no body, URL or Authorization value.
+#[repr(C)]
+pub struct RequestInfo {
+    pub body_bytes: u64,
+    pub encoded_frozen_same: u64,
+    pub cloned_body_same: u64,
+    pub auth_sensitive: u64,
+}
+/// Safety: output points to one caller-owned RequestInfo; it is never retained.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn m63_request_info(handle: u64, output: *mut RequestInfo) -> i32 {
+    if output.is_null() {
+        return INVALID;
+    }
+    caught(|| {
+        let r = lookup(handle)?;
+        let request = r.frozen.prepared_request();
+        let clone_address = match request.body.as_ref() {
+            Some(RequestBody::EncodedJson(b)) => b.as_bytes().as_ptr() as usize,
+            _ => return Err(UNSUPPORTED),
+        };
+        let info = RequestInfo {
+            body_bytes: r.frozen.body_bytes().len() as u64,
+            encoded_frozen_same: u64::from(
+                r.encoded_address == r.frozen.body_bytes().as_ptr() as usize,
+            ),
+            cloned_body_same: u64::from(clone_address == r.encoded_address),
+            auth_sensitive: u64::from(
+                request
+                    .headers
+                    .get(http::header::AUTHORIZATION)
+                    .is_some_and(HeaderValue::is_sensitive),
+            ),
+        };
+        // SAFETY: output is the caller's owned struct slot.
+        unsafe { output.write(info) };
+        Ok(())
+    })
+}
+/// Safety: output has `capacity` owned writable bytes and size is one usize slot.
+/// This private bounded copy is for owned verification; headers are never copied.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn m63_request_copy_body(
+    handle: u64,
+    output: *mut u8,
+    capacity: usize,
+    size: *mut usize,
+) -> i32 {
+    if output.is_null() || size.is_null() || capacity == 0 || capacity > MAX_FACT_BYTES {
+        return INVALID;
+    }
+    caught(|| {
+        let r = lookup(handle)?;
+        let body = r.frozen.body_bytes();
+        if body.len() > capacity {
+            return Err(INVALID);
+        }
+        // SAFETY: caller owns this buffer; no Rust reference survives the copy.
+        unsafe {
+            std::ptr::copy_nonoverlapping(body.as_ptr(), output, body.len());
+            size.write(body.len())
+        };
+        Ok(())
+    })
+}
+/// Safety: output points to one owned u64 slot; clone shares the same frozen Arc.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn m63_request_clone(handle: u64, output: *mut u64) -> i32 {
+    if output.is_null() {
+        return INVALID;
+    }
+    caught(|| {
+        let retained = lookup(handle)?;
+        let id = insert(&mut *registry().lock().map_err(|_| PANIC)?, retained)?;
+        unsafe { output.write(id) };
+        Ok(())
+    })
+}
+/// Removes exactly one checked handle. Double/unknown release is rejected.
+/// Last release drops the genuine request allocation; the creation tombstone stays.
+#[unsafe(no_mangle)]
+pub extern "C" fn m63_request_release(handle: u64) -> i32 {
+    caught(|| {
+        registry()
+            .lock()
+            .map_err(|_| PANIC)?
+            .handles
+            .remove(&handle)
+            .ok_or(INVALID)?;
+        Ok(())
+    })
+}
