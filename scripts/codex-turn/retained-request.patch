+#[tokio::test]
+async fn frozen_responses_request_connection_failure_does_not_refund_the_real_sender() {
+    let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).expect("owned port binds");
+    let address = listener.local_addr().expect("owned address");
+    drop(listener);
+    let mut request = frozen_request().prepared_request();
+    request.url = format!("https://{address}/v1/responses");
+    request.timeout = Some(Duration::from_secs(2));
+    let frozen = Arc::new(
+        FrozenResponsesRequest::freeze(request, output_limit()).expect("freeze owned URL"),
+    );
+    let transport =
+        ReqwestTransport::for_frozen_responses_request(Arc::clone(&frozen)).expect("client builds");
+    let error = transport
+        .execute(frozen.prepared_request())
+        .await
+        .err()
+        .expect("owned closed port fails");
+    assert!(matches!(error, TransportError::Connection(_)));
+    let retry = ReqwestTransport::for_frozen_responses_request(Arc::clone(&frozen))
+        .expect("client rebuilds");
+    let error = retry
+        .stream(frozen.prepared_request())
+        .await
+        .err()
+        .expect("consumed gate survives rebuilt sender");
+    assert!(
+        matches!(error, TransportError::Build(ref message) if message == "CODEX_NEW_OUTBOUND_CONSENT_REQUIRED")
+    );
+}
