+#[tokio::test]
+async fn frozen_responses_request_new_transport_cannot_refund_a_claimed_capability() {
+    let frozen = Arc::new(frozen_request());
+    assert_eq!(
+        frozen.claim(
+            &built_request(&frozen),
+            frozen.request.response_body_limit_bytes
+        ),
+        Ok(())
+    );
+    // Simulate any failure/cancellation after claim without making a connection.
+    let first =
+        ReqwestTransport::for_frozen_responses_request(Arc::clone(&frozen)).expect("client builds");
+    let second = ReqwestTransport::for_frozen_responses_request(Arc::clone(&frozen))
+        .expect("another client builds");
+    for transport in [first, second] {
+        let error = transport
+            .execute(frozen.prepared_request())
+            .await
+            .err()
+            .expect("spent capability rejects before network");
+        assert!(
+            matches!(error, TransportError::Build(ref message) if message == "CODEX_NEW_OUTBOUND_CONSENT_REQUIRED")
+        );
+    }
+}
