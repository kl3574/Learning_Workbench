+            compatibility_headers: Resolved::Value(headers(&f["compatibility_headers"])?),
+            attestation_requirement: requirement(&f["attestation_requirement"])?,
+            attestation: Resolved::Value(optional_header(&f["attestation"])?),
+            guardian_credits: Resolved::Value(GuardianCredits::NotRequested),
+            access_programs: Resolved::Value(None),
+            routing_hint: Resolved::Value(optional_header(&f["routing_hint"])?),
+            responses_headers: Resolved::Value(response_headers),
+            content_item_kinds_enabled: boolean(&f["content_item_kinds_enabled"])?,
+            expected_contributors: parse(&f["expected_contributors"])?,
+            contributions: Resolved::Value(parse::<Vec<BTreeMap<String, String>>>(
+                &f["contributions"],
+            )?),
+            trace_requirement: requirement(&f["trace_requirement"])?,
+            trace_header: Resolved::Value(optional_header(&f["trace_header"])?),
+        };
+        Ok(Self {
+            creation_key,
+            prompt,
+            model,
+            metadata,
+            policy,
+            provider,
+            facts,
+            maximum: NonZeroU64::new(parse(&top["maximum"])?).ok_or(())?,
+            effort: parse(&top["effort"])?,
+            summary: parse(&top["summary"])?,
+            service_tier: parse(&top["service_tier"])?,
+            include_internal: boolean(&top["include_internal"])?,
+            timeout: parse::<Option<u64>>(&top["timeout_ms"])?.map(Duration::from_millis),
+            response_cap: parse(&top["response_body_limit_bytes"])?,
+        })
+    }
+}
