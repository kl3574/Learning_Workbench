+    assert_eq!(frozen.body_bytes().as_ptr(), original.as_bytes().as_ptr());
+    assert_eq!(frozen.body_bytes(), original.as_bytes());
+    assert_eq!(final_request.method, method);
+    assert_eq!(final_request.url, url);
+    assert_eq!(final_request.timeout, Some(Duration::from_secs(/*secs*/ 2)));
