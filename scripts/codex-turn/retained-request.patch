+
+pub(super) struct ResolvedBodyPolicy {
+    pub thread_id: ThreadId,
+    pub is_openai: bool,
+    pub is_bedrock: bool,
+    pub namespace_tools: bool,
+    pub reasoning_effort_override_enabled: bool,
+    pub concurrent_reasoning_summaries_enabled: bool,
+    pub model_verbosity: Option<VerbosityConfig>,
+    pub prompt_cache_key: String,
+}
+
+pub(super) struct BuiltResponsesRequest {
+    pub request: ResponsesApiRequest,
+    pub ignored_verbosity: bool,
+}
+
+fn build_reasoning(
+    model_info: &ModelInfo,
+    effort: Option<ReasoningEffortConfig>,
+    summary: ReasoningSummaryConfig,
+) -> Reasoning {
+    Reasoning {
+        effort: effort
+            .or_else(|| model_info.default_reasoning_level.clone())
+            .map(|effort| model_info.resolve_reasoning_effort(effort)),
+        summary: (model_info.supports_reasoning_summary_parameter
+            && summary != ReasoningSummaryConfig::None)
+            .then_some(summary),
+        context: model_info
+            .use_responses_lite
+            .then_some(ReasoningContext::AllTurns),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn build_responses_request_from_resolved(
+    prompt: &Prompt,
+    model_info: &ModelInfo,
+    effort: Option<ReasoningEffortConfig>,
+    summary: ReasoningSummaryConfig,
+    service_tier: Option<String>,
+    responses_metadata: &CodexResponsesMetadata,
+    include_internal: bool,
+    policy: &ResolvedBodyPolicy,
+) -> Result<BuiltResponsesRequest> {
+    let mut input = prompt.get_formatted_input_for_request(model_info);
+    if !policy.reasoning_effort_override_enabled {
+        // Unsupported models and disabled overrides must also accept saved history.
+        // Filter only the request copy; persisted history remains unchanged.
+        input.retain(|item| !matches!(item, ResponseItem::ConfigurationUpdate { .. }));
+    }
+    let is_openai = policy.is_openai;
+    let (instructions, tools) = if model_info.use_responses_lite {
+        // These prompt-only items are rebuilt on every request. Hash their visible payloads
+        // within the thread so retries and resumed sessions preserve their identity.
+        let prefix_namespace = Uuid::new_v5(
+            &Uuid::NAMESPACE_OID,
+            policy.thread_id.to_string().as_bytes(),
+        );
+        let tools = if policy.namespace_tools {
+            create_tools_json_for_responses_lite(&prompt.tools)?
+        } else {
+            create_tools_json_for_responses_api(&prompt.tools)?
+        };
+        let mut prefix = vec![ResponseItem::AdditionalTools {
+            id: Some(ResponseItemId::with_suffix(
+                "at",
+                Uuid::new_v5(&prefix_namespace, &serde_json::to_vec(&tools)?),
+            )),
+            role: "developer".to_string(),
+            tools,
+        }];
+        if !prompt.base_instructions.text.is_empty() {
+            let mut instructions = ContextualUserFragment::into(BaseInstructionsFragment(
+                prompt.base_instructions.text.clone(),
+            ));
+            instructions.set_id(Some(ResponseItemId::with_suffix(
+                "msg",
+                Uuid::new_v5(&prefix_namespace, prompt.base_instructions.text.as_bytes()),
+            )));
+            prefix.push(instructions);
+        }
+        input.splice(0..0, prefix);
+        (String::new(), None)
+    } else {
+        (
+            prompt.base_instructions.text.clone(),
+            Some(create_tools_raw_json_for_responses_api(&prompt.tools)?.into()),
+        )
+    };
+    if !is_openai {
+        for item in &mut input {
+            item.clear_internal_chat_message_metadata_passthrough();
+            if let ResponseItem::FunctionCall {
+                encrypted_function_args,
+                ..
+            } = item
+            {
+                *encrypted_function_args = None;
+            }
+        }
+    }
+    let reasoning = build_reasoning(model_info, effort, summary);
+    let stream_options =
+        (policy.concurrent_reasoning_summaries_enabled && is_openai && reasoning.summary.is_some())
+            .then_some(StreamOptions {
+                reasoning_summary_delivery: codex_api::ReasoningSummaryDelivery::SequentialCutoff,
+            });
+    let include = vec!["reasoning.encrypted_content".to_string()];
+    let ignored_verbosity = !model_info.support_verbosity && policy.model_verbosity.is_some();
+    let verbosity = if model_info.support_verbosity {
+        policy.model_verbosity.or(model_info.default_verbosity)
+    } else {
+        None
+    };
+    let text = create_text_param_for_request(
+        verbosity,
+        &prompt.output_schema,
+        prompt.output_schema_strict,
+    );
+    let prompt_cache_key = Some(policy.prompt_cache_key.clone());
+    let service_tier = if policy.is_bedrock {
+        // Bedrock only supports the implicit default tier, including with custom catalogs.
+        None
+    } else {
+        model_info.service_tier_for_request(service_tier)
+    };
+    if !include_internal {
+        for item in &mut input {
+            item.clear_tool_result_metadata();
+        }
+    }
+    let client_metadata = responses_metadata.client_metadata(include_internal);
+    let request = ResponsesApiRequest {
+        model: model_info.slug.clone(),
+        instructions,
+        input,
+        tools,
+        tool_choice: "auto".to_string(),
+        parallel_tool_calls: prompt.parallel_tool_calls && !model_info.use_responses_lite,
+        reasoning: Some(reasoning),
+        store: false,
+        stream: true,
+        max_output_tokens: None,
+        truncation: None,
+        stream_options,
+        include,
+        service_tier,
+        prompt_cache_key,
+        text,
+        client_metadata: Some(client_metadata),
+        access_programs: None,
+    };
+    Ok(BuiltResponsesRequest {
+        request,
+        ignored_verbosity,
+    })
+}
+
+pub(super) fn prepare_response_items(input: &mut [ResponseItem], content_item_kinds_enabled: bool) {
+    for item in input {
+        if item.id().is_some_and(|id| !id.is_prefixed()) {
+            item.set_id(None);
+        }
+        if !content_item_kinds_enabled {
+            item.clear_content_item_kinds();
+        }
+    }
+}
+
+pub(super) fn apply_guardian_metadata(
+    metadata: &mut Option<HashMap<String, String>>,
+    parent: Option<&str>,
+    reviewer: bool,
+    credits_requested: bool,
+) {
+    if let Some(metadata) = metadata.as_mut() {
+        metadata.remove("guardian_credits_requested");
+        metadata.remove("parent_response_id");
+    }
+    if reviewer {
+        if let Some(parent) = parent {
+            metadata
+                .get_or_insert_with(HashMap::new)
+                .insert("parent_response_id".to_string(), parent.to_string());
+        }
+    } else if credits_requested {
+        metadata
+            .get_or_insert_with(HashMap::new)
+            .insert("guardian_credits_requested".to_string(), "true".to_string());
+    }
+}
+
+pub(super) fn apply_guardian_tier(request: &mut ResponsesApiRequest, reviewer: bool) {
+    if reviewer {
+        request.service_tier = None;
+    }
+}
+
+pub(super) fn initial_headers(beta: Option<&str>, sticky_turn_state: Option<&str>) -> HeaderMap {
+    let mut headers = HeaderMap::new();
+    if let Some(value) = beta
+        .filter(|value| !value.is_empty())
+        .and_then(|value| HeaderValue::from_str(value).ok())
+    {
+        headers.insert("x-codex-beta-features", value);
+    }
+    if let Some(value) = sticky_turn_state.and_then(|value| HeaderValue::from_str(value).ok()) {
+        headers.insert(super::X_CODEX_TURN_STATE_HEADER, value);
+    }
+    headers
+}
+
+pub(super) fn extend_headers(target: &mut HeaderMap, additions: HeaderMap) {
+    target.extend(additions);
+}
+
+pub(super) fn finish_options_headers(
+    headers: &mut HeaderMap,
+    attestation: Option<HeaderValue>,
+    use_lite: bool,
+) {
+    if let Some(value) = attestation {
+        headers.insert(super::X_OAI_ATTESTATION_HEADER, value);
+    }
+    if use_lite {
+        headers.insert(
+            super::X_OPENAI_INTERNAL_CODEX_RESPONSES_LITE_HEADER,
+            HeaderValue::from_static("true"),
+        );
+    }
+}
+
+pub(super) fn apply_routing_header(headers: &mut HeaderMap, routing: Option<HeaderValue>) {
+    if let Some(value) = routing {
+        headers.insert(super::X_CODEX_ROUTING_HINT_HEADER, value);
+    }
+}
+
+// These are completeness/shape facts supplied by an internal owner, not proof authority.
+// Unknown and known absence differ. Required values cannot be omitted by this helper.
+#[allow(
+    dead_code,
+    reason = "Private B staging interface; no platform bridge is registered"
+)]
+pub(super) enum Resolved<T> {
+    Unresolved,
+    Value(T),
+}
+impl<T> Resolved<T> {
+    fn take(self) -> std::result::Result<T, ApiError> {
+        match self {
+            Self::Value(value) => Ok(value),
+            Self::Unresolved => Err(unavailable()),
+        }
+    }
+}
+
+#[allow(
+    dead_code,
+    reason = "Private B staging interface; no platform bridge is registered"
+)]
+pub(super) enum Requirement {
+    Required,
+    NotRequired,
+}
+#[allow(
+    dead_code,
+    reason = "Private B staging interface; no platform bridge is registered"
+)]
+pub(super) enum GuardianCredits {
+    Requested,
+    NotRequested,
+}
+
+#[allow(
+    dead_code,
+    reason = "Private B staging interface; no platform bridge is registered"
+)]
+pub(super) struct ControlledHttpFacts {
+    // Actual Responses cache-affinity header; logical identity remains in metadata.
+    pub responses_session_id: String,
+    pub thread_id: String,
+    pub session_source: SessionSource,
+    pub beta: Resolved<Option<String>>,
+    pub sticky_turn_state: Resolved<Option<String>>,
+    // Stock add_originator_header reads a process-global default. The controlled
+    // path needs its actual resolved explicit HeaderValue, even for that default.
+    pub originator: Resolved<HeaderValue>,
+    pub compatibility_headers: Resolved<HeaderMap>,
+    pub attestation_requirement: Requirement,
+    pub attestation: Resolved<Option<HeaderValue>>,
+    pub guardian_credits: Resolved<GuardianCredits>,
+    pub access_programs: Resolved<Option<AccessPrograms>>,
+    pub routing_hint: Resolved<Option<HeaderValue>>,
+    pub responses_headers: Resolved<HeaderMap>,
+    pub content_item_kinds_enabled: bool,
+    pub expected_contributors: usize,
+    pub contributions: Resolved<Vec<BTreeMap<String, String>>>,
+    pub trace_requirement: Requirement,
+    pub trace_header: Resolved<Option<HeaderValue>>,
+}
+
+fn unavailable() -> ApiError {
+    ApiError::InvalidRequest {
+        message: "CODEX_FROZEN_REQUEST_UNSUPPORTED".to_string(),
+    }
+}
+
+fn matches_header(headers: &HeaderMap, name: &str, expected: Option<&HeaderValue>) -> bool {
+    let mut actual = headers.get_all(name).iter();
+    actual.next() == expected && actual.next().is_none()
+}
+
+/// Local-only composition of real core construction and AC01's one-time encoding.
+/// The owner must supply genuine frozen selection/config/header/contribution facts.
+/// Mechanical validation below does not authenticate them or produce InputProof.
+/// FinalAuth, durable ledger, profile/resource/DNS qualification and bridge are absent.
+#[allow(
+    dead_code,
+    clippy::too_many_arguments,
+    reason = "Private B staging interface; no platform bridge is registered"
+)]
+pub(super) fn prepare_controlled_core_request(
+    prompt: &Prompt,
+    model_info: &ModelInfo,
+    effort: Option<ReasoningEffortConfig>,
+    summary: ReasoningSummaryConfig,
+    service_tier: Option<String>,
+    metadata: &CodexResponsesMetadata,
+    include_internal: bool,
+    policy: &ResolvedBodyPolicy,
+    provider: &Provider,
+    facts: ControlledHttpFacts,
+    maximum: NonZeroU64,
+) -> std::result::Result<Request, ApiError> {
+    let beta = facts.beta.take()?;
+    let sticky = facts.sticky_turn_state.take()?;
+    let originator = facts.originator.take()?;
+    let compatibility = facts.compatibility_headers.take()?;
+    let attestation = facts.attestation.take()?;
+    let credits = facts.guardian_credits.take()?;
+    let access = facts.access_programs.take()?;
+    let routing = facts.routing_hint.take()?;
+    let response_headers = facts.responses_headers.take()?;
+    let contributions = facts.contributions.take()?;
+    let trace = facts.trace_header.take()?;
+    // Match the existing ModelClient::responses_session_id rule using only
+    // immutable resolved values, without reading the live client or its globals.
+    let expected_responses_session_id = if facts.session_source.is_non_root_agent() {
+        metadata.session_id.as_str()
+    } else {
+        policy.prompt_cache_key.as_str()
+    };
+    if (matches!(facts.attestation_requirement, Requirement::Required) && attestation.is_none())
+        || (matches!(facts.trace_requirement, Requirement::Required) && trace.is_none())
+        || contributions.len() != facts.expected_contributors
+        || facts.thread_id != metadata.thread_id
+        || facts.thread_id != policy.thread_id.to_string()
+        || facts.responses_session_id != expected_responses_session_id
+    {
+        return Err(unavailable());
+    }
+    if facts.responses_session_id.is_empty()
+        || facts.thread_id.is_empty()
+        || HeaderValue::from_str(&facts.responses_session_id).is_err()
+        || HeaderValue::from_str(&facts.thread_id).is_err()
+        || beta
+            .as_ref()
+            .is_some_and(|value| value.is_empty() || HeaderValue::from_str(value).is_err())
+        || sticky
+            .as_ref()
+            .is_some_and(|value| HeaderValue::from_str(value).is_err())
+    {
+        return Err(unavailable());
+    }
+    let reviewer = super::is_guardian_reviewer(&response_headers);
+    if reviewer && matches!(credits, GuardianCredits::Requested) {
+        return Err(unavailable());
+    }
+    let BuiltResponsesRequest { mut request, .. } = build_responses_request_from_resolved(
+        prompt,
+        model_info,
+        effort,
+        summary,
+        service_tier,
+        metadata,
+        include_internal,
+        policy,
+    )
+    .map_err(|_| unavailable())?;
+    // Limits must precede the final actual-envelope optional-metadata calculation.
+    request.max_output_tokens = Some(maximum);
+    request.truncation = Some(ResponsesTruncation::Disabled);
+    let mut headers = initial_headers(beta.as_deref(), sticky.as_deref());
+    headers.insert("originator", originator.clone());
+    extend_headers(&mut headers, compatibility);
+    finish_options_headers(
+        &mut headers,
+        attestation.clone(),
+        model_info.use_responses_lite,
+    );
+    apply_guardian_metadata(
+        &mut request.client_metadata,
+        metadata.parent_response_id.as_deref(),
+        reviewer,
+        matches!(credits, GuardianCredits::Requested),
+    );
+    apply_guardian_tier(&mut request, reviewer);
+    apply_routing_header(&mut headers, routing);
+    request.access_programs = access;
+    prepare_response_items(&mut request.input, facts.content_item_kinds_enabled);
+    extend_headers(&mut headers, response_headers);
+    for additions in contributions {
+        crate::model_request::merge_resolved_metadata(&mut request.client_metadata, additions);
+    }
+    if let Some(trace) = trace.as_ref() {
+        headers.insert("x-codex-inference-call-id", trace.clone());
+    }
+    // Check the exact local header merge before the only API payload encoding.
+    // Known absence is not interchangeable with an unexamined provider default.
+    let mut final_headers = provider.headers.clone();
+    extend_headers(&mut final_headers, headers.clone());
+    if !matches_header(&final_headers, "originator", Some(&originator))
+        || !matches_header(
+            &final_headers,
+            super::X_OAI_ATTESTATION_HEADER,
+            attestation.as_ref(),
+        )
+        || !matches_header(&final_headers, "x-codex-inference-call-id", trace.as_ref())
+    {
+        return Err(unavailable());
+    }
+    if let Some(bound) = tool_metadata::calculate_bounded_input(&request, &request.input) {
+        request.input = bound.input;
+    }
+    let options = ResponsesOptions {
+        session_id: Some(facts.responses_session_id),
+        thread_id: Some(facts.thread_id),
+        session_source: Some(facts.session_source),
+        extra_headers: headers,
+        compression: codex_api::Compression::None,
+        turn_state: None,
+    };
+    codex_api::prepare_controlled_responses_request(provider, request, &options, maximum)
+}
+
+/// Explicitly resolved auth mode for this limited local finalization mechanism.
+/// This value is a completeness fact, not trusted owner authority or InputProof.
+#[derive(Clone, Copy, Debug)]
+#[allow(
+    dead_code,
+    reason = "Private FinalAuth staging; no production bridge is registered"
+)]
+pub(super) enum ControlledAuthMode {
+    StaticApiKeyBearer,
+    ChatGpt,
+    RequestSigning,
+    Refreshing,
+}
+
+/// Install final static bearer auth before freezing the actual encoded Request.
+/// The same qualified owner must resolve all auth-dependent B03 facts first.
+/// This helper does no auth refresh, transport, callback, encoding or I/O; its
+/// output is only frozen material and an Arc-local one-use capability. Actual
+/// config/secret versions, ledger and InputProof remain the trusted owner's job.
+/// A controlled sender must use HTTP04's for_frozen_responses_request route,
+/// never ordinary EndpointSession/AuthProvider/retry after this boundary.
+#[allow(
+    dead_code,
+    reason = "Private bearer mechanism; the trusted owner bridge is absent"
+)]
+pub(super) fn finalize_controlled_bearer_request(
+    mut request: Request,
+    mode: Resolved<ControlledAuthMode>,
+    mut bearer: HeaderValue,
+    maximum: NonZeroU64,
+) -> std::result::Result<std::sync::Arc<codex_http_client::FrozenResponsesRequest>, ApiError> {
+    if !matches!(mode.take()?, ControlledAuthMode::StaticApiKeyBearer)
+        || request.headers.contains_key(http::header::AUTHORIZATION)
+        || request
+            .headers
+            .contains_key(http::header::PROXY_AUTHORIZATION)
+        || request.headers.contains_key(http::header::COOKIE)
+        || !matches!(
+            request.body.as_ref(),
+            Some(codex_client::RequestBody::EncodedJson(_))
+        )
+    {
+        return Err(unavailable());
+    }
+    // Accept only a single canonical RFC6750 bearer value. Never normalize,
+    // print, hash publicly, refresh or reconstruct the credential here.
+    let token = bearer
+        .to_str()
+        .ok()
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .ok_or_else(unavailable)?;
+    let mut parts = token.splitn(/*n*/ 2, '=');
+    let value = parts.next().ok_or_else(unavailable)?;
+    if value.is_empty()
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"-._~+/".contains(&byte))
+        || parts
+            .next()
+            .is_some_and(|padding| !padding.bytes().all(|byte| byte == b'='))
+    {
+        return Err(unavailable());
+    }
+    bearer.set_sensitive(/*val*/ true);
+    request.headers.insert(http::header::AUTHORIZATION, bearer);
+    codex_http_client::FrozenResponsesRequest::freeze(request, maximum)
+        .map(std::sync::Arc::new)
+        .map_err(|_| unavailable())
+}
