+    /// Build the restricted real HTTP sender for one already frozen request.
+    ///
+    /// Clones and newly constructed senders must share the same capability.
+    /// This does not bind AppServer's other transports or persist platform consent.
+    pub fn for_frozen_responses_request(
+        frozen: Arc<FrozenResponsesRequest>,
+    ) -> Result<Self, TransportError> {
+        let client = reqwest::Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .retry(reqwest::retry::never())
+            .http1_only()
+            .pool_max_idle_per_host(0)
+            .no_gzip()
+            .no_brotli()
+            .no_zstd()
+            .no_deflate()
+            .build()
+            .map_err(|error| TransportError::Build(error.without_url().to_string()))?;
+        Ok(Self {
+            client: TransportClient::Fixed(HttpClient::new_without_request_logging(client)),
+            frozen_responses_request: Some(frozen),
+        })
     }

