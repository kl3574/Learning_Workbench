+/// Encode an already complete typed request once, with no auth or transport I/O.
+///
+/// Core request construction and its later metadata/input mutations must finish
+/// before this function. It does not instantiate a client, read credentials,
+/// refresh auth, run contributors, spawn tasks, or prove model/token capacity.
+/// The returned original EncodedJson allocation must be retained by the owner.
+pub fn prepare_responses_request(
+    provider: &Provider,
+    request: &ResponsesApiRequest,
+    options: &ResponsesOptions,
+) -> Result<Request, ApiError> {
+    let body = EncodedJsonBody::encode(request).map_err(|error| {
+        ApiError::Stream(format!("failed to encode responses request: {error}"))
+    })?;
+    let mut headers = options.extra_headers.clone();
+    if let Some(ref thread_id) = options.thread_id {
+        insert_header(&mut headers, "x-client-request-id", thread_id);
+    }
+    headers.extend(build_session_headers(
+        options.session_id.clone(),
+        options.thread_id.clone(),
+    ));
+    if let Some(subagent) = subagent_header(&options.session_source) {
+        insert_header(&mut headers, "x-openai-subagent", &subagent);
+    }
+    prepare_encoded_json_request(
+        provider,
+        Method::POST,
+        "/responses",
+        headers,
+        Some(body),
+        |request| configure_responses_request(request, options.compression),
+    )
+    .map_err(ApiError::from)
+}
+
+/// Set the explicit HTTP output limits before the shared one-time encoding.
+///
+/// This is local preparation only. The owner must finish trusted auth headers,
+/// check the retained body is unchanged, freeze that final request, and use the
+/// dedicated transport without the ordinary auth/retry execution wrapper.
+pub fn prepare_controlled_responses_request(
+    provider: &Provider,
+    mut request: ResponsesApiRequest,
+    options: &ResponsesOptions,
+    max_output_tokens: NonZeroU64,
+) -> Result<Request, ApiError> {
+    if options.compression != Compression::None
+        || request
+            .max_output_tokens
+            .is_some_and(|existing| existing != max_output_tokens)
+    {
+        return Err(ApiError::InvalidRequest {
+            message: "CODEX_OUTPUT_LIMIT_UNAVAILABLE".to_string(),
+        });
+    }
+    request.max_output_tokens = Some(max_output_tokens);
+    request.truncation = Some(ResponsesTruncation::Disabled);
+    prepare_responses_request(provider, &request, options)
+}
+
+fn configure_responses_request(request: &mut Request, compression: Compression) {
+    request.headers.insert(
+        http::header::ACCEPT,
+        HeaderValue::from_static("text/event-stream"),
+    );
+    request.compression = match compression {
+        Compression::None => RequestCompression::None,
+        Compression::Zstd => RequestCompression::Zstd,
+    };
 }

