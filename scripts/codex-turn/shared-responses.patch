@@ -0,0 +1,346 @@
+use super::*;
+use crate::EncodedJsonBody;
+use crate::HttpTransport;
+use crate::ReqwestTransport;
+use crate::TransportError;
+use pretty_assertions::assert_eq;
+use serde::Serialize;
+use serde::ser::SerializeMap;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::Barrier;
+use std::time::Duration;
+
+fn output_limit() -> NonZeroU64 {
+    NonZeroU64::new(64).expect("positive output limit")
+}
+
+fn encoded_request(body: &impl Serialize) -> Request {
+    let mut request = Request::new(
+        Method::POST,
+        "https://example.test/v1/responses".to_string(),
+    );
+    request.headers.insert(
+        http::header::ACCEPT,
+        http::HeaderValue::from_static("text/event-stream"),
+    );
+    request.body = Some(RequestBody::EncodedJson(
+        EncodedJsonBody::encode(body).expect("actual serializer should encode"),
+    ));
+    request
+}
+
+fn frozen_request() -> FrozenResponsesRequest {
+    FrozenResponsesRequest::freeze(
+        encoded_request(&json!({
+            "model": "test-model",
+            "input": [{"role": "user", "content": "bounded input"}],
+            "max_output_tokens": 64,
+            "truncation": "disabled"
+        })),
+        output_limit(),
+    )
+    .expect("real encoded request should freeze")
+}
+
+fn built_request(frozen: &FrozenResponsesRequest) -> reqwest::Request {
+    let request = frozen.prepared_request();
+    let prepared = request.prepare_body_for_send().expect("already prepared");
+    let mut built = reqwest::Request::new(request.method, request.url.parse().expect("valid URL"));
+    *built.headers_mut() = prepared.headers;
+    *built.body_mut() = prepared.body.map(Into::into);
+    *built.timeout_mut() = request.timeout;
+    built
+}
+
+#[test]
+fn frozen_responses_request_preserves_the_actual_encoded_allocation() {
+    let request = encoded_request(&json!({"max_output_tokens":64,"truncation":"disabled"}));
+    let original = match request.body.as_ref().expect("encoded body") {
+        RequestBody::EncodedJson(body) => body.as_bytes().as_ptr(),
+        _ => panic!("actual encoded body required"),
+    };
+    let frozen = FrozenResponsesRequest::freeze(request, output_limit()).expect("should freeze");
+    let clone = frozen.prepared_request();
+    let clone_body = clone
+        .prepare_body_for_send()
+        .expect("prepared")
+        .body
+        .expect("body");
+    assert_eq!(frozen.body_bytes().as_ptr(), original);
+    assert_eq!(clone_body.as_ptr(), original);
+    let built = built_request(&frozen);
+    assert_eq!(
+        built
+            .body()
+            .and_then(reqwest::Body::as_bytes)
+            .map(<[u8]>::as_ptr),
+        Some(original)
+    );
+    assert_eq!(
+        frozen.claim(&built, clone.response_body_limit_bytes),
+        Ok(())
+    );
+    assert_eq!(
+        frozen.claim(&built, clone.response_body_limit_bytes),
+        Err(FrozenRequestError::AlreadyClaimed)
+    );
+}
+
+#[test]
+fn frozen_responses_request_rejects_missing_ambiguous_or_changed_output_limits() {
+    for body in [
+        json!({"truncation":"disabled"}),
+        json!({"max_output_tokens":0,"truncation":"disabled"}),
+        json!({"max_output_tokens":65,"truncation":"disabled"}),
+        json!({"max_output_tokens":"64","truncation":"disabled"}),
+        json!({"max_output_tokens":64,"truncation":"auto"}),
+        json!({"max_output_tokens":64}),
+        json!([64, "disabled"]),
+    ] {
+        assert_eq!(
+            FrozenResponsesRequest::freeze(encoded_request(&body), output_limit()).err(),
+            Some(FrozenRequestError::OutputLimit)
+        );
+    }
+}
+
+struct DuplicateNames;
+
+impl Serialize for DuplicateNames {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut map = serializer.serialize_map(Some(2))?;
+        map.serialize_entry("content", "first")?;
+        map.serialize_entry("content", "second")?;
+        map.end()
+    }
+}
+
+#[test]
+fn frozen_responses_request_rejects_duplicate_names_inside_real_serialized_input() {
+    #[derive(Serialize)]
+    struct ActualBody {
+        max_output_tokens: u64,
+        truncation: &'static str,
+        input: [DuplicateNames; 1],
+    }
+    let request = encoded_request(&ActualBody {
+        max_output_tokens: 64,
+        truncation: "disabled",
+        input: [DuplicateNames],
+    });
+    assert_eq!(
+        FrozenResponsesRequest::freeze(request, output_limit()).err(),
+        Some(FrozenRequestError::OutputLimit)
+    );
+}
+
+#[test]
+fn frozen_responses_request_excludes_raw_json_compression_and_unsafe_destination_shapes() {
+    let good = frozen_request().prepared_request();
+    let mut json_body = good.clone();
+    json_body.body = Some(RequestBody::Json(
+        json!({"max_output_tokens":64,"truncation":"disabled"}),
+    ));
+    let mut raw_body = good.clone();
+    raw_body.body = Some(RequestBody::Raw(bytes::Bytes::copy_from_slice(
+        frozen_request().body_bytes(),
+    )));
+    let mut compressed = good.clone();
+    compressed.compression = RequestCompression::Zstd;
+    let mut content_encoding = good.clone();
+    content_encoding.headers.insert(
+        http::header::CONTENT_ENCODING,
+        http::HeaderValue::from_static("zstd"),
+    );
+    let mut requests = vec![json_body, raw_body, compressed, content_encoding];
+    for (header, value) in [
+        (http::header::HOST, "other.invalid"),
+        (http::header::CONTENT_LENGTH, "1"),
+        (http::header::TRANSFER_ENCODING, "gzip"),
+        (http::header::CONTENT_TYPE, "text/plain"),
+    ] {
+        let mut request = good.clone();
+        request.headers.insert(
+            header,
+            http::HeaderValue::from_str(value).expect("valid header"),
+        );
+        requests.push(request);
+    }
+    let mut missing_accept = good.clone();
+    missing_accept.headers.remove(http::header::ACCEPT);
+    requests.push(missing_accept);
+    let mut duplicate_content_type = good.clone();
+    duplicate_content_type.headers.append(
+        http::header::CONTENT_TYPE,
+        http::HeaderValue::from_static("text/plain"),
+    );
+    requests.push(duplicate_content_type);
+    for url in [
+        "http://example.test/v1/responses",
+        "https://user:pass@example.test/v1/responses",
+        "https://example.test/v1/responses?redirect=other",
+        "https://example.test/v1/responses#fragment",
+        "https://example.test/v1/compact",
+    ] {
+        let mut request = good.clone();
+        request.url = url.to_string();
+        requests.push(request);
+    }
+    for request in requests {
+        assert_eq!(
+            FrozenResponsesRequest::freeze(request, output_limit()).err(),
+            Some(FrozenRequestError::Unsupported)
+        );
+    }
+}
