@@ -0,0 +1,235 @@
+//! One-use binding to the existing serializer's exact Responses request bytes.
+//!
+//! This is a transport capability, not an input-token proof or a durable consent.
+//! The owner must freeze after all request/header mutations, share the same `Arc`
+//! across every HTTP attempt, and separately exclude other outbound transports.
+
+use crate::Request;
+use crate::RequestBody;
+use crate::RequestCompression;
+use crate::request::PreparedRequestBody;
+use http::Method;
+use serde::Deserialize;
+use serde::Deserializer;
+use serde::de::MapAccess;
+use serde::de::SeqAccess;
+use serde::de::Visitor;
+use std::collections::HashSet;
+use std::num::NonZeroU64;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use thiserror::Error;
+
+/// An immutable existing request and a shared, non-resettable send capability.
+pub struct FrozenResponsesRequest {
+    request: Request,
+    prepared: PreparedRequestBody,
+    claimed: AtomicBool,
+}
+
+impl std::fmt::Debug for FrozenResponsesRequest {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("FrozenResponsesRequest")
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum FrozenRequestError {
+    #[error("CODEX_FROZEN_REQUEST_UNSUPPORTED")]
+    Unsupported,
+    #[error("CODEX_OUTPUT_LIMIT_UNAVAILABLE")]
+    OutputLimit,
+    #[error("CODEX_FROZEN_REQUEST_CHANGED")]
+    Changed,
+    #[error("CODEX_NEW_OUTBOUND_CONSENT_REQUIRED")]
+    AlreadyClaimed,
+}
+
+// Deserialize only to check limits in the actual encoded body. Never reserialize
+// this view or use it in place of the original request. Serde rejects duplicate
+// occurrences of these known fields rather than choosing one ambiguously.
+#[derive(Deserialize)]
+struct OutputLimits {
+    max_output_tokens: NonZeroU64,
+    truncation: String,
+}
+
+// Reject duplicate names at every object depth before interpreting limits.
+// This parser is validation only; the exact original bytes remain the payload.
+struct UniqueJson;
+
+impl<'de> Deserialize<'de> for UniqueJson {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct UniqueVisitor;
+        impl<'de> Visitor<'de> for UniqueVisitor {
+            type Value = UniqueJson;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str("JSON with unique object names")
+            }
+
+            fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_i64<E: serde::de::Error>(self, _: i64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_str<E: serde::de::Error>(self, _: &str) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_unit<E: serde::de::Error>(self) -> Result<UniqueJson, E> {
+                Ok(UniqueJson)
+            }
+
+            fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<UniqueJson, A::Error> {
+                while seq.next_element::<UniqueJson>()?.is_some() {}
+                Ok(UniqueJson)
+            }
+
+            fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<UniqueJson, A::Error> {
+                let mut names = HashSet::new();
+                while let Some(name) = map.next_key::<String>()? {
+                    if !names.insert(name) {
+                        return Err(serde::de::Error::custom("duplicate JSON name"));
+                    }
+                    map.next_value::<UniqueJson>()?;
+                }
+                Ok(UniqueJson)
+            }
+        }
+        deserializer.deserialize_any(UniqueVisitor)
+    }
+}
+
+impl FrozenResponsesRequest {
+    /// Freeze an already encoded, uncompressed HTTPS Responses POST.
+    ///
+    /// No request field is injected here. In particular the real producer must
+    /// already encode the exact positive output limit and disabled truncation.
+    /// Compression, supplied Host/framing, and URL credentials/query/fragment
+    /// are excluded. Accept must be explicit before freeze, closing reqwest's
+    /// otherwise late default. Content-Type must be exactly application/json.
+    pub fn freeze(
+        request: Request,
+        max_output_tokens: NonZeroU64,
+    ) -> Result<Self, FrozenRequestError> {
+        let url = reqwest::Url::parse(&request.url).map_err(|_| FrozenRequestError::Unsupported)?;
+        if request.method != Method::POST
+            || url.scheme() != "https"
+            || url.host_str().is_none()
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.query().is_some()
+            || url.fragment().is_some()
+            || !url.path().ends_with("/responses")
+            || url.as_str() != request.url
+            || request.compression != RequestCompression::None
+            || request.headers.contains_key(http::header::CONTENT_ENCODING)
+            || request.headers.contains_key(http::header::HOST)
+            || request.headers.contains_key(http::header::CONTENT_LENGTH)
+            || request
+                .headers
+                .contains_key(http::header::TRANSFER_ENCODING)
+            || !request.headers.contains_key(http::header::ACCEPT)
+        {
+            return Err(FrozenRequestError::Unsupported);
+        }
+        let Some(RequestBody::EncodedJson(body)) = request.body.as_ref() else {
+            return Err(FrozenRequestError::Unsupported);
+        };
+        if body
+            .as_bytes()
+            .iter()
+            .find(|byte| !byte.is_ascii_whitespace())
+            != Some(&b'{')
+        {
+            return Err(FrozenRequestError::OutputLimit);
+        }
+        serde_json::from_slice::<UniqueJson>(body.as_bytes())
+            .map_err(|_| FrozenRequestError::OutputLimit)?;
+        let limits: OutputLimits =
+            serde_json::from_slice(body.as_bytes()).map_err(|_| FrozenRequestError::OutputLimit)?;
+        if limits.max_output_tokens != max_output_tokens || limits.truncation != "disabled" {
+            return Err(FrozenRequestError::OutputLimit);
+        }
+        let request = request
+            .into_prepared()
+            .map_err(|_| FrozenRequestError::Unsupported)?;
+        let prepared = request
+            .prepare_body_for_send()
+            .map_err(|_| FrozenRequestError::Unsupported)?;
+        if prepared
+            .headers
+            .get_all(http::header::CONTENT_TYPE)
+            .iter()
+            .count()
+            != 1
+            || prepared
+                .headers
+                .get(http::header::CONTENT_TYPE)
+                .and_then(|value| value.to_str().ok())
+                != Some("application/json")
+        {
+            return Err(FrozenRequestError::Unsupported);
+        }
+        Ok(Self {
+            request,
+            prepared,
+            claimed: AtomicBool::new(false),
+        })
+    }
+
+    /// Clone the real prepared request; its encoded body shares the frozen bytes.
+    pub fn prepared_request(&self) -> Request {
+        self.request.clone()
+    }
+
+    /// Borrow the original final wire body for a separate reviewed input proof.
+    pub fn body_bytes(&self) -> &[u8] {
+        self.prepared.body.as_deref().unwrap_or_default()
+    }
+
+    pub(crate) fn claim(
+        &self,
+        request: &reqwest::Request,
+        response_body_limit_bytes: Option<usize>,
+    ) -> Result<(), FrozenRequestError> {
+        // Claim before any network action, and burn even a mismatched attempt.
+        // A build/connection/HTTP/stream failure never restores this capability.
+        self.claimed
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| FrozenRequestError::AlreadyClaimed)?;
+        if request.method() != &self.request.method
+            || request.url().as_str() != self.request.url
+            || request.headers() != &self.prepared.headers
+            || request.timeout().copied() != self.request.timeout
+            || response_body_limit_bytes != self.request.response_body_limit_bytes
+            || request.body().and_then(reqwest::Body::as_bytes) != Some(self.body_bytes())
+            || request
+                .body()
+                .and_then(reqwest::Body::as_bytes)
+                .map(<[u8]>::as_ptr)
+                != Some(self.body_bytes().as_ptr())
+        {
+            return Err(FrozenRequestError::Changed);
+        }
+        Ok(())
+    }
+}
+
