+#[derive(Debug)]
+struct UnobservedGetter {
+    inner: super::super::StaticModelsManager,
+    calls: std::sync::atomic::AtomicUsize,
+}
+
+impl ModelsManager for UnobservedGetter {
+    fn raw_model_catalog(
+        &self,
+        strategy: super::super::RefreshStrategy,
+        factory: HttpClientFactory,
+    ) -> super::super::ModelsManagerFuture<'_, codex_protocol::openai_models::ModelsResponse> {
+        self.inner.raw_model_catalog(strategy, factory)
+    }
+    fn get_remote_models(&self) -> super::super::ModelsManagerFuture<'_, Vec<ModelInfo>> {
+        self.inner.get_remote_models()
+    }
+    fn try_get_remote_models(&self) -> Result<Vec<ModelInfo>, tokio::sync::TryLockError> {
+        self.inner.try_get_remote_models()
+    }
+    fn auth_manager(&self) -> Option<&codex_login::AuthManager> {
+        None
+    }
+    fn list_collaboration_modes(&self) -> Vec<codex_protocol::config_types::CollaborationModeMask> {
+        self.inner.list_collaboration_modes()
+    }
+    fn get_model_info<'a>(
+        &'a self,
+        model: &'a str,
+        config: &'a ModelsManagerConfig,
+    ) -> super::super::ModelsManagerFuture<'a, ModelInfo> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        self.inner.get_model_info(model, config)
+    }
+    fn refresh_if_new_etag(
+        &self,
+        etag: String,
+        factory: HttpClientFactory,
+    ) -> super::super::ModelsManagerFuture<'_, ()> {
+        self.inner.refresh_if_new_etag(etag, factory)
+    }
+}
+
+#[tokio::test]
+async fn default_retained_trait_calls_the_original_getter_once_without_fabricating_record() {
+    let manager = UnobservedGetter {
+        inner: super::super::StaticModelsManager::new(
+            /*auth_manager*/ None,
+            codex_protocol::openai_models::ModelsResponse {
+                models: vec![fixture_model("gpt-5", "owned static catalog")],
+            },
+        ),
+        calls: std::sync::atomic::AtomicUsize::new(0),
+    };
+    let selected = manager
+        .get_model_info_with_resolution("gpt-5", &Default::default())
+        .await;
+    assert_eq!(manager.calls.load(Ordering::SeqCst), 1);
+    assert!(selected.resolution().is_none());
+    assert!(!selected.matches_model_info(selected.model_info()));
+    assert!(!selected.matches_request("gpt-5", /*personality*/ None));
+}
