+#[tokio::test]
+async fn model_and_personality_updates_select_new_pairs_without_replacing_old_step() {
+    let (session, step, _home) = fixture().await;
+    let original = step
+        .settings
+        .retained_model_resolution()
+        .expect("original pair");
+    let requirements = codex_config::ConfigRequirements::default();
+    let constraints = crate::session::step_settings::StepSettingsConstraints {
+        requirements: &requirements,
+        guardian_approval_enabled: false,
+        trusted_guardian_reviewer: false,
+        has_full_disk_write_access: true,
+    };
+    let overrides = crate::session::step_settings::ModelInfoOverrides::from(
+        step.turn.config.to_models_manager_config(),
+    );
+    let personality = if step.settings.personality()
+        == Some(codex_protocol::config_types::Personality::Friendly)
+    {
+        codex_protocol::config_types::Personality::None
+    } else {
+        codex_protocol::config_types::Personality::Friendly
+    };
+    for update in [
+        crate::session::step_settings::StepSettingsUpdate {
+            model: Some("owned-new-model-not-requested".to_string()),
+            ..Default::default()
+        },
+        crate::session::step_settings::StepSettingsUpdate {
+            personality: Some(personality),
+            ..Default::default()
+        },
+    ] {
+        let next = step
+            .settings
+            .apply_update(
+                &update,
+                &constraints,
+                session.services.models_manager.as_ref(),
+                &overrides,
+                /*fast_mode_enabled*/ false,
+            )
+            .await
+            .expect("owned settings update");
+        assert!(!Arc::ptr_eq(&next.model_info, &step.settings.model_info));
+        assert!(!Arc::ptr_eq(
+            next.retained_model_resolution()
+                .expect("new owning selection"),
+            original
+        ));
+        assert_eq!(
+            next.retained_model_resolution()
+                .expect("new record")
+                .authoritative_model_version(),
+            None
+        );
+        assert!(Arc::ptr_eq(
+            step.settings
+                .retained_model_resolution()
+                .expect("unchanged original"),
+            original
+        ));
+    }
+}
