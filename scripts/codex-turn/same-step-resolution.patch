+//! Owned mechanical catalog fixtures; none supplies vendor or current-Step authority.
+use super::*;
+use crate::cache::ModelsCacheEntry;
+use crate::manager::ModelsEndpointClient;
+use crate::manager::ModelsEndpointFuture;
+use crate::manager::ModelsEndpointResponse;
+use crate::manager::ModelsManager;
+use codex_http_client::HttpClientFactory;
+use codex_protocol::error::Result as CoreResult;
+use codex_protocol::openai_models::ModelsResponse;
+use codex_protocol::openai_models::TruncationPolicyConfig;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use tokio::sync::Mutex;
+use tokio::sync::RwLock;
+
+#[derive(Debug)]
+struct InertEndpoint;
+
+impl ModelsEndpointClient for InertEndpoint {
+    fn identity(&self) -> Option<String> {
+        Some("owned-fixture-provider".to_string())
+    }
+
+    fn has_command_auth(&self) -> bool {
+        panic!("resolution must not inspect command auth")
+    }
+
+    fn uses_codex_backend(&self) -> ModelsEndpointFuture<'_, bool> {
+        panic!("resolution must not resolve backend auth")
+    }
+
+    fn list_models<'a>(
+        &'a self,
+        _client_version: &'a str,
+        _http_client_factory: HttpClientFactory,
+    ) -> ModelsEndpointFuture<'a, CoreResult<ModelsEndpointResponse>> {
+        panic!("resolution must not refresh the catalog")
+    }
+}
+
+fn fixture_model(slug: &str, display: &str) -> ModelInfo {
+    serde_json::from_value(json!({
+        "slug": slug, "display_name": display, "description": "owned test fixture",
+        "default_reasoning_level": "medium", "supported_reasoning_levels": [],
+        "shell_type": "shell_command", "visibility": "list", "supported_in_api": true,
+        "priority": 0, "upgrade": null, "availability_nux": null,
+        "model_messages": {"instructions_template": "original", "instructions_variables": null},
+        "support_verbosity": false, "default_verbosity": null, "apply_patch_tool_type": null,
+        "truncation_policy": {"mode": "bytes", "limit": 10000},
+        "context_window": 2000, "max_context_window": 4000, "experimental_supported_tools": []
+    }))
+    .expect("valid owned ModelInfo fixture")
+}
+
+fn fixture_manager(models: Vec<ModelInfo>, catalog_source: CatalogSource) -> OpenAiModelsManager {
+    OpenAiModelsManager {
+        remote_models: RwLock::new(ModelsCacheEntry {
+            fetched_at: DateTime::<Utc>::MIN_UTC,
+            etag: Some("owned-fixture-etag".to_string()),
+            client_version: Some("owned-fixture-client-version".to_string()),
+            identity: Some("owned-fixture-provider".to_string()),
+            models,
+        }),
+        cache: None,
+        endpoint_client: Arc::new(InertEndpoint),
+        catalog_source,
+        api_key_model_discovery_enabled: AtomicBool::new(/*v*/ false),
+        auth_manager: None,
+    }
+}
+
+async fn compare_ordinary(
+    manager: &OpenAiModelsManager,
+    model: &str,
+    config: &ModelsManagerConfig,
+) -> RetainedModelResolution {
+    let ordinary = manager.get_model_info(model, config).await;
+    let retained = manager
+        .get_model_info_with_retained_resolution(model, config)
+        .await;
+    assert_eq!(retained.resolved_model(), &ordinary);
+    assert_eq!(retained.requested_model(), model);
+    assert_eq!(retained.authoritative_model_version(), None);
+    assert_eq!(
+        retained.qualification(),
+        ResolutionQualification::Unqualified
+    );
+    retained
+}
+
+#[tokio::test]
+async fn retains_longest_prefix_first_tie_and_raw_fallback_marker_before_rewrite() {
+    let short = fixture_model("gpt", "short");
+    let mut first = fixture_model("gpt-next", "first tie");
+    first.used_fallback_model_metadata = true;
+    let second = fixture_model("gpt-next", "second tie");
+    let manager = fixture_manager(vec![short, first.clone(), second], CatalogSource::Default);
+    let retained = compare_ordinary(&manager, "gpt-next-trial", &Default::default()).await;
+
+    assert_eq!(retained.match_rule(), ModelMatchRule::LongestPrefix);
+    assert_eq!(retained.original_catalog_model(), Some(&first));
+    let mut rewritten = first.clone();
+    rewritten.slug = "gpt-next-trial".to_string();
+    rewritten.used_fallback_model_metadata = false;
+    assert_eq!(retained.before_overrides(), &rewritten);
+    manager.remote_models.write().await.models.clear();
+    assert_eq!(retained.original_catalog_model(), Some(&first));
+    assert_eq!(retained.before_overrides(), &rewritten);
+}
+
+#[tokio::test]
+async fn namespaced_suffix_preserves_validation_and_whole_getter_results() {
+    let original = fixture_model("gpt", "suffix match");
+    let manager = fixture_manager(vec![original.clone()], CatalogSource::Default);
+    for requested in ["custom/gpt-trial", "custom-provider_2/gpt-trial"] {
+        let retained = compare_ordinary(&manager, requested, &Default::default()).await;
+        assert_eq!(retained.match_rule(), ModelMatchRule::NamespacedSuffix);
+        assert_eq!(retained.original_catalog_model(), Some(&original));
+    }
+    for requested in ["ns1/ns2/gpt", "/gpt", "bad.namespace/gpt", "space ns/gpt"] {
+        let retained = compare_ordinary(&manager, requested, &Default::default()).await;
+        assert_eq!(retained.match_rule(), ModelMatchRule::UnmatchedFallback);
+        assert_eq!(retained.original_catalog_model(), None);
+        assert!(retained.before_overrides().used_fallback_model_metadata);
+    }
+}
+
+#[tokio::test]
+async fn direct_prefix_remains_prior_to_namespaced_suffix() {
+    let direct = fixture_model("custom", "direct prefix");
+    let suffix = fixture_model("gpt", "suffix");
+    let manager = fixture_manager(vec![suffix, direct.clone()], CatalogSource::Default);
+    let retained = compare_ordinary(&manager, "custom/gpt-trial", &Default::default()).await;
+    assert_eq!(retained.match_rule(), ModelMatchRule::LongestPrefix);
+    assert_eq!(retained.original_catalog_model(), Some(&direct));
+}
+
+#[tokio::test]
+async fn explicit_provider_keeps_exact_matching_instead_of_prefix_or_namespace() {
+    let original = fixture_model("gpt", "exact only");
+    let manager = fixture_manager(
+        vec![original.clone()],
+        CatalogSource::ExplicitProvider(Mutex::new(())),
+    );
+    let retained = compare_ordinary(&manager, "gpt", &Default::default()).await;
+    assert_eq!(retained.match_rule(), ModelMatchRule::ExplicitProviderExact);
+    assert_eq!(retained.original_catalog_model(), Some(&original));
+    for requested in ["gpt-trial", "custom/gpt"] {
+        let retained = compare_ordinary(&manager, requested, &Default::default()).await;
+        assert_eq!(retained.match_rule(), ModelMatchRule::UnmatchedFallback);
+        assert_eq!(retained.original_catalog_model(), None);
+        assert!(retained.resolved_model().used_fallback_model_metadata);
+    }
+}
+
+#[tokio::test]
+async fn overrides_preserve_complete_original_and_pre_override_model_info() {
+    let original = fixture_model("gpt", "before overrides");
+    let manager = fixture_manager(vec![original.clone()], CatalogSource::Default);
+    let config = ModelsManagerConfig {
+        model_context_window: Some(9000),
+        model_auto_compact_token_limit: Some(1234),
+        tool_output_token_limit: Some(11),
+        base_instructions: Some("replacement instructions".to_string()),
+        model_catalog: Some(ModelsResponse {
+            models: vec![fixture_model(
+                "gpt",
+                "caller catalog is not this lookup source",
+            )],
+        }),
+        ..Default::default()
+    };
+    let retained = compare_ordinary(&manager, "gpt-trial", &config).await;
+    assert_eq!(retained.original_catalog_model(), Some(&original));
+    let mut before = original;
+    before.slug = "gpt-trial".to_string();
+    assert_eq!(retained.before_overrides(), &before);
+    let mut expected = before;
+    expected.context_window = Some(4000);
+    expected.auto_compact_token_limit = Some(1234);
+    expected.truncation_policy = TruncationPolicyConfig::bytes(/*limit*/ 44);
+    expected
+        .model_messages
+        .as_mut()
+        .expect("fixture messages")
+        .instructions_template = Some("replacement instructions".to_string());
+    assert_eq!(retained.resolved_model(), &expected);
+    assert_eq!(
+        retained.catalog().origin(),
+        CatalogOrigin::IdentityMatchedMemoryEntry
+    );
+    assert_eq!(retained.catalog().entry_etag(), Some("owned-fixture-etag"));
+    assert_eq!(
+        retained.catalog().entry_client_version(),
+        Some("owned-fixture-client-version")
+    );
+    assert_eq!(
+        retained.catalog().entry_fetched_at(),
+        Some(&DateTime::<Utc>::MIN_UTC)
+    );
+}
+
+#[tokio::test]
+async fn mismatched_or_missing_identity_does_not_retain_unused_entry_metadata() {
+    for catalog_source in [
+        CatalogSource::Default,
+        CatalogSource::ExplicitProvider(Mutex::new(())),
+    ] {
+        let original = fixture_model("owned-fixture-unavailable-model", "unused catalog");
+        let manager = fixture_manager(vec![original], catalog_source);
+        for identity in [Some("previous-fixture-provider".to_string()), None] {
+            manager.remote_models.write().await.identity = identity;
+            let retained = compare_ordinary(
+                &manager,
+                "owned-fixture-unavailable-model",
+                &Default::default(),
+            )
+            .await;
+            let expected_origin = match &manager.catalog_source {
+                CatalogSource::Default => CatalogOrigin::BundledIdentityFallback,
+                CatalogSource::ExplicitProvider(_) => CatalogOrigin::EmptyExplicitProviderFallback,
+            };
+            assert_eq!(retained.catalog().origin(), expected_origin);
+            assert_eq!(retained.catalog().entry_fetched_at(), None);
+            assert_eq!(retained.catalog().entry_etag(), None);
+            assert_eq!(retained.catalog().entry_client_version(), None);
+            assert_eq!(retained.original_catalog_model(), None);
+            assert_eq!(retained.match_rule(), ModelMatchRule::UnmatchedFallback);
+            assert!(retained.resolved_model().used_fallback_model_metadata);
+        }
+    }
+}
+
+#[tokio::test]
+async fn manager_pair_reuses_one_resolved_arc_and_rejects_equal_value_replacement() {
+    let manager = fixture_manager(
+        vec![fixture_model("gpt-5", "owned catalog")],
+        CatalogSource::Default,
+    );
+    let config = ModelsManagerConfig {
+        personality: Some(codex_protocol::config_types::Personality::Friendly),
+        model_context_window: Some(75_000),
+        ..Default::default()
+    };
+    let selected = manager
+        .get_model_info_with_resolution("gpt-5-extra", &config)
+        .await;
+    let cloned = selected.clone();
+    let resolution = selected.resolution().expect("owning manager record");
+    assert!(Arc::ptr_eq(
+        selected.model_info(),
+        &resolution.resolved_model
+    ));
+    assert!(Arc::ptr_eq(selected.model_info(), cloned.model_info()));
+    assert!(Arc::ptr_eq(
+        resolution,
+        cloned.resolution().expect("same record")
+    ));
+    assert!(selected.matches_model_info(selected.model_info()));
+    let equal_value = Arc::new(selected.model_info().as_ref().clone());
+    assert_eq!(equal_value.as_ref(), selected.model_info().as_ref());
+    assert!(!selected.matches_model_info(&equal_value));
+    assert!(selected.matches_request("gpt-5-extra", config.personality));
+    assert!(!selected.matches_request("gpt-5", config.personality));
+    assert!(!selected.matches_request("gpt-5-extra", /*personality*/ None));
+    assert_eq!(
+        selected.model_info().as_ref(),
+        &manager.get_model_info("gpt-5-extra", &config).await
+    );
+    assert_eq!(resolution.authoritative_model_version(), None);
+    assert_eq!(
+        resolution.qualification(),
+        ResolutionQualification::Unqualified
+    );
+}
