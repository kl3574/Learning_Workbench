+        let own_model = Arc::clone(&settings.model_info);
+        assert_eq!(own_model.as_ref(), other_settings.model_info.as_ref());
+        *settings = other_settings;
+        settings.model_info = own_model;
+        assert!(settings.retained_model_resolution().is_none());
+    })
+    .await;
+    assert_eq!(
+        session.capture_retained_native_context(&step).await.err(),
+        Some(NativeCaptureError::ModelResolutionMissingOrMismatch)
+    );
+}
