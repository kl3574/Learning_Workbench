+#[tokio::test]
+async fn equal_managers_and_catalog_update_cannot_replace_an_existing_pair() {
+    let first = fixture_manager(
+        vec![fixture_model("gpt-5", "same owned catalog")],
+        CatalogSource::Default,
+    );
+    let other = fixture_manager(
+        vec![fixture_model("gpt-5", "same owned catalog")],
+        CatalogSource::Default,
+    );
+    let selected = first
+        .get_model_info_with_resolution("gpt-5", &Default::default())
+        .await;
+    let other_selected = other
+        .get_model_info_with_resolution("gpt-5", &Default::default())
+        .await;
+    assert_eq!(
+        selected.model_info().as_ref(),
+        other_selected.model_info().as_ref()
+    );
+    assert!(!selected.matches_model_info(other_selected.model_info()));
+    assert!(!Arc::ptr_eq(
+        selected.resolution().expect("first"),
+        other_selected.resolution().expect("other")
+    ));
+    let before = selected.model_info().context_window;
+    first.remote_models.write().await.models[0].context_window = Some(123_456);
+    let next = first
+        .get_model_info_with_resolution("gpt-5", &Default::default())
+        .await;
+    assert_eq!(selected.model_info().context_window, before);
+    assert_eq!(next.model_info().context_window, Some(123_456));
+    assert!(!selected.matches_model_info(next.model_info()));
+    assert!(!Arc::ptr_eq(
+        selected.resolution().expect("old"),
+        next.resolution().expect("new")
+    ));
+    assert_eq!(
