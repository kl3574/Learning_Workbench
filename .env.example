# Optional local data override; defaults to the user's data directory outside this repository.
# LEARNING_DATA_DIR=/path/to/your/local/workspace
LEARNING_HOST=127.0.0.1
LEARNING_PORT=8765
# Development launcher sets LEARNING_UI_ORIGIN=http://127.0.0.1:5173.
# No provider is configured or called by default.
# Explicit ingestion safety budgets (positive integers); frozen when an import is staged.
# LEARNING_MAX_UPLOAD_BYTES=52428800
# LEARNING_MAX_BLOCK_CHARACTERS=400000
# LEARNING_MAX_PACKAGE_BYTES=209715200
# LEARNING_MAX_PACKAGE_FILES=2000
# LEARNING_MAX_COMPRESSION_RATIO=100
