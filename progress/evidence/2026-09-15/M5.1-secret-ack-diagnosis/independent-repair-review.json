  "baseline_review_sha256": "c566ccadc18e15fe43f007b3d32b2b71d133356fe7d300420d45b4b50025062b",
  "findings": [
    {
      "id": "M51-SECRET-BASIS-01",
      "status": "CLOSED_IN_REVIEWED_SOURCE_AND_FOCUSED_OWNER_EVIDENCE",
      "statement": "Fresh commands now select the higher same-owner/provider actual GET revision; ACK remains historical and cannot synthesize a config basis. Controlled original DELETE changed from actual r1-hash/412 to r2-hash/200."
    },
    {
      "id": "M51-SECRET-READBACK-ID-02",
      "status": "CLOSED_IN_REVIEWED_SOURCE_AND_IDENTICAL_UNIT_RED_GREEN",
      "statement": "Child config GET is wire-checked and must match original provider id before storing remote; wrong-id response is rejected. Active owner and provider-port guards reject late results."
    },
    {
      "id": "M51-SECRET-CORRECTION-BASIS-03",
      "status": "CLOSED_IN_REVIEWED_SOURCE_AND_IDENTICAL_UNIT_RED_GREEN",
      "statement": "Explicit correction and comparison UI share correctionBasis, so a later actual parent read wins without changing the original command before the user chooses correction."
    }
  ],
  "reviewed_boundaries": [
    "New command freezes a full cloned actual readback basis; a larger parent revision takes precedence over an older child readback.",
    "An existing unknown command is replayed with the original key/base/raw in-memory body despite newer parent state. It cannot switch write/delete kind.",
    "ACK id/revision/presence remain checked against original command semantics, including no-op deletion; no ACK-to-current-config conversion was added.",
    "Successful ACK followed by failed GET retains the previous actual readback separately; UI labels it the most recently read configuration and reports current readback unavailable.",
    "A real peer update still yields 412; correction remains an explicit user choice and creates a new key, with no automatic replay at a fresh revision.",
    "Workspace/session/provider/port owner changes invalidate late results; secret state is not written to browser persistence.",
    "Equal-revision disagreement is not accepted as a legitimate alternate server state: the trusted owner enforces immutable revision/hash history; the UI deterministically keeps the parent on ties and still uses server CAS. No arbitrary malicious-server assurance is claimed."
  ],
