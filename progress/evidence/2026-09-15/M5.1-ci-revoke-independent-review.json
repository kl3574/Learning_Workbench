  "closed_findings": [
    {
      "id": "D-REVOKE-READY",
      "original_locator": "ProviderSettings.test.tsx:54-59",
      "fact": "The test waited for the history region and then clicked prepare revoke. The history promise and the independent IndexedDB command-journal initialization have no completion dependency.",
      "evidence": "Actual observation-01 logged prepareDisabled=true, journalNotSafe=true and academicSummaryHidden=true immediately before the click, then the confirmation control never appeared.",
      "source_chain": [
        "DraftStore.load:83-95 awaits open then transaction.oncomplete.",
        "createResponseDraftJournal:82 initializes ready=false and :142-145 sets it true only after awaited load.",
        "useProviderCommands:26 requires journal.ready for safe, and :50-51 rejects begin while unsafe.",
        "ProviderSettings prepare-revoke button is disabled while busy or unsafe."
      ],
      "fix": "Final test waits for that exact prepare control enabled before the original single click. It does not extend timeouts, retry clicks, or bypass disabled controls."
    },
    {
      "id": "D-REVOKE-AFTER-ACK",
      "original_locator": "ProviderSettings.test.tsx:61-62",
      "fact": "revoke mock called is observed at the request boundary. ACK decoding/persistence, protected current-state read and final busy clear occur later, so the old call-count observation was not a complete post-ACK barrier.",
      "source_chain": [
        "useProviderCommands:82-89 awaits request, decodes and persists acknowledgement, then awaits readRemote.",
        "readRemote:36 refuses consent summary reads when paused; send finally clears busy at :98.",
        "ProviderSettings:26-29 observes ACK identity and refreshes controls while guarding history refresh.",
        "ProviderCommandPanel safe status requires not busy, not journal.saving, and closeSafe."
      ],
      "fix": "Final test waits for concrete revision-2 original ACK, local safe/nonbusy status inside the command panel, and actual second capabilities call proving the parent ACK refresh effect ran. Only then it rechecks summary hidden and the original consentsOnce/noPreview/noGrant assertions.",
      "scope": "Covers the current controlled command flow and its known follow-up effects; it is not a universal assertion about arbitrary future background reads."
    }
  ],
  "seven_case_click_audit": [
    {
      "case": "settings shows actual empty controls/source state without a prompt or job-id entry",
      "assessment": "No click; waits for independent capabilities and history empty states before checking no generated action calls."
    },
    {
      "case": "config remains visibly separate from proof readiness and send needs a durable original command",
      "assessment": "Prepare and send each wait for their own enabled state. Initial provider selection starts with no form/secret/busy command; its switching predicate does not require journal readiness. Concrete ACK wait already exists."
    },
    {
      "case": "a same-provider refresh must not discard an unacknowledged temporary secret",
      "assessment": "Previously fixed parent refresh enabled wait is retained. Initial secret editing and save occur in the same hook/render flow; retries follow local busy settling. Same-provider refresh retains hook identity. No additional independent-readiness click race found in this fixture."
    },
    {
      "case": "policy hides previously read summaries but preserves only safe revoke identities",
      "assessment": "The two findings above are closed by final seven-line additive change. Current request/ACK/cleanup and parent effect are now observed before the privacy call-count assertion."
    },
    {
      "case": "late history after policy change supplies neither summaries nor new revoke identities",
      "assessment": "No click; deferred history promise is delivered inside awaited act after policy rerender, then protected summary and new revoke identity absence are checked."
    },
    {
      "case": "summary labels an upper bound and unknown price without inventing usage or a quote",
      "assessment": "Pure synchronous render, no click/async command sequence."
    },
    {
      "case": "reusable preview accepts a consumer-owned task but cannot manufacture a task or dispatch on approval",
      "assessment": "Enabled budget fieldset already depends on command safe/config presence; preview send, grant prepare and grant send each have enabled waits. Final called-count asserts payload at the invocation boundary, not complete post-ACK production behavior; no claim here that it proves real dispatch or consumer integration."
    }
  ],
