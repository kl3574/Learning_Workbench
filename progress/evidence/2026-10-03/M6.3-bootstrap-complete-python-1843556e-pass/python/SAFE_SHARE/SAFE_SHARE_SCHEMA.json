{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private fixed-source evidence explicit SAFE_SHARE manifest; packaging only, not product DTO",
  "type": "object",
  "required": [
    "source_head",
    "terminal_gate",
    "only_explicit_entries_authorized",
    "count",
    "transform",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "facts": {
      "type": "object",
      "required": [
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "raw_path",
        "raw",
        "candidate_path",
        "candidate",
        "transform"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_path": {
          "type": "string",
          "minLength": 1
        },
        "raw": {
          "$ref": "#/$defs/facts"
        },
        "candidate_path": {
          "type": "string",
          "pattern": "^SAFE_SHARE/"
        },
        "candidate": {
          "$ref": "#/$defs/facts"
        },
        "transform": {
          "enum": [
            "exact local-home prefix to $HOME only",
            "unchanged"
          ]
        }
      }
    }
  },
  "properties": {
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "terminal_gate": {
      "const": "PASS with two environment skips"
    },
    "only_explicit_entries_authorized": {
      "const": true
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "transform": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$comment": "Sealing script additionally enforces count, every byte count/SHA, exact original-to-candidate prefix-only transform, candidate scanning, and explicit file existence."
}
