+@pytest.mark.parametrize('code', ['CODEX_CONSENT_REVOKED', 'POLICY_DENIED', 'CODEX_INPUT_PROOF_UNAVAILABLE'])
+def test_outer_recheck_rejection_preserves_safe_code_zero_calls(code):
