+
+class CodexOutboundSourceState(dm.StrictModel):
+    material: CodexOutboundMaterial
+    control: CodexTurnControlView
+    provider_bindings: list[TurnProviderBound]
+
+
+class CodexOutboundSourcePort(Protocol):
