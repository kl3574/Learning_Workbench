+
+
+NewTurnEvent = Annotated[RunnableTurnPrepared | TurnProviderBound | TurnStarted | TurnLifecycle | TurnCancelled,
+                         Field(discriminator='kind')]
+
+
+class ControlEventEnvelope(dm.StrictModel):
