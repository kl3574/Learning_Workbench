+test.each([{ ...publicationRef, id: 'block_other' }, { ...publicationRef, sha256: 'b'.repeat(64) }, { ...publicationRef, revision: 2 }, { ...publicationRef, extra: true }])('wrong publication reference remains unknown without fabricating success', async ack => {
