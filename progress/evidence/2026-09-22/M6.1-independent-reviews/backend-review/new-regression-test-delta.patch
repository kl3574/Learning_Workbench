+@pytest.mark.parametrize('boundary', ['preview', 'worker'])
+def test_missing_authoring_owner_fails_closed_without_numeric_launch(generated_history, boundary):
+    """New dependency-admission cases; distinct from the earlier artifact RED."""
+    case = generated_history
+    if boundary == 'preview':
+        unbound = type(case.numeric)(case.database, case.authoring.context, case.runtime)
+        before = table_hashes(case.database)
+        runtime_before = (case.runtime.prepares, case.runtime.checks)
+        with pytest.raises(ApiError) as caught:
+            case.preview(numeric=unbound)
+        assert (caught.value.status, caught.value.code) == (503, 'AUTHORING_OUTPUT_UNAVAILABLE')
+    else:
+        value = case.preview()
+        case.numeric.decide(case.identity, value.id, decision(value), 'original-approve')
+        worker_type = GroupNumericWorker if case.variant == 'group' else NumericWorker
+        unbound = worker_type(case.database, case.authoring.context, case.runtime)
+        work = unbound.claim()
+        assert work is not None
+        before = table_hashes(case.database)
+        runtime_before = (case.runtime.prepares, case.runtime.checks)
+        with case.database.transaction() as conn:
+            with pytest.raises(ApiError) as caught:
+                unbound._access(conn, *work)
+            assert (caught.value.status, caught.value.code) == (503, 'AUTHORING_OUTPUT_UNAVAILABLE')
+    assert table_hashes(case.database) == before
