+@dataclass(repr=False)
+class MaterialCase:
+    database: object
+    identity: object
+    owner: object
+    candidate: object
+    kind: str
+    state: object = None
+
+    def __repr__(self):
+        return f'<synthetic {self.kind} review fixture; session values omitted>'
+
