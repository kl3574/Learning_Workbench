+function onAckPutSuccess(workspace: string, kind: 'group_numeric_preview' | 'cancel', invalidate: () => void) {
+  const nativePut = IDBObjectStore.prototype.put
+  const observed = { matched: false, beforeCommit: false }
+  vi.spyOn(IDBObjectStore.prototype, 'put').mockImplementation(function (this: IDBObjectStore, ...args: Parameters<IDBObjectStore['put']>) {
+    const result = nativePut.apply(this, args)
+    const stored = args[0] as { workspaceId?: string; text?: string }
+    if (!observed.matched && stored.workspaceId === workspace && typeof stored.text === 'string') {
+      const command = readAuthoringCommand({ objectId: JSON.parse(stored.text).command_id, revision: 1, text: stored.text, updatedAt: '2026-09-22T00:00:00Z', conflicts: [] }, workspace)
+      if (command.kind === kind && command.ack !== null) {
+        observed.matched = true
+        let complete = false
+        this.transaction.addEventListener('complete', () => { complete = true })
+        // Real IDB request success occurs before transaction completion. This
+        // tests an already queued write, not a delayed post-commit save Promise.
+        result.addEventListener('success', () => {
+          observed.beforeCommit = !complete
+          invalidate()
+        })
+      }
+    }
+    return result
+  })
+  return observed
+}
