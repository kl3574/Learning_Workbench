+test('private ACK cannot reach PUT when Policy changes after the real readwrite lookup', async () => {
+  const f = fixture()
+  const hook = renderHook(({ paused }) => useAuthoring(f.workspace, paused, f.port), { initialProps: { paused: false } })
+  await waitFor(() => expect(hook.result.current.ready && hook.result.current.academic).toBe(true))
+  let originalCommand!: AuthoringCommand, previewReturned = false, entered = false
+  f.groups.preview = vi.fn(async () => {
+    originalCommand = readAuthoringCommand(Object.values(await authoringCommandStore.load(f.workspace))[0], f.workspace)
+    previewReturned = true
+    return f.numeric
+  })
+  const nativeGet = IDBObjectStore.prototype.get
+  vi.spyOn(IDBObjectStore.prototype, 'get').mockImplementation(function (this: IDBObjectStore, ...args: Parameters<IDBObjectStore['get']>) {
+    const result = nativeGet.apply(this, args)
+    if (!entered && previewReturned && this.transaction.mode === 'readwrite' && Array.isArray(args[0]) && args[0][0] === f.workspace) {
+      // Registered before DraftStore's lookup handler can enqueue the ACK PUT.
+      result.addEventListener('success', () => { entered = true; hook.rerender({ paused: true }) })
+    }
+    return result
+  })
+  let pending!: Promise<void>
+  act(() => { pending = hook.result.current.create(f.input) })
+  await waitFor(() => expect(entered).toBe(true))
+  await act(async () => { await pending })
+  expect(readAuthoringCommand(Object.values(await authoringCommandStore.load(f.workspace))[0], f.workspace)).toEqual(originalCommand)
+  expect(hook.result.current.numeric).toBeNull()
+  hook.unmount()
+  await recoverOriginalPreview(f, originalCommand)
+})
