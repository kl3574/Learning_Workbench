+test.each(['policy', 'workspace', 'session'] as const)('private ACK cannot commit when %s changes after the real IDB put succeeds', async change => {
+  const f = fixture(), next = fixture()
+  const hook = renderHook(({ workspace, paused, port }) => useAuthoring(workspace, paused, port), { initialProps: { workspace: f.workspace, paused: false, port: f.port } })
+  await waitFor(() => expect(hook.result.current.ready && hook.result.current.academic).toBe(true))
+  let originalCommand!: AuthoringCommand
+  f.groups.preview = vi.fn(async () => {
+    originalCommand = readAuthoringCommand(Object.values(await authoringCommandStore.load(f.workspace))[0], f.workspace)
+    return f.numeric
+  })
+  let mutation: Promise<unknown> = Promise.resolve()
+  const observed = onAckPutSuccess(f.workspace, 'group_numeric_preview', () => {
+    act(() => {
+      if (change === 'session') {
+        f.session.role = 'learner'
+        vi.stubGlobal('fetch', vi.fn(async () => new Response(JSON.stringify(f.session), { status: 200, headers: { 'Content-Type': 'application/json' } })))
+        // The real client changes the access generation before awaiting fetch.
+        mutation = request('POST /api/v1/session/role', { role: 'learner' }, { 'Idempotency-Key': 'synthetic-put-boundary-role' })
+      } else {
+        hook.rerender(change === 'workspace' ? { workspace: next.workspace, paused: false, port: next.port } : { workspace: f.workspace, paused: true, port: f.port })
+      }
+    })
+  })
+  let pending!: Promise<void>
+  act(() => { pending = hook.result.current.create(f.input) })
+  await waitFor(() => expect(observed.beforeCommit).toBe(true))
+  await act(async () => { await mutation; await pending })
+  expect(observed.matched).toBe(true)
+  expect(originalCommand.ack).toBeNull()
+  const durable = Object.values(await authoringCommandStore.load(f.workspace))
+  expect(durable).toHaveLength(1)
+  expect(readAuthoringCommand(durable[0], f.workspace)).toEqual(originalCommand)
+  expect(hook.result.current.numeric).toBeNull()
+  expect(hook.result.current.commands.filter(value => value.kind !== 'cancel')).toEqual([])
+  expect(f.groups.preview).toHaveBeenCalledTimes(1)
+  hook.unmount()
+  await recoverOriginalPreview(f, originalCommand)
+})
