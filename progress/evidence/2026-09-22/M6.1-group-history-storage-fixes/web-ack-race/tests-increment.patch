+test('safe cancellation ACK remains durable when Policy changes before its real IDB transaction completes', async () => {
+  const f = fixture()
+  const hook = renderHook(({ paused }) => useAuthoring(f.workspace, paused, f.port), { initialProps: { paused: false } })
+  await waitFor(() => expect(hook.result.current.ready && hook.result.current.academic).toBe(true))
+  const observed = onAckPutSuccess(f.workspace, 'cancel', () => hook.rerender({ paused: true }))
+  await act(() => hook.result.current.cancel(f.job))
+  expect(observed.matched && observed.beforeCommit).toBe(true)
+  const durable = Object.values(await authoringControlStore.load(f.workspace))
+  expect(durable).toHaveLength(1)
+  const saved = readAuthoringCommand(durable[0], f.workspace)
+  expect(saved.kind === 'cancel' && saved.ack?.status).toBe('cancelled')
+  await waitFor(() => expect(hook.result.current.controlReady).toBe(true))
+  await act(() => hook.result.current.execute({ ...saved, ack: null }))
+  expect(f.port.cancel).toHaveBeenCalledTimes(1)
+  expect(readAuthoringCommand(Object.values(await authoringControlStore.load(f.workspace))[0], f.workspace)).toEqual(saved)
+})
