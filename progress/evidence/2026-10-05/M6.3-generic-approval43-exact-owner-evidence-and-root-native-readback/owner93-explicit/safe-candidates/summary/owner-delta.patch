+ operation: { kind: 'command', command_text: '{"text":"合成 α\\n","version":"codex-synthetic-literal-command-v1"}', cwd: 'turn_outputs', executable_sha256: '1'.repeat(64), environment_sha256: '2'.repeat(64), read_files: [], writable_area: 'turn_outputs', filesystem_scope_sha256: '3'.repeat(64), network: 'denied', operation_profile_sha256: '4'.repeat(64) }, operation_sha256: '5'.repeat(64),
+ created_at: '2026-10-05T00:00:00Z', expires_at: '2099-10-05T00:00:00Z', decision: 'pending', validity: 'current', execution: 'not_started', decided_at: null, started_at: null, finished_at: null, result_sha256: null, error_code: null })
