2026-09-14T12:21:15.5253137Z     def test_docx_deflate_member_cannot_hide_unconsumed_private_payload():
2026-09-14T12:21:15.5253623Z         payloads = docx_payloads()
2026-09-14T12:21:15.5253945Z         stream = BytesIO()
2026-09-14T12:21:15.5254378Z         with ZipFile(stream, "w", compression=ZIP_DEFLATED) as archive:
2026-09-14T12:21:15.5254807Z             for name, value in payloads.items():
2026-09-14T12:21:15.5255191Z                 archive.writestr(name, value)
2026-09-14T12:21:15.5255566Z         clean = stream.getvalue()
2026-09-14T12:21:15.5255912Z         hidden = b"HIDDEN_PRIVATE_PAYLOAD"
2026-09-14T12:21:15.5256322Z         with ZipFile(BytesIO(clean)) as archive:
2026-09-14T12:21:15.5256757Z             entry = archive.infolist()[0]
2026-09-14T12:21:15.5257268Z             name_size, extra_size = struct.unpack_from("<HH", clean, entry.header_offset + 26)
2026-09-14T12:21:15.5257872Z             insertion = entry.header_offset + 30 + name_size + extra_size + entry.compress_size
2026-09-14T12:21:15.5258453Z             dirty = bytearray(clean[:insertion] + hidden + clean[insertion:])
2026-09-14T12:21:15.5259027Z             struct.pack_into("<L", dirty, entry.header_offset + 18, entry.compress_size + len(hidden))
2026-09-14T12:21:15.5259539Z             position = archive.start_dir + len(hidden)
2026-09-14T12:21:15.5259901Z             for _ in archive.infolist():
2026-09-14T12:21:15.5260477Z                 name_size, extra_size, comment_size = struct.unpack_from("<HHH", dirty, position + 28)
2026-09-14T12:21:15.5261087Z                 offset = struct.unpack_from("<L", dirty, position + 42)[0]
2026-09-14T12:21:15.5261530Z                 if offset == entry.header_offset:
2026-09-14T12:21:15.5262010Z                     struct.pack_into("<L", dirty, position + 20, entry.compress_size + len(hidden))
2026-09-14T12:21:15.5262466Z                 elif offset >= insertion:
2026-09-14T12:21:15.5262919Z                     struct.pack_into("<L", dirty, position + 42, offset + len(hidden))
2026-09-14T12:21:15.5263418Z                 position += 46 + name_size + extra_size + comment_size
2026-09-14T12:21:15.5263910Z             struct.pack_into("<L", dirty, position + 16, archive.start_dir + len(hidden))
2026-09-14T12:21:15.5264440Z         with ZipFile(BytesIO(dirty)) as standard_reader:
2026-09-14T12:21:15.5264897Z             assert standard_reader.read(entry.filename) == payloads[entry.filename]
2026-09-14T12:21:15.5265427Z         with pytest.raises(ImportParsingError) as error:
2026-09-14T12:21:15.5265830Z             parse(bytes(dirty), "docx")
2026-09-14T12:21:15.5266234Z >       assert error.value.code == "DOCX_COMPRESSED_TRAILING_DATA"
2026-09-14T12:21:15.5266797Z E       AssertionError: assert 'EXTRACTION_E...T_UNAVAILABLE' == 'DOCX_COMPRES...TRAILING_DATA'
2026-09-14T12:21:15.5267338Z E         
