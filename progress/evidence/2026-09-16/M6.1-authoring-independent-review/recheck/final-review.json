      "finding": "self_consistent_candidate_replacement",
      "status": "ORIGINAL_COUNTEREXAMPLE_CLOSED",
      "evidence": "Original and permanent test now reject with AUTHORING_INTEGRITY_ERROR. Repository binds candidate payload to strict parse of stored raw answer and binds terminal view/candidate to actual Jobs result; service checks raw answer against Provider original artifact.",
      "source": "services/api/app/infrastructure/authoring_repository.py:105; services/api/app/application/authoring.py:44"
    },
    {
      "finding": "undispatched_revoke_blocks_same_job_preview",
      "status": "ORIGINAL_COUNTEREXAMPLE_CLOSED",
      "evidence": "Original and permanent test now observe awaiting_approval for the same Job and create a fresh explicit preview with zero transport requests. Worker invokes source-owned resume only when consent revoked/expired and no dispatch instance exists; GET does not perform the transition. This particular counterexample stops at the new preview, not a second grant/run.",
      "source": "services/api/app/application/authoring_source.py:122; services/api/app/application/authoring_worker.py:181"
    },
    {
      "finding": "mutable_execution_actor_borrows_other_author",
      "status": "ORIGINAL_COUNTEREXAMPLE_CLOSED",
      "evidence": "Original and permanent corruption test now yields no loopback request. New Authoring-owned authorization callback records actual identity.id and binds current execution_actor_id, consent/proposal/prepared hash and queued Jobs revision. Existing Provider actor remains workspace_id; it is not reinterpreted as the original granting session.",
      "source": "services/api/app/infrastructure/authoring_repository.py:92; services/api/app/infrastructure/authoring_repository.py:135; services/api/app/application/authoring_source.py:116; services/api/app/application/consents.py:203"
    },
    {
      "finding": "restored_authority_control_only_output_read",
      "status": "ORIGINAL_COUNTEREXAMPLE_CLOSED",
      "evidence": "Original and permanent real checked-output probe now permits restored author to read original raw answer, retains no candidate and does not send a second request. Service creates only an in-memory projection after current protected Provider read; stored failed/cancelled terminal and result hash remain unchanged.",
      "source": "services/api/app/application/authoring.py:57"
    }
