    ci: retain actual synthetic Restore numeric outcomes

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 73b39e35..00413cbb 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -103,6 +103,20 @@ jobs:
         run: make test-e2e
         env:
           LEARNING_E2E_OUTPUT_DIR: ${{ runner.temp }}/learning-workbench-e2e-results
+      # These exact receipts contain only the original synthetic Restore fixture.
+      # A passing browser test may report numeric BLOCKED, so keep the actual
+      # outcome on success as well as failure; never upload databases or traces.
+      - name: Retain synthetic Restore numeric outcome
+        if: ${{ always() && (steps.native.outcome == 'success' || steps.native.outcome == 'failure') }}
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1, Node 24
+        with:
+          name: restore-numeric-outcome-${{ github.event_name }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            ${{ runner.temp }}/learning-workbench-e2e-results/**/restore-numeric-actual.json
+            ${{ runner.temp }}/learning-workbench-e2e-results/**/actual-publication-response.json
+          retention-days: 3
+          if-no-files-found: warn
+          include-hidden-files: false
       # Synthetic browser failures only; never upload the data directory or traces.
       - name: Retain synthetic browser failure diagnostics
         if: ${{ failure() && steps.native.outcome == 'failure' }}
