diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5517947e..f5dc9ed3 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -117,6 +117,16 @@ jobs:
           retention-days: 3
           if-no-files-found: warn
           include-hidden-files: false
+      # Only the original loopback fixture's bounded numeric/publication DTOs.
+      - name: Retain single generated example publication outcome
+        if: ${{ always() && (steps.native.outcome == 'success' || steps.native.outcome == 'failure') }}
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1, Node 24
+        with:
+          name: single-publication-outcome-${{ github.event_name }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/learning-workbench-e2e-results/**/single-publication-actual.json
+          retention-days: 3
+          if-no-files-found: warn
+          include-hidden-files: false
       # Synthetic browser failures only; never upload the data directory or traces.
       - name: Retain synthetic browser failure diagnostics
         if: ${{ failure() && steps.native.outcome == 'failure' }}
