              "maxItems": 512,
              "minItems": 1,
              "title": "Blocks",
              "type": "array"
            },
            "graph": {
              "items": {
                "$ref": "#/$defs/RetrievalRefState"
              },
              "title": "Graph",
              "type": "array"
            },
            "scope_refs": {
              "items": {
                "$ref": "#/$defs/ContentRef"
