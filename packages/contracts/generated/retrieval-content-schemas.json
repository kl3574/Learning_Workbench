          "required": [
            "version",
            "workspace_id",
            "scope_sha256",
            "scope_refs",
            "graph",
            "blocks",
            "versions"
          ],
          "title": "RetrievalCorpusDescriptor",
          "type": "object"
        },
        "RetrievalProvenance": {
          "additionalProperties": false,
          "properties": {
