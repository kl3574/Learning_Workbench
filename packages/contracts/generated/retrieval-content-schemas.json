              "type": "string"
            },
            "media_type": {
              "title": "Media Type",
              "type": "string"
            },
            "parser_version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parser Version"
            },
            "rights": {
              "title": "Rights",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size": {
              "minimum": 0,
              "title": "Size",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "media_type",
            "size",
            "sha256",
            "rights",
            "parser_version"
