{
  "byte_binding": {
    "RetrievalBlockMaterial.body": "Python bytes / TypeScript Uint8Array"
  },
  "schemas": {
    "RetrievalBlockMaterial": {
      "$defs": {
        "ContentRef": {
          "additionalProperties": false,
          "properties": {
            "entity": {
              "enum": [
                "course",
                "lesson",
                "block",
                "concept",
                "route",
                "question",
                "practice_set",
                "assessment",
                "note"
              ],
              "title": "Entity",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
              "title": "Id",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "entity",
            "id",
            "revision",
            "sha256"
          ],
          "title": "ContentRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "body": {
          "format": "binary",
          "title": "Body",
          "type": "string"
        },
        "body_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Body Sha256",
          "type": "string"
        },
        "corpus_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Corpus Sha256",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "scope_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope_sha256",
        "corpus_sha256",
        "ref",
        "body_sha256",
        "body"
      ],
      "title": "RetrievalBlockMaterial",
      "type": "object"
    },
    "RetrievalScopeSnapshot": {
      "$defs": {
        "Citation": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
              "title": "Id",
              "type": "string"
            },
            "locator": {
              "title": "Locator",
              "type": "string"
            },
            "source_sha256": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Sha256"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Url"
            },
            "verification": {
              "enum": [
                "verified",
                "unverified",
                "user_supplied"
              ],
              "title": "Verification",
              "type": "string"
