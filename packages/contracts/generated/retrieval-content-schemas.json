          },
          "required": [
            "id",
            "title",
            "locator",
            "verification"
          ],
          "title": "Citation",
          "type": "object"
        },
        "ContentRef": {
          "additionalProperties": false,
          "properties": {
            "entity": {
              "enum": [
                "course",
                "lesson",
                "block",
                "concept",
                "route",
                "question",
                "practice_set",
                "assessment",
                "note"
              ],
              "title": "Entity",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
              "title": "Id",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "entity",
            "id",
            "revision",
            "sha256"
          ],
          "title": "ContentRef",
          "type": "object"
        },
        "RetrievalAlgorithmVersions": {
          "additionalProperties": false,
          "properties": {
            "locator": {
              "const": "whole-block-v1",
              "title": "Locator",
              "type": "string"
            },
            "normalization": {
              "const": "nfc-v1",
              "title": "Normalization",
              "type": "string"
            },
            "ranking": {
              "const": "scope-coverage-v1",
              "title": "Ranking",
              "type": "string"
            },
            "resource": {
              "const": "retrieval-resource-v1",
              "title": "Resource",
              "type": "string"
            },
            "tokenizer": {
              "const": "lexical-han-gram-v1",
              "title": "Tokenizer",
              "type": "string"
            },
            "unicode": {
              "const": "15.0.0",
              "title": "Unicode",
              "type": "string"
            }
          },
          "required": [
            "resource",
            "normalization",
            "tokenizer",
            "unicode",
            "ranking",
            "locator"
          ],
          "title": "RetrievalAlgorithmVersions",
          "type": "object"
        },
        "RetrievalBlockDescriptor": {
          "additionalProperties": false,
          "properties": {
            "body_bytes": {
              "maximum": 16777216,
              "minimum": 0,
              "title": "Body Bytes",
              "type": "integer"
            },
            "body_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Body Sha256",
              "type": "string"
            },
            "parent_paths": {
              "items": {
                "$ref": "#/$defs/RetrievalScopePath"
              },
              "maxItems": 8192,
              "minItems": 1,
              "title": "Parent Paths",
              "type": "array"
            },
            "provenance": {
              "$ref": "#/$defs/RetrievalProvenance"
            },
            "ref": {
              "$ref": "#/$defs/ContentRef"
            },
            "source_descriptor_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Source Descriptor Sha256",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "title",
            "body_sha256",
            "body_bytes",
            "provenance",
            "source_descriptor_sha256",
            "parent_paths"
          ],
          "title": "RetrievalBlockDescriptor",
          "type": "object"
        },
        "RetrievalCorpusDescriptor": {
          "additionalProperties": false,
          "properties": {
            "blocks": {
              "items": {
                "$ref": "#/$defs/RetrievalBlockDescriptor"
