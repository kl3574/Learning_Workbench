              "maxItems": 16,
              "minItems": 1,
              "title": "Scope Refs",
              "type": "array"
            },
            "scope_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Scope Sha256",
              "type": "string"
            },
            "version": {
              "const": "retrieval-corpus-v1",
              "title": "Version",
              "type": "string"
            },
            "versions": {
              "$ref": "#/$defs/RetrievalAlgorithmVersions"
            },
            "workspace_id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
              "title": "Workspace Id",
              "type": "string"
            }
