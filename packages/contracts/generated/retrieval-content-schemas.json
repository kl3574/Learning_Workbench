              "title": "Citations",
              "type": "array"
            },
            "original": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RetrievalRetainedSource"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "enum": [
                "frozen",
                "unresolved"
              ],
              "title": "State",
              "type": "string"
            },
            "unresolved_citation_ids": {
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
                "type": "string"
              },
              "title": "Unresolved Citation Ids",
              "type": "array"
            },
            "warnings": {
              "items": {
                "$ref": "#/$defs/Warning"
              },
              "title": "Warnings",
              "type": "array"
            }
          },
          "required": [
            "state",
            "original",
            "citations",
            "unresolved_citation_ids",
            "warnings"
          ],
          "title": "RetrievalProvenance",
          "type": "object"
